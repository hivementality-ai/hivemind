# ============================================================
# Hivemind 🐝 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# AI Providers (at least one required)
# ----------------------------------------------------------

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (GPT) — https://platform.openai.com/
OPENAI_API_KEY=

# Ollama (local models, no key needed) — https://ollama.com/
# OLLAMA_URL=http://host.docker.internal:11434

# ----------------------------------------------------------
# Rails (auto-generated if blank)
# ----------------------------------------------------------

# Master key for Rails encrypted credentials
# If not set, uses config/master.key file
# RAILS_MASTER_KEY=

# ----------------------------------------------------------
# Database (defaults work with docker compose)
# ----------------------------------------------------------

# DATABASE_URL=postgres://hivemind:hivemind@postgres:5432/hivemind_production

# ----------------------------------------------------------
# Redis (defaults work with docker compose)
# ----------------------------------------------------------

# REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------
# Channel Integrations (optional — add as needed)
# ----------------------------------------------------------

# These are loaded into the vault on first boot if set.
# You can also add them later via Mission Control → Vault.

# Telegram — get from @BotFather
# TELEGRAM_BOT_TOKEN=

# Discord — get from Discord Developer Portal
# DISCORD_BOT_TOKEN=

# Slack — get from api.slack.com/apps
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ----------------------------------------------------------
# Optional
# ----------------------------------------------------------

# Max concurrent Sidekiq threads (default: 5)
# RAILS_MAX_THREADS=5

# Log level: debug, info, warn, error (default: info)
# RAILS_LOG_LEVEL=info
