# ============================================================
# Hivemind 🐝 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Most secrets (API keys, channel tokens, integrations) are
# managed through the Vault in Mission Control, not here.
# This file is only for infrastructure-level config.
# ============================================================

# ----------------------------------------------------------
# Active Record Encryption (required for Vault)
# ----------------------------------------------------------
# Generate with: bin/rails db:encryption:init
# These encrypt secrets stored in the Vault.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ----------------------------------------------------------
# Docker (required)
# ----------------------------------------------------------

# Docker socket GID — run: stat -c '%g' /var/run/docker.sock (Linux) or stat -f '%g' /var/run/docker.sock (macOS)
DOCKER_GID=0

# ----------------------------------------------------------
# Internal API (MCP tool bridge)
# ----------------------------------------------------------
# Shared secret between Rails and SDK proxy for internal tool callbacks.
# Auto-generated by install.sh, bin/dev-up, and scripts/upgrade.sh.
INTERNAL_API_SECRET=

# ----------------------------------------------------------
# Optional
# ----------------------------------------------------------

# Rails master key (uses config/master.key if not set)
# RAILS_MASTER_KEY=

# Max concurrent Sidekiq threads (default: 5)
# RAILS_MAX_THREADS=5

# Log level: debug, info, warn, error (default: info)
# RAILS_LOG_LEVEL=info
