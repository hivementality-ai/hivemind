FROM ruby:3.4.8-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Connector is a thin Ruby process — deps will be minimal
COPY Gemfile.connector Gemfile
RUN bundle install --jobs 4

COPY lib/connector /app/lib/connector
COPY config/connector.yml /app/config/connector.yml

CMD ["ruby", "lib/connector/start.rb"]
