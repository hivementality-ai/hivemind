<%# Locals: milestones (collection of needs_review milestones) %>
<div class="bg-surface-card border border-amber-500/30 rounded-xl p-6">
  <div class="flex items-center gap-2 mb-5">
    <div class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></div>
    <h2 class="text-white font-semibold text-lg">Pending Approvals</h2>
    <span class="text-text-faint text-sm">(<%= milestones.size %>)</span>
  </div>

  <div class="space-y-4">
    <% milestones.each do |milestone| %>
      <div class="bg-surface-raised border border-border-default rounded-lg p-5" id="approval-<%= milestone.id %>">
        <%# Header %>
        <div class="flex items-start justify-between gap-3 mb-3">
          <div>
            <h3 class="text-white font-medium text-sm"><%= milestone.title %></h3>
            <% if milestone.agent.present? %>
              <p class="text-text-faint text-xs mt-0.5">Completed by <%= milestone.agent.name %></p>
            <% end %>
          </div>
          <% if milestone.retry_count > 0 %>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-orange-500/20 text-orange-400 border border-orange-500/30">
              Retry <%= milestone.retry_count %>/<%= milestone.max_retries %>
            </span>
          <% end %>
        </div>

        <%# Agent notes / review notes %>
        <% if milestone.review_notes.present? %>
          <div class="bg-surface-base border border-border-default rounded-md p-3 mb-3">
            <p class="text-xs font-medium text-text-muted mb-1">Agent Notes</p>
            <p class="text-text-muted text-xs leading-relaxed"><%= milestone.review_notes %></p>
          </div>
        <% end %>

        <%# Deliverables %>
        <% if milestone.respond_to?(:deliverables) && milestone.deliverables.present? %>
          <div class="mb-3">
            <p class="text-xs font-medium text-text-muted mb-1.5">Deliverables</p>
            <ul class="space-y-1">
              <% Array(milestone.deliverables).each do |deliverable| %>
                <li class="flex items-start gap-2 text-xs text-text-muted">
                  <svg class="w-3 h-3 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <%= deliverable %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# Acceptance criteria %>
        <% if milestone.acceptance_criteria.present? %>
          <div class="mb-4">
            <p class="text-xs font-medium text-text-muted mb-1.5">Acceptance Criteria</p>
            <div class="bg-surface-base border border-border-default rounded-md p-3">
              <p class="text-text-muted text-xs leading-relaxed whitespace-pre-line"><%= milestone.acceptance_criteria %></p>
            </div>
          </div>
        <% end %>

        <%# Feedback + actions %>
        <div class="space-y-3">
          <div>
            <label for="feedback-<%= milestone.id %>" class="block text-xs font-medium text-text-muted mb-1">Feedback</label>
            <textarea id="feedback-<%= milestone.id %>"
                      form="approve-form-<%= milestone.id %> reject-form-<%= milestone.id %>"
                      name="feedback"
                      rows="2"
                      placeholder="Optional for approval, required for rejection..."
                      class="w-full px-3 py-2 bg-surface-base border border-border-default rounded-lg text-white text-xs placeholder-text-faint focus:outline-none focus:border-amber-500/50 focus:ring-1 focus:ring-amber-500/30 transition-colors resize-none"
                      data-approval-target="feedback-<%= milestone.id %>"></textarea>
          </div>

          <div class="flex items-center gap-2">
            <%= form_with url: approve_project_milestone_path(milestone.project, milestone), method: :patch, id: "approve-form-#{milestone.id}", class: "inline" do |f| %>
              <input type="hidden" name="feedback" value="" data-sync-from="feedback-<%= milestone.id %>">
              <%= f.submit "Approve", class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-sm font-medium hover:bg-emerald-500/30 transition-all cursor-pointer" %>
            <% end %>

            <%= form_with url: reject_project_milestone_path(milestone.project, milestone), method: :patch, id: "reject-form-#{milestone.id}", class: "inline" do |f| %>
              <input type="hidden" name="feedback" value="" data-sync-from="feedback-<%= milestone.id %>">
              <%= f.submit "Reject", class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-red-500/20 border border-red-500/30 text-red-400 text-sm font-medium hover:bg-red-500/30 transition-all cursor-pointer" %>
            <% end %>

            <%= button_to skip_project_milestone_path(milestone.project, milestone), method: :patch, class: "inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-surface-card border border-border-default text-text-muted text-sm hover:text-white hover:border-amber-500/40 transition-all" do %>
              Skip
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
