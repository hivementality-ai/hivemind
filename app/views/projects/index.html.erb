<div class="min-h-screen bg-surface-base">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%# Header %>
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold text-white">Projects</h1>
        <% if @pending_approvals > 0 %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30">
            <%= @pending_approvals %> pending approval<%= @pending_approvals == 1 ? "" : "s" %>
          </span>
        <% end %>
      </div>
      <%= link_to new_project_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand text-black font-medium text-sm hover:bg-amber-400 transition-colors" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Project
      <% end %>
    </div>

    <% if @projects.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% @projects.each do |project| %>
          <% total_milestones = project.milestones.size %>
          <% completed_milestones = project.milestones.count { |m| m.status == "completed" } %>
          <% progress = total_milestones > 0 ? (completed_milestones.to_f / total_milestones * 100).round : 0 %>
          <% pending_count = project.milestones.count { |m| m.status == "needs_review" } %>

          <%= link_to project_path(project), class: "block group" do %>
            <div class="bg-surface-card border border-border-default rounded-xl p-5 hover:border-amber-500/40 hover:bg-surface-raised transition-all duration-200">
              <%# Top row: title + status %>
              <div class="flex items-start justify-between mb-3">
                <h3 class="text-white font-semibold text-base group-hover:text-amber-400 transition-colors leading-tight pr-3">
                  <%= project.title %>
                </h3>
                <%
                  status_classes = case project.status
                  when "active" then "bg-amber-500/20 text-amber-400 border-amber-500/30"
                  when "blocked" then "bg-red-500/20 text-red-400 border-red-500/30"
                  when "completed" then "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
                  when "planning" then "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  when "paused" then "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  when "cancelled" then "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  else "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  end
                %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium border shrink-0 <%= status_classes %>">
                  <%= project.status.titleize %>
                </span>
              </div>

              <%# Team name %>
              <% if project.team %>
                <p class="text-text-muted text-sm mb-3"><%= project.team.name %></p>
              <% end %>

              <%# Progress bar %>
              <% if total_milestones > 0 %>
                <div class="mb-3">
                  <div class="flex items-center justify-between text-xs text-text-faint mb-1.5">
                    <span><%= completed_milestones %>/<%= total_milestones %> milestones</span>
                    <span><%= progress %>%</span>
                  </div>
                  <div class="w-full h-1.5 bg-surface-base rounded-full overflow-hidden">
                    <div class="h-full bg-amber-500 rounded-full transition-all duration-300" style="width: <%= progress %>%"></div>
                  </div>
                </div>
              <% end %>

              <%# Footer: priority, deadline, pending %>
              <div class="flex items-center gap-2 flex-wrap">
                <%
                  priority_classes = case project.priority
                  when "urgent" then "bg-red-500/20 text-red-400 border-red-500/30"
                  when "high" then "bg-orange-500/20 text-orange-400 border-orange-500/30"
                  when "normal" then "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  when "low" then "bg-slate-500/15 text-text-faint border-slate-500/20"
                  else "bg-slate-500/20 text-slate-400 border-slate-500/30"
                  end
                %>
                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium border <%= priority_classes %>">
                  <%= project.priority&.titleize || "Normal" %>
                </span>

                <% if project.deadline %>
                  <span class="text-xs text-text-faint flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= project.deadline.strftime("%b %-d") %>
                  </span>
                <% end %>

                <% if pending_count > 0 %>
                  <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium bg-amber-500/20 text-amber-400 border border-amber-500/30">
                    <%= pending_count %> pending
                  </span>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <%# Empty state %>
      <div class="flex flex-col items-center justify-center py-24">
        <div class="w-16 h-16 rounded-full bg-surface-card border border-border-default flex items-center justify-center mb-4">
          <svg class="w-8 h-8 text-text-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <h3 class="text-white font-medium text-lg mb-1">No projects yet</h3>
        <p class="text-text-muted text-sm mb-6">Create your first project to get started with AI-powered task management.</p>
        <%= link_to new_project_path, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand text-black font-medium text-sm hover:bg-amber-400 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Project
        <% end %>
      </div>
    <% end %>
  </div>
</div>
