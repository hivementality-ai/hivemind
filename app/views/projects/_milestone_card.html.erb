<%# Locals: milestone, last (boolean) %>
<% last ||= false %>
<div class="flex gap-4">
  <%# Timeline connector %>
  <div class="flex flex-col items-center">
    <%
      dot_color = case milestone.status
      when "needs_review" then "bg-amber-500"
      when "completed" then "bg-emerald-500"
      when "pending" then "bg-slate-500"
      when "in_progress" then "bg-blue-500"
      when "blocked" then "bg-red-500"
      when "skipped" then "bg-purple-500"
      else "bg-slate-500"
      end

      ring_color = case milestone.status
      when "needs_review" then "ring-amber-500/30"
      when "completed" then "ring-emerald-500/30"
      when "in_progress" then "ring-blue-500/30"
      when "blocked" then "ring-red-500/30"
      else "ring-transparent"
      end
    %>
    <div class="w-3 h-3 rounded-full <%= dot_color %> ring-4 <%= ring_color %> shrink-0 mt-1.5"></div>
    <% unless last %>
      <div class="w-px flex-1 bg-border-default my-1"></div>
    <% end %>
  </div>

  <%# Card content %>
  <div class="pb-6 flex-1 min-w-0 <%= 'pb-0' if last %>">
    <div class="bg-surface-raised border border-border-default rounded-lg p-4 hover:border-amber-500/20 transition-colors">
      <%# Header row %>
      <div class="flex items-start justify-between gap-3 mb-2">
        <h3 class="text-white font-medium text-sm leading-tight"><%= milestone.title %></h3>
        <%
          status_classes = case milestone.status
          when "needs_review" then "bg-amber-500/20 text-amber-400 border-amber-500/30"
          when "completed" then "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
          when "pending" then "bg-slate-500/20 text-slate-400 border-slate-500/30"
          when "in_progress" then "bg-blue-500/20 text-blue-400 border-blue-500/30"
          when "blocked" then "bg-red-500/20 text-red-400 border-red-500/30"
          when "skipped" then "bg-purple-500/20 text-purple-400 border-purple-500/30"
          else "bg-slate-500/20 text-slate-400 border-slate-500/30"
          end
        %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border shrink-0 <%= status_classes %>">
          <%= milestone.status.titleize %>
        </span>
      </div>

      <%# Description %>
      <% if milestone.description.present? %>
        <p class="text-text-faint text-xs mb-3 leading-relaxed"><%= truncate(milestone.description, length: 160) %></p>
      <% end %>

      <%# Meta info row %>
      <div class="flex items-center gap-3 flex-wrap">
        <%# Assigned agent %>
        <% if milestone.agent.present? %>
          <span class="inline-flex items-center gap-1.5 text-xs text-text-muted">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <%= milestone.agent.name %>
          </span>
        <% end %>

        <%# Dependencies %>
        <% if milestone.respond_to?(:depends_on) && milestone.depends_on.present? %>
          <span class="inline-flex items-center gap-1 text-xs text-text-faint">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            Has dependencies
          </span>
        <% end %>

        <%# Retry count %>
        <% if milestone.retry_count > 0 %>
          <span class="inline-flex items-center gap-1 text-xs text-orange-400">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Retry <%= milestone.retry_count %>/<%= milestone.max_retries %>
          </span>
        <% end %>

        <%# Checkpoint info %>
        <% if milestone.respond_to?(:checkpoint) && milestone.checkpoint.present? %>
          <span class="inline-flex items-center gap-1 text-xs text-text-faint">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            <%= milestone.checkpoint["completed_steps"] %> steps completed
          </span>
        <% end %>
      </div>

      <%# Inline approve/reject for needs_review %>
      <% if milestone.status == "needs_review" %>
        <div class="mt-3 pt-3 border-t border-border-default flex items-center gap-2">
          <%= button_to approve_project_milestone_path(milestone.project, milestone), method: :patch, class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-medium hover:bg-emerald-500/30 transition-all" do %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Approve
          <% end %>
          <%= link_to "#approval-#{milestone.id}", class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-red-500/20 border border-red-500/30 text-red-400 text-xs font-medium hover:bg-red-500/30 transition-all" do %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Reject
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
