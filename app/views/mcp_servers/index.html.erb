<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">MCP Servers</h1>
      <p class="text-text-muted mt-1">Connect Model Context Protocol servers so agents can use their tools. Run <span class="text-white">Test connection</span> after adding a server to discover what it offers.</p>
    </div>
    <div class="flex gap-2 shrink-0">
      <%= link_to "Import from Claude Desktop", new_mcp_import_path, class: "px-4 py-2 bg-surface-raised border border-border-default text-white rounded-lg transition" %>
      <%= link_to new_mcp_server_path, class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" do %>
        + Add Server
      <% end %>
    </div>
  </div>

  <% if @servers.any? %>
    <div class="bg-surface-card/50 border border-border-default/50 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-text-faint text-xs uppercase border-b border-border-default/50">
          <tr>
            <th class="text-left font-medium px-5 py-3">Name</th>
            <th class="text-left font-medium px-5 py-3">Transport</th>
            <th class="text-left font-medium px-5 py-3">Status</th>
            <th class="text-left font-medium px-5 py-3">Tools</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default/30">
          <% @servers.each do |server| %>
            <tr class="hover:bg-surface-card/60 transition">
              <td class="px-5 py-3">
                <span class="text-white font-medium"><%= server.name %></span>
                <span class="block text-text-faint font-mono text-xs break-all"><%= server.stdio? ? server.command : server.url %></span>
                <% if server.last_error.present? && server.status == "error" %>
                  <span class="block text-red-400 text-xs mt-1"><%= server.last_error.truncate(160) %></span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-text-muted"><%= server.transport %></td>
              <td class="px-5 py-3">
                <% if !server.enabled? %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-red-500/10 text-red-400">disabled</span>
                <% elsif server.connected? %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400">connected</span>
                <% elsif server.status == "error" %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-red-500/10 text-red-400">error</span>
                <% else %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-amber-500/10 text-amber-400">not tested</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-text-muted"><%= server.discovered_tools.to_a.size %></td>
              <td class="px-5 py-3">
                <div class="flex gap-3 justify-end items-center">
                  <% if server.remote? %>
                    <% if Mcp::OAuth.connected?(server) %>
                      <%= button_to "Sign out", oauth_disconnect_mcp_server_path(server), method: :delete,
                            class: "text-text-faint hover:text-white transition text-xs" %>
                    <% elsif server.status == "error" && server.last_error.to_s.include?("HTTP 401") %>
                      <%= button_to "Connect", oauth_connect_mcp_server_path(server), method: :post,
                            class: "text-green-400 hover:text-green-300 transition text-xs" %>
                    <% end %>
                  <% end %>
                  <%= button_to "Test connection", test_connection_mcp_server_path(server), method: :post,
                        class: "text-amber-400 hover:text-amber-300 transition text-xs" %>
                  <%= button_to (server.enabled? ? "Disable" : "Enable"), toggle_enabled_mcp_server_path(server), method: :patch,
                        class: "text-text-faint hover:text-white transition text-xs" %>
                  <%= link_to "Edit", edit_mcp_server_path(server), class: "text-text-faint hover:text-white transition text-xs" %>
                  <%= button_to "Delete", mcp_server_path(server), method: :delete,
                        form: { data: { turbo_confirm: "Delete this MCP server?" } },
                        class: "text-text-faint hover:text-red-400 transition text-xs" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-surface-card/30 rounded-xl border border-border-default/50">
      <h3 class="text-white font-semibold text-lg mb-2">No MCP servers yet</h3>
      <p class="text-text-muted mb-4">Add a stdio command or a remote URL to give agents new tools.</p>
      <%= link_to "Add First Server", new_mcp_server_path, class: "inline-block px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" %>
    </div>
  <% end %>
</div>
