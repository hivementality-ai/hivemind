<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Connectors</h1>
      <p class="text-text-muted mt-1">Connectors let Hivemind use any app with a web API. Keys are kept in the vault and never shown to the AI.</p>
    </div>
    <div class="flex gap-2 shrink-0">
      <%= link_to "Vault", vault_entries_path, class: "px-4 py-2 bg-surface-raised border border-border-default text-white rounded-lg transition" %>
      <%= link_to new_connector_path, class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" do %>
        + Add connector
      <% end %>
    </div>
  </div>

  <% if @connectors.any? %>
    <div class="bg-surface-card/50 border border-border-default/50 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-text-faint text-xs uppercase border-b border-border-default/50">
          <tr>
            <th class="text-left font-medium px-5 py-3">Name</th>
            <th class="text-left font-medium px-5 py-3">Base URL</th>
            <th class="text-left font-medium px-5 py-3">Status</th>
            <th class="text-left font-medium px-5 py-3">Operations</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default/30">
          <% @connectors.each do |connector| %>
            <tr class="hover:bg-surface-card/60 transition">
              <td class="px-5 py-3">
                <span class="text-white font-medium"><%= connector.name %></span>
                <span class="block text-text-faint font-mono text-xs"><%= connector.slug %></span>
              </td>
              <td class="px-5 py-3 text-text-muted font-mono text-xs break-all"><%= connector.base_url %></td>
              <td class="px-5 py-3">
                <% if connector.enabled? %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400">enabled</span>
                <% else %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-red-500/10 text-red-400">disabled</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-text-muted"><%= connector.operations.size %></td>
              <td class="px-5 py-3">
                <div class="flex gap-3 justify-end items-center">
                  <%= button_to (connector.enabled? ? "Disable" : "Enable"), toggle_enabled_connector_path(connector), method: :patch,
                        class: "text-text-faint hover:text-white transition text-xs" %>
                  <%= link_to "Export", export_connector_path(connector), class: "text-text-faint hover:text-white transition text-xs" %>
                  <%= link_to "Edit and try", edit_connector_path(connector), class: "text-amber-400 hover:text-amber-300 transition text-xs" %>
                  <%= button_to "Delete", connector_path(connector), method: :delete,
                        form: { data: { turbo_confirm: "Delete this connector?" } },
                        class: "text-text-faint hover:text-red-400 transition text-xs" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-surface-card/30 rounded-xl border border-border-default/50">
      <h3 class="text-white font-semibold text-lg mb-2">No connectors yet</h3>
      <p class="text-text-muted mb-4">Describe an app's web API once and agents can use it.</p>
      <%= link_to "Add first connector", new_connector_path, class: "inline-block px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" %>
    </div>
  <% end %>

  <details class="mt-6 bg-surface-card/50 border border-border-default/50 rounded-xl p-5">
    <summary class="text-white font-medium cursor-pointer">Import a shared connector</summary>
    <%= form_with url: import_connectors_path, method: :post, class: "mt-4 space-y-3" do %>
      <%= text_area_tag :connector_json, nil, rows: 8, placeholder: "Paste an exported connector",
            class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white font-mono text-xs focus:border-amber-500 focus:outline-none" %>
      <p class="text-text-faint text-xs">It is added switched off, with its keys left for you to point at your own vault entries.</p>
      <%= submit_tag "Import", class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition cursor-pointer" %>
    <% end %>
  </details>
</div>
