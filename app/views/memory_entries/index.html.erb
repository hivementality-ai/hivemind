<% can_edit = current_user.admin? || current_user.owner? %>
<div class="min-h-screen bg-surface-base text-white">
  <div class="bg-surface-card border-b border-border-default px-4 sm:px-6 py-4">
    <%= link_to "← Back to #{@agent.name}", agent_path(@agent), class: "text-sm text-text-muted hover:text-white transition" %>
    <h1 class="text-2xl sm:text-3xl font-bold mt-1">What <%= @agent.name %> remembers about you</h1>
    <p class="text-text-muted text-sm mt-1">
      <%= @total_count %> <%= "thing".pluralize(@total_count) %> kept. Fix anything that's wrong, pin what must never be lost, or ask to forget it.
    </p>
  </div>

  <div class="container mx-auto px-4 sm:px-6 py-6 space-y-6">
    <% if flash[:notice].present? || flash[:alert].present? %>
      <div class="rounded-lg border px-4 py-3 text-sm <%= flash[:alert].present? ? 'border-red-500/40 text-red-300' : 'border-border-default text-gray-200' %> bg-surface-card">
        <%= flash[:alert].presence || flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: agent_memory_entries_path(@agent), method: :get, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <%= f.search_field :q, value: @query, placeholder: "Search what I remember…", "aria-label": "Search memories",
            class: "flex-1 bg-surface-card border border-border-default rounded-lg px-4 py-2 text-white placeholder-text-faint focus:outline-none focus:border-brand" %>
      <div class="flex gap-3">
        <%= f.submit "Search", class: "flex-1 sm:flex-none px-4 py-2 bg-brand hover:bg-brand-dark rounded-lg transition cursor-pointer" %>
        <% if @query.present? %>
          <%= link_to "Clear", agent_memory_entries_path(@agent), class: "px-4 py-2 bg-surface-raised hover:bg-surface-card border border-border-default rounded-lg transition" %>
        <% end %>
      </div>
    <% end %>

    <% if can_edit %>
      <%= form_with url: forget_agent_memory_entries_path(@agent), method: :get, class: "flex flex-col sm:flex-row gap-3 bg-surface-card border border-border-default rounded-lg p-4" do |f| %>
        <%= f.label :topic, "Forget everything about…", class: "text-sm text-text-muted sm:self-center whitespace-nowrap" %>
        <%= f.text_field :topic, placeholder: "e.g. my old job", class: "flex-1 bg-surface-base border border-border-default rounded-lg px-4 py-2 text-white placeholder-text-faint focus:outline-none focus:border-brand" %>
        <%= f.submit "Review what will go", class: "px-4 py-2 bg-surface-raised hover:bg-surface-base border border-border-default rounded-lg transition cursor-pointer" %>
      <% end %>
    <% end %>

    <% if @grouped.empty? %>
      <div class="bg-surface-card rounded-lg border border-border-default text-text-muted text-center py-12 px-4">
        <%= @query.present? ? "Nothing I remember matches that." : "I haven't kept anything about you yet. Keep chatting and I'll pick things up." %>
      </div>
    <% else %>
      <% MemoryEntry::KINDS.each do |kind, label| %>
        <% entries = @grouped[kind] %>
        <% next if entries.blank? %>
        <section class="bg-surface-card rounded-lg border border-border-default">
          <h2 class="px-4 sm:px-6 py-3 border-b border-border-default text-lg font-semibold">
            <%= label %> <span class="text-text-faint text-sm font-normal">(<%= entries.size %>)</span>
          </h2>
          <ul class="divide-y divide-border-default">
            <% entries.each do |memory| %>
              <%= render "memory", memory: memory, agent: @agent, can_edit: can_edit %>
            <% end %>
          </ul>
        </section>
      <% end %>
    <% end %>

    <% if @forgotten.any? %>
      <section class="bg-surface-card rounded-lg border border-border-default">
        <h2 class="px-4 sm:px-6 py-3 border-b border-border-default text-lg font-semibold">Recently forgotten</h2>
        <ul class="divide-y divide-border-default">
          <% @forgotten.each do |memory| %>
            <li class="px-4 sm:px-6 py-3 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
              <p class="flex-1 text-sm text-text-muted line-through whitespace-pre-wrap break-words"><%= memory.content.truncate(200) %></p>
              <% if can_edit %>
                <div class="flex gap-4 text-xs">
                  <%= button_to "Undo", restore_agent_memory_entry_path(@agent, memory), method: :post, class: "text-brand hover:text-brand-dark transition cursor-pointer" %>
                  <%= button_to "Remove for good", agent_memory_entry_path(@agent, memory), method: :delete,
                        form: { data: { turbo_confirm: "Remove this for good? It can't be undone." } },
                        class: "text-red-400 hover:text-red-300 transition cursor-pointer" %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
