<div class="max-w-xl mx-auto py-8 px-4">
  <div class="mb-6">
    <%= link_to vault_entries_path, class: "text-text-faint hover:text-white text-sm" do %>&larr; Back to vault<% end %>
    <h1 class="text-2xl font-bold text-white mt-2">Replace value</h1>
    <p class="text-text-muted mt-1">The old value is overwritten and cannot be shown.</p>
  </div>

  <%= render "form", entry: @entry, url: vault_entry_path(@entry), method: :patch, submit: "Replace value" %>
</div>
