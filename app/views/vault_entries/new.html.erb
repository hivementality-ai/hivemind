<div class="max-w-xl mx-auto py-8 px-4">
  <div class="mb-6">
    <%= link_to vault_entries_path, class: "text-text-faint hover:text-white text-sm" do %>&larr; Back to Vault<% end %>
    <h1 class="text-2xl font-bold text-white mt-2">Add Key</h1>
    <p class="text-text-muted mt-1">The value is encrypted at rest and never displayed again in full.</p>
  </div>

  <%= form_with url: vault_entries_path, scope: :vault_entry, method: :post, class: "space-y-5" do |f| %>
    <div>
      <label class="block text-sm font-medium text-text-primary mb-1">Namespace</label>
      <%= f.text_field :namespace, value: @entry.namespace, required: true, placeholder: "e.g. openai, github, stripe",
            class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white font-mono focus:border-amber-500 focus:outline-none" %>
      <p class="text-text-faint text-xs mt-1">Groups related keys. Tools reference secrets as <span class="font-mono">vault:namespace/key</span>.</p>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-1">Key</label>
      <%= f.text_field :key, value: @entry.key, required: true, placeholder: "e.g. api_key, token",
            class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white font-mono focus:border-amber-500 focus:outline-none" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-1">Value</label>
      <%= f.password_field :value, required: true, autocomplete: "off", placeholder: "Paste the secret",
            class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white font-mono focus:border-amber-500 focus:outline-none" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-text-primary mb-1">Purpose <span class="text-text-faint">(optional)</span></label>
      <%= f.text_field :purpose, placeholder: "What is this used for?",
            class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white focus:border-amber-500 focus:outline-none" %>
    </div>

    <div class="flex gap-3 pt-2">
      <%= f.submit "Save Key", class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition cursor-pointer" %>
      <%= link_to "Cancel", vault_entries_path, class: "px-4 py-2 text-text-muted hover:text-white transition" %>
    </div>
  <% end %>
</div>
