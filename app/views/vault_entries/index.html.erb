<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Vault</h1>
      <p class="text-text-muted mt-1">Shared secrets. Values are stored encrypted and only ever shown redacted — agents can never read them, but tools and skills you build resolve them server-side.</p>
    </div>
    <%= link_to new_vault_entry_path, class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" do %>
      + Add Key
    <% end %>
  </div>

  <% if @entries.any? %>
    <div class="bg-surface-card/50 border border-border-default/50 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-text-faint text-xs uppercase border-b border-border-default/50">
          <tr>
            <th class="text-left font-medium px-5 py-3">Key</th>
            <th class="text-left font-medium px-5 py-3">Value</th>
            <th class="text-left font-medium px-5 py-3">Purpose</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default/30">
          <% @entries.each do |entry| %>
            <tr class="hover:bg-surface-card/60 transition">
              <td class="px-5 py-3">
                <span class="text-white font-mono"><%= entry.namespace %>.<%= entry.key %></span>
                <% if entry.tool_binding.present? %>
                  <span class="ml-2 px-2 py-0.5 text-xs rounded-full bg-amber-500/10 text-amber-400"><%= entry.tool_binding %></span>
                <% end %>
              </td>
              <td class="px-5 py-3 font-mono text-text-muted"><%= Vault::Redactor.redact(entry.value) %></td>
              <td class="px-5 py-3 text-text-muted"><%= entry.metadata&.dig("purpose") || "—" %></td>
              <td class="px-5 py-3 text-right">
                <%= button_to vault_entry_path(entry), method: :delete,
                      form: { data: { turbo_confirm: "Delete #{entry.namespace}.#{entry.key}? Tools relying on it will break." } },
                      class: "text-text-faint hover:text-red-400 transition text-xs" do %>
                  Delete
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-surface-card/30 rounded-xl border border-border-default/50">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
        <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h3 class="text-white font-semibold text-lg mb-2">The vault is empty</h3>
      <p class="text-text-muted mb-4">Add API keys, tokens, and other secrets for your agents' tools to use.</p>
      <%= link_to "Add Your First Key", new_vault_entry_path, class: "inline-block px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" %>
    </div>
  <% end %>
</div>
