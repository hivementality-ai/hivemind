<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Vault</h1>
      <p class="text-text-muted mt-1">Keys are kept in the vault and never shown to the AI. Values are encrypted and never shown here either; you can only replace them. Connectors point at a key as <span class="font-mono text-white">vault:namespace/key</span>.</p>
    </div>
    <%= link_to new_vault_entry_path, class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition shrink-0" do %>
      + Add key
    <% end %>
  </div>

  <% if @entries.any? %>
    <div class="bg-surface-card/50 border border-border-default/50 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-text-faint text-xs uppercase border-b border-border-default/50">
          <tr>
            <th class="text-left font-medium px-5 py-3">Namespace</th>
            <th class="text-left font-medium px-5 py-3">Key</th>
            <th class="text-left font-medium px-5 py-3">Value</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default/30">
          <% @entries.each do |entry| %>
            <tr class="hover:bg-surface-card/60 transition">
              <td class="px-5 py-3 text-white font-mono"><%= entry.namespace %></td>
              <td class="px-5 py-3 text-white font-mono"><%= entry.key %></td>
              <td class="px-5 py-3 text-text-muted">
                <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400">set</span>
                <span class="ml-2 text-xs">updated <%= time_ago_in_words(entry.updated_at) %> ago</span>
              </td>
              <td class="px-5 py-3">
                <div class="flex gap-3 justify-end items-center">
                  <%= link_to "Replace value", edit_vault_entry_path(entry), class: "text-amber-400 hover:text-amber-300 transition text-xs" %>
                  <%= button_to "Delete", vault_entry_path(entry), method: :delete,
                        form: { data: { turbo_confirm: "Delete #{entry.namespace}/#{entry.key}? Connectors using it will stop working." } },
                        class: "text-text-faint hover:text-red-400 transition text-xs" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-surface-card/30 rounded-xl border border-border-default/50">
      <h3 class="text-white font-semibold text-lg mb-2">The vault is empty</h3>
      <p class="text-text-muted mb-4">Add the API keys and tokens your connectors need.</p>
      <%= link_to "Add your first key", new_vault_entry_path, class: "inline-block px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" %>
    </div>
  <% end %>
</div>
