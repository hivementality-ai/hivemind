<div class="max-w-3xl mx-auto px-6 py-8">
  <!-- Header -->
  <div class="flex items-center gap-3 mb-8">
    <%= link_to provider_path(@provider), class: "text-text-muted hover:text-white transition" do %>
      ← Back to <%= @provider.name %>
    <% end %>
    <span class="text-text-muted">/</span>
    <h1 class="text-3xl font-bold text-white">Edit Credentials</h1>
  </div>

  <!-- Edit Form -->
  <div class="bg-surface-card rounded-xl border border-border-default p-8">
    <%= form_with model: @provider, url: provider_path(@provider), method: :patch, class: "space-y-6" do |f| %>
      <% if @provider.errors.any? %>
        <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
          <h3 class="font-semibold mb-2"><%= pluralize(@provider.errors.count, "error") %> prevented this provider from being saved:</h3>
          <ul class="list-disc list-inside space-y-1">
            <% @provider.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Provider Badge & Status -->
      <div class="bg-surface-raised rounded-lg border border-border-default p-5">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 <%= provider_badge_bg(@provider.adapter_type) %> rounded-lg flex items-center justify-center text-white font-bold text-lg">
              <%= provider_badge_icon(@provider.adapter_type) %>
            </div>
            <div>
              <h3 class="text-white font-semibold text-lg"><%= @provider.name %></h3>
              <p class="text-text-muted text-sm"><%= @provider.adapter_type.titleize %></p>
            </div>
          </div>
          <% if @provider.enabled? %>
            <span class="px-3 py-1 bg-green-900/50 border border-green-700/50 rounded-full text-green-300 text-xs font-medium">
              ✓ Active
            </span>
          <% else %>
            <span class="px-3 py-1 bg-gray-900/50 border border-gray-700/50 rounded-full text-gray-400 text-xs font-medium">
              ✗ Inactive
            </span>
          <% end %>
        </div>
      </div>

      <!-- Security Notice -->
      <div class="bg-blue-900/30 border border-blue-700/50 rounded-lg p-4 mb-4">
        <p class="text-blue-300 text-sm flex items-start gap-2">
          <span class="text-lg">🔒</span>
          <span><strong>Security:</strong> All API keys are encrypted at rest.</span>
        </p>
      </div>

      <!-- API Key Section -->
      <div class="space-y-4">
        <div>
          <label class="block text-text-primary font-semibold mb-2">
            API Key
            <% if @api_key.present? %>
              <span class="ml-2 inline-block px-2 py-1 bg-green-900/50 border border-green-700/50 rounded text-green-300 text-xs font-medium">Currently Set</span>
            <% else %>
              <span class="ml-2 inline-block px-2 py-1 bg-yellow-900/50 border border-yellow-700/50 rounded text-yellow-300 text-xs font-medium">Not Set</span>
            <% end %>
          </label>
          <%= f.text_field :api_key,
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent font-mono text-sm",
              placeholder: placeholder_for(@provider.adapter_type),
              autocomplete: "off",
              value: @api_key %>
          <p class="text-text-faint text-xs mt-2">
            <% case @provider.adapter_type %>
              <% when "anthropic" %>
                Get a key at <a href="https://console.anthropic.com/" target="_blank" class="text-brand-light hover:underline">console.anthropic.com</a>
              <% when "openai" %>
                Get a key at <a href="https://platform.openai.com/" target="_blank" class="text-brand-light hover:underline">platform.openai.com</a>
              <% when "ollama" %>
                Leave blank for local Ollama (no API key needed). Modify the URL in Advanced Settings if running on another machine.
              <% when "openai_compatible" %>
                Required for cloud providers (Minimax, OpenRouter, Together AI). Leave blank for local servers.
            <% end %>
          </p>
        </div>

        <% if @provider.adapter_type == "ollama" %>
          <!-- Ollama Advanced Settings -->
          <details class="mt-4">
            <summary class="text-text-muted text-sm cursor-pointer hover:text-white transition select-none flex items-center gap-2">
              <span class="text-lg">▶</span> Advanced Settings
            </summary>
            <div class="mt-3 p-4 bg-surface-overlay rounded-lg border border-border-default space-y-3">
              <div>
                <label class="block text-text-primary font-medium text-sm mb-1">Ollama URL</label>
                <input type="text"
                       id="ollama-custom-url"
                       name="provider_config[base_url]"
                       class="w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent font-mono text-sm"
                       placeholder="http://host.docker.internal:11434"
                       value="<%= @provider.base_url || 'http://host.docker.internal:11434' %>">
                <p class="text-text-faint text-xs mt-1">
                  Change this if Ollama is running on another machine (e.g. <code class="text-text-muted">http://192.168.1.100:11434</code>)
                </p>
                <button type="button" onclick="detectOllamaModels()"
                        class="mt-2 px-3 py-1.5 bg-purple-600 hover:bg-purple-700 text-white text-xs font-medium rounded-lg transition cursor-pointer">
                  Check Connection
                </button>
              </div>
            </div>
          </details>
        <% end %>

        <% if @provider.adapter_type == "openai_compatible" %>
          <!-- OpenAI Compatible Advanced Settings -->
          <details class="mt-4">
            <summary class="text-text-muted text-sm cursor-pointer hover:text-white transition select-none flex items-center gap-2">
              <span class="text-lg">▶</span> Advanced Settings
            </summary>
            <div class="mt-3 p-4 bg-surface-overlay rounded-lg border border-border-default space-y-3">
              <div>
                <label class="block text-text-primary font-medium text-sm mb-1">Server URL</label>
                <input type="text"
                       id="openai-compatible-custom-url"
                       name="provider_config[base_url]"
                       class="w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono text-sm"
                       placeholder="https://api.minimax.chat/v1"
                       value="<%= @provider.base_url %>">
                <p class="text-text-faint text-xs mt-1">
                  The API base URL (e.g. <code class="text-text-muted">https://api.minimax.chat/v1</code> or <code class="text-text-muted">http://localhost:8080</code>)
                </p>
                <button type="button" onclick="detectOpenaiCompatibleModels()"
                        class="mt-2 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded-lg transition cursor-pointer">
                  Check Connection
                </button>
              </div>
            </div>
          </details>
        <% end %>
      </div>

      <!-- Model Selection -->
      <div class="space-y-4">
        <label class="block text-text-primary font-semibold">Select Available Models</label>

        <!-- Anthropic/OpenAI Static Model List -->
        <% if !%w[ollama openai_compatible].include?(@provider.adapter_type) %>
          <div class="space-y-2" id="model-list">
            <% @available_models.each do |model| %>
              <% is_selected = @selected_models.any? { |m| m["id"] == model[:id] } %>
              <label class="flex items-start gap-3 p-4 bg-surface-raised rounded-lg cursor-pointer hover:bg-surface-overlay transition group border border-border-default/50">
                <input type="checkbox"
                       name="provider_config[models][]"
                       value="<%= model[:id] %>"
                       <%= "checked" if is_selected %>
                       class="mt-1 w-4 h-4 rounded border-gray-500 text-brand focus:ring-brand bg-surface-overlay flex-shrink-0">
                <div class="flex-1">
                  <span class="text-white text-sm font-medium block"><%= model[:name] %></span>
                  <p class="text-text-muted text-xs"><%= model[:desc] %></p>
                </div>
              </label>
            <% end %>
          </div>
        <% elsif @provider.adapter_type == "ollama" %>
          <!-- Ollama Dynamic Model List -->
          <div id="ollama-models-container" class="space-y-2">
            <p class="text-text-muted text-sm">Click "Check Connection" above to detect installed Ollama models.</p>
          </div>
        <% elsif @provider.adapter_type == "openai_compatible" %>
          <!-- OpenAI Compatible Dynamic Model List -->
          <div id="openai-compatible-models-container" class="space-y-2">
            <% if @selected_models.present? %>
              <% @selected_models.each do |model| %>
                <label class="flex items-start gap-3 p-4 bg-surface-raised rounded-lg cursor-pointer hover:bg-surface-overlay transition group border border-border-default/50">
                  <input type="checkbox" name="provider_config[models][]" value="<%= model["id"] %>" checked
                         class="mt-1 w-4 h-4 rounded border-gray-500 text-blue-600 focus:ring-blue-500 bg-surface-overlay flex-shrink-0">
                  <div class="flex-1">
                    <span class="text-white text-sm font-medium block"><%= model["id"] %></span>
                  </div>
                </label>
              <% end %>
            <% else %>
              <p class="text-text-muted text-sm">Click "Check Connection" above to detect loaded models, or add them manually below.</p>
            <% end %>
          </div>
          <!-- Manual model entry -->
          <div class="mt-3 flex gap-2">
            <input type="text" id="openai-compatible-custom-model"
                   class="flex-1 px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono text-sm"
                   placeholder="Enter model name (e.g. minimax-01)">
            <button type="button" onclick="addCustomOpenaiCompatibleModel()"
                    class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-medium rounded-lg transition cursor-pointer whitespace-nowrap">
              Add Model
            </button>
          </div>
          <p class="text-text-faint text-xs mt-1">
            Manually add models if the server doesn't support the <code class="text-text-muted">/v1/models</code> endpoint.
          </p>
        <% end %>
      </div>

      <!-- Default Model Selection -->
      <% if @available_models.present? || !%w[ollama].include?(@provider.adapter_type) %>
        <div class="space-y-2">
          <label class="block text-text-primary font-semibold text-sm">Default Model</label>
          <select name="provider_config[default_model]"
                  class="w-full px-4 py-2 bg-surface-raised border border-border-default rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand">
            <option value="">Select a default...</option>
            <% if %w[anthropic openai].include?(@provider.adapter_type) %>
              <% LlmModelRegistry.supported_for_provider(@provider.adapter_type).each do |model| %>
                <option value="<%= model.api_id %>" <%= "selected" if @selected_models.any? { |m| m["default"] && m["id"] == model.api_id } %>><%= model.display_name %></option>
              <% end %>
            <% elsif @provider.adapter_type == "openai_compatible" %>
              <% @selected_models.each do |model| %>
                <option value="<%= model["id"] %>" <%= "selected" if model["default"] %>><%= model["id"] %></option>
              <% end %>
            <% end %>
          </select>
        </div>
      <% end %>

      <!-- Default Reasoning Effort -->
      <% if %w[anthropic openai].include?(@provider.adapter_type) %>
        <div class="space-y-2">
          <label class="block text-text-primary font-semibold text-sm">Default Reasoning Effort</label>
          <select name="provider_config[effort]"
                  class="w-full px-4 py-2 bg-surface-raised border border-border-default rounded-lg text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand">
            <% current_effort = Setting.get("provider_effort_#{@provider.adapter_type}").to_s %>
            <option value="" <%= "selected" if current_effort.blank? %>>Model default (high)</option>
            <% Agent::EFFORT_LEVELS.each do |level| %>
              <option value="<%= level %>" <%= "selected" if current_effort == level %>><%= level %></option>
            <% end %>
          </select>
          <p class="text-text-muted text-xs">Applies to every agent on this provider that doesn't set its own effort. Controls thinking depth &amp; token spend on reasoning models.</p>
        </div>
      <% end %>

      <% if @provider.adapter_type == "anthropic" %>
        <!-- Anthropic Debug & Routing -->
        <div class="bg-surface-raised rounded-lg border border-border-default p-5 space-y-4">
          <h3 class="text-white font-semibold text-sm">Debug & Routing</h3>

          <label class="flex items-start gap-3 cursor-pointer">
            <input type="hidden" name="provider_config[prompt_debug_enabled]" value="0">
            <input type="checkbox"
                   name="provider_config[prompt_debug_enabled]"
                   value="1"
                   <%= "checked" if Setting.get("prompt_debug_enabled") == "true" %>
                   class="mt-1 w-4 h-4 rounded border-gray-500 text-brand focus:ring-brand bg-surface-overlay flex-shrink-0">
            <div class="flex-1">
              <span class="text-white text-sm font-medium block">Log API requests & responses</span>
              <p class="text-text-muted text-xs">Writes full outbound body + response body (or streaming summary) to Rails logs. Look for <code class="text-text-primary font-mono">[Anthropic→]</code> / <code class="text-text-primary font-mono">[Anthropic←]</code>.</p>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer">
            <input type="hidden" name="provider_config[anthropic_use_sdk_proxy]" value="0">
            <input type="checkbox"
                   name="provider_config[anthropic_use_sdk_proxy]"
                   value="1"
                   <%= "checked" if Providers::AnthropicAdapter.sdk_proxy_enabled? %>
                   class="mt-1 w-4 h-4 rounded border-gray-500 text-brand focus:ring-brand bg-surface-overlay flex-shrink-0">
            <div class="flex-1">
              <span class="text-white text-sm font-medium block">Use Node SDK proxy for OAuth (fallback)</span>
              <p class="text-text-muted text-xs">When off (default), OAuth tokens hit <code class="text-text-primary font-mono">/v1/messages</code> via the Ruby Faraday client. Toggle on to fall back to the legacy <code class="text-text-primary font-mono">sdk-proxy</code> container — useful for A/B testing a broken request.</p>
            </div>
          </label>
        </div>
      <% end %>

      <!-- Form Actions -->
      <div class="flex gap-3 pt-4 border-t border-border-default">
        <%= f.submit "Save Changes", class: "px-6 py-2 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition" %>
        <%= link_to "Cancel", provider_path(@provider), class: "px-6 py-2 bg-surface-raised hover:bg-surface-overlay text-white font-semibold rounded-lg transition" %>
      </div>
    <% end %>
  </div>

  <!-- Ollama Detection Script -->
  <script>
    function detectOllamaModels() {
      const urlInput = document.getElementById('ollama-custom-url');
      const url = urlInput ? urlInput.value : 'http://host.docker.internal:11434';
      const container = document.getElementById('ollama-models-container');

      container.innerHTML = '<p class="text-text-muted text-sm">Detecting models...</p>';

      fetch(`/setup/ollama_models?url=${encodeURIComponent(url)}`)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'connected' && data.models.length > 0) {
            let html = '<p class="text-green-300 text-sm font-medium mb-2">✓ Connected — ' + data.models.length + ' model(s) found</p>';
            html += '<div class="space-y-2">';
            data.models.forEach((m, i) => {
              html += `
                <label class="flex items-start gap-3 p-4 bg-surface-raised rounded-lg cursor-pointer hover:bg-surface-overlay transition group border border-border-default/50">
                  <input type="checkbox" name="provider_config[models][]" value="${m.id}" ${i === 0 ? 'checked' : ''}
                         class="mt-1 w-4 h-4 rounded border-gray-500 text-purple-600 focus:ring-purple-500 bg-surface-overlay flex-shrink-0">
                  <div class="flex-1">
                    <span class="text-white text-sm font-medium block">${m.name}</span>
                    <p class="text-text-muted text-xs">${m.parameter_size || m.size + 'GB'}${m.family ? ' · ' + m.family : ''}</p>
                  </div>
                </label>`;
            });
            html += '</div>';
            container.innerHTML = html;
          } else if (data.status === 'connected') {
            container.innerHTML = '<p class="text-yellow-300 text-sm">Ollama is running but no models installed. Run: <code class="text-text-primary font-mono text-xs">ollama pull llama3.2:3b</code></p>';
          } else {
            showOllamaError(data.message || 'Could not connect');
          }
        })
        .catch(() => {
          showOllamaError('Could not reach Ollama. Make sure it is installed and running.');
        });
    }

    function showOllamaError(msg) {
      const container = document.getElementById('ollama-models-container');
      container.innerHTML = `
        <p class="text-red-300 text-sm mb-2">⚠ Error: ${msg}</p>
        <p class="text-text-faint text-xs">Install Ollama from <a href="https://ollama.com/" target="_blank" class="text-brand-light hover:underline">ollama.com</a></p>`;
    }

    function detectOpenaiCompatibleModels() {
      const urlInput = document.getElementById('openai-compatible-custom-url');
      const url = urlInput ? urlInput.value : 'http://host.docker.internal:8080';
      const apiKeyField = document.querySelector('[name="provider_config[api_key]"]');
      const apiKey = apiKeyField ? apiKeyField.value.trim() : '';
      const container = document.getElementById('openai-compatible-models-container');

      container.innerHTML = '<p class="text-text-muted text-sm">Detecting models...</p>';

      let fetchUrl = `/setup/openai_compatible_models?url=${encodeURIComponent(url)}`;
      if (apiKey) fetchUrl += `&api_key=${encodeURIComponent(apiKey)}`;
      fetch(fetchUrl)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'connected' && data.models.length > 0) {
            let html = '<p class="text-green-300 text-sm font-medium mb-2">✓ Connected — ' + data.models.length + ' model(s) loaded</p>';
            html += '<div class="space-y-2">';
            data.models.forEach((m, i) => {
              html += `
                <label class="flex items-start gap-3 p-4 bg-surface-raised rounded-lg cursor-pointer hover:bg-surface-overlay transition group border border-border-default/50">
                  <input type="checkbox" name="provider_config[models][]" value="${m.id}" ${i === 0 ? 'checked' : ''}
                         class="mt-1 w-4 h-4 rounded border-gray-500 text-blue-600 focus:ring-blue-500 bg-surface-overlay flex-shrink-0">
                  <div class="flex-1">
                    <span class="text-white text-sm font-medium block">${m.name}</span>
                  </div>
                </label>`;
            });
            html += '</div>';
            container.innerHTML = html;
          } else if (data.status === 'connected') {
            container.innerHTML = '<p class="text-yellow-300 text-sm">Server is running but no model is loaded. Make sure your server has a model available.</p>';
          } else {
            showOpenaiCompatibleError(data.message || 'Could not connect');
          }
        })
        .catch(() => {
          showOpenaiCompatibleError('Could not reach server. Make sure it is running.');
        });
    }

    function showOpenaiCompatibleError(msg) {
      const container = document.getElementById('openai-compatible-models-container');
      container.innerHTML = `
        <p class="text-red-300 text-sm mb-2">⚠ Error: ${msg}</p>
        <p class="text-text-faint text-xs">Make sure your OpenAI-compatible server is running and accessible.</p>`;
    }

    function addCustomOpenaiCompatibleModel() {
      const input = document.getElementById('openai-compatible-custom-model');
      const modelId = input.value.trim();
      if (!modelId) return;

      const container = document.getElementById('openai-compatible-models-container');
      const placeholder = container.querySelector('p.text-text-muted');
      if (placeholder) placeholder.remove();

      const label = document.createElement('label');
      label.className = 'flex items-start gap-3 p-4 bg-surface-raised rounded-lg cursor-pointer hover:bg-surface-overlay transition group border border-border-default/50';
      label.innerHTML = `
        <input type="checkbox" name="provider_config[models][]" value="${modelId}" checked
               class="mt-1 w-4 h-4 rounded border-gray-500 text-blue-600 focus:ring-blue-500 bg-surface-overlay flex-shrink-0">
        <div class="flex-1">
          <span class="text-white text-sm font-medium block">${modelId}</span>
        </div>`;
      container.appendChild(label);

      const select = document.querySelector('[name="provider_config[default_model]"]');
      if (select) {
        const opt = document.createElement('option');
        opt.value = modelId;
        opt.textContent = modelId;
        if (select.options.length <= 1) opt.selected = true;
        select.appendChild(opt);
      }

      input.value = '';
    }
  </script>
</div>
