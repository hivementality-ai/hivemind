<div class="max-w-6xl mx-auto px-6 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between mb-8">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 bg-brand/20 rounded-lg flex items-center justify-center text-brand font-bold text-lg">⚙️</div>
      <div>
        <h1 class="text-3xl font-bold text-white">Provider Management</h1>
        <p class="text-text-faint text-sm">Manage AI provider credentials and model configurations</p>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <%= link_to new_provider_path, class: "px-4 py-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium rounded-lg transition" do %>
        + Add Provider
      <% end %>
      <%= link_to root_path, class: "px-4 py-2 bg-surface-raised hover:bg-surface-overlay text-white text-sm font-medium rounded-lg transition" do %>
        ← Back
      <% end %>
    </div>
  </div>

  <% if notice %>
    <div class="mb-6 bg-green-900/50 border border-green-600 text-green-200 px-4 py-3 rounded-lg text-sm flex items-center gap-2">
      <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
      <%= notice %>
    </div>
  <% end %>

  <!-- Provider Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @providers.each do |provider| %>
      <div class="bg-surface-card rounded-xl border border-border-default p-6 hover:border-brand/50 transition">
        <!-- Provider Header -->
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 <%= provider_badge_bg(provider.adapter_type) %> rounded-lg flex items-center justify-center text-white font-bold text-sm">
              <%= provider_badge_icon(provider.adapter_type) %>
            </div>
            <div>
              <h3 class="text-white font-semibold"><%= provider.name %></h3>
              <p class="text-text-muted text-xs"><%= provider.adapter_type.titleize %></p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <% if provider.enabled? %>
              <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-900/50 border border-green-700/50 rounded-full text-green-300 text-xs font-medium">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                Active
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 px-2 py-1 bg-gray-900/50 border border-gray-700/50 rounded-full text-gray-400 text-xs font-medium">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                Inactive
              </span>
            <% end %>
          </div>
        </div>

        <!-- Provider Info -->
        <div class="space-y-3 mb-4 pb-4 border-b border-border-default">
          <% if provider.api_key.present? %>
            <div class="flex items-center justify-between">
              <span class="text-text-muted text-sm">API Key</span>
              <span class="text-green-400 text-xs font-medium">✓ Configured</span>
            </div>
          <% else %>
            <div class="flex items-center justify-between">
              <span class="text-text-muted text-sm">API Key</span>
              <span class="text-yellow-400 text-xs font-medium">⚠ Not Set</span>
            </div>
          <% end %>

          <% if provider.model_definitions.present? %>
            <div>
              <span class="text-text-muted text-sm">Models (<%= provider.model_definitions.count %>)</span>
              <div class="mt-1 flex flex-wrap gap-1">
                <% provider.model_definitions.each do |model| %>
                  <span class="inline-block px-2 py-1 bg-surface-overlay rounded text-text-primary text-xs font-mono">
                    <%= model["id"] %>
                    <% if model["default"] %>
                      <span class="text-brand text-xs ml-0.5">★</span>
                    <% end %>
                  </span>
                <% end %>
              </div>
            </div>
          <% else %>
            <div class="text-text-muted text-sm">No models selected</div>
          <% end %>
        </div>

        <!-- Actions -->
        <div class="flex gap-2">
          <%= link_to edit_provider_path(provider, edit_mode: true), class: "flex-1 px-3 py-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium rounded-lg transition text-center" do %>
            Edit
          <% end %>
          <%= link_to provider_path(provider), class: "flex-1 px-3 py-2 bg-surface-raised hover:bg-surface-overlay text-white text-sm font-medium rounded-lg transition text-center" do %>
            View
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Info Box -->
  <div class="mt-8 p-4 bg-brand-glow/30 border border-brand-dark/50 rounded-lg flex items-start gap-3">
    <svg class="w-5 h-5 text-brand-light flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div>
      <p class="text-brand-light text-sm"><strong>Security:</strong> All API keys are encrypted at rest.</p>
      <p class="text-text-faint text-sm mt-1">Changes are reflected immediately for new agent deployments.</p>
    </div>
  </div>
</div>
