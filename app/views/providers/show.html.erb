<div class="max-w-3xl mx-auto px-6 py-8">
  <!-- Header -->
  <div class="flex items-center gap-3 mb-8">
    <%= link_to providers_path, class: "text-text-muted hover:text-white transition" do %>
      ← Providers
    <% end %>
    <span class="text-text-muted">/</span>
    <h1 class="text-3xl font-bold text-white"><%= @provider.name %></h1>
  </div>

  <!-- Provider Details -->
  <div class="bg-surface-card rounded-xl border border-border-default p-8 space-y-6">
    <!-- Provider Badge -->
    <div class="bg-surface-raised rounded-lg border border-border-default p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 <%= provider_badge_bg(@provider.adapter_type) %> rounded-lg flex items-center justify-center text-white font-bold text-lg">
            <%= provider_badge_icon(@provider.adapter_type) %>
          </div>
          <div>
            <h3 class="text-white font-semibold text-lg"><%= @provider.name %></h3>
            <p class="text-text-muted text-sm"><%= @provider.adapter_type.titleize %></p>
          </div>
        </div>
        <% if @provider.enabled? %>
          <span class="px-3 py-1 bg-green-900/50 border border-green-700/50 rounded-full text-green-300 text-xs font-medium">
            ✓ Active
          </span>
        <% else %>
          <span class="px-3 py-1 bg-gray-900/50 border border-gray-700/50 rounded-full text-gray-400 text-xs font-medium">
            ✗ Inactive
          </span>
        <% end %>
      </div>
    </div>

    <!-- Configuration Info -->
    <div class="grid grid-cols-2 gap-4">
      <div class="bg-surface-raised rounded-lg border border-border-default p-4">
        <p class="text-text-muted text-xs uppercase tracking-wide mb-1">API Key</p>
        <% if @provider.api_key.present? %>
          <p class="text-green-400 text-sm font-medium">✓ Configured</p>
          <p class="text-text-faint text-xs mt-1">Key is stored securely and encrypted</p>
        <% else %>
          <p class="text-yellow-400 text-sm font-medium">⚠ Not Set</p>
          <p class="text-text-faint text-xs mt-1">Edit this provider to add a key</p>
        <% end %>
      </div>

      <div class="bg-surface-raised rounded-lg border border-border-default p-4">
        <p class="text-text-muted text-xs uppercase tracking-wide mb-1">Models</p>
        <% if @provider.model_definitions.present? %>
          <p class="text-white text-sm font-medium"><%= @provider.model_definitions.count %> model<%= "s" if @provider.model_definitions.count != 1 %> selected</p>
          <% default_model = @provider.model_definitions.find { |m| m["default"] } %>
          <% if default_model %>
            <p class="text-text-faint text-xs mt-1">Default: <code class="text-text-primary font-mono"><%= default_model["id"] %></code></p>
          <% end %>
        <% else %>
          <p class="text-gray-400 text-sm font-medium">None selected</p>
          <p class="text-text-faint text-xs mt-1">Edit this provider to add models</p>
        <% end %>
      </div>
    </div>

    <!-- Models List -->
    <% if @provider.model_definitions.present? %>
      <div>
        <h3 class="text-text-primary font-semibold text-sm mb-3">Selected Models</h3>
        <div class="space-y-2">
          <% @provider.model_definitions.each do |model| %>
            <div class="bg-surface-raised rounded-lg border border-border-default p-3 flex items-center justify-between">
              <code class="text-text-primary font-mono text-sm"><%= model["id"] %></code>
              <% if model["default"] %>
                <span class="inline-flex items-center gap-1 px-2 py-1 bg-brand/20 border border-brand/50 rounded text-brand text-xs font-medium">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                  Default
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Action Buttons -->
    <div class="flex gap-3 pt-4 border-t border-border-default">
      <%= link_to "Edit", edit_provider_path(@provider), class: "px-6 py-2 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition" %>
      <%= link_to "Back to List", providers_path, class: "px-6 py-2 bg-surface-raised hover:bg-surface-overlay text-white font-semibold rounded-lg transition" %>
    </div>
  </div>
</div>
