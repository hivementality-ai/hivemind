<div class="max-w-3xl mx-auto px-6 py-8">
  <!-- Header -->
  <div class="flex items-center gap-3 mb-8">
    <%= link_to providers_path, class: "text-text-muted hover:text-white transition" do %>
      ← Providers
    <% end %>
    <span class="text-text-muted">/</span>
    <h1 class="text-3xl font-bold text-white"><%= @provider.name %></h1>
  </div>

  <!-- Provider Details Card -->
  <div class="bg-surface-card rounded-xl border border-border-default p-8 space-y-6">
    <!-- Provider Badge & Status -->
    <div class="bg-surface-raised rounded-lg border border-border-default p-5">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 <%= provider_badge_bg(@provider.adapter_type) %> rounded-lg flex items-center justify-center text-white font-bold text-lg">
            <%= provider_badge_icon(@provider.adapter_type) %>
          </div>
          <div>
            <h3 class="text-white font-semibold text-lg"><%= @provider.name %></h3>
            <p class="text-text-muted text-sm"><%= @provider.adapter_type.titleize %></p>
          </div>
        </div>
        <% if @provider.enabled? %>
          <span class="px-3 py-1 bg-green-900/50 border border-green-700/50 rounded-full text-green-300 text-xs font-medium">
            ✓ Active
          </span>
        <% else %>
          <span class="px-3 py-1 bg-gray-900/50 border border-gray-700/50 rounded-full text-gray-400 text-xs font-medium">
            ✗ Inactive
          </span>
        <% end %>
      </div>
    </div>

    <!-- API Key Status (Encrypted) -->
    <div class="bg-surface-raised rounded-lg border border-border-default p-5">
      <div class="flex items-center justify-between">
        <div>
          <h4 class="text-text-primary font-semibold mb-1">API Credentials</h4>
          <p class="text-text-muted text-sm">All API keys are encrypted at rest</p>
        </div>
        <% if @api_key.present? %>
          <span class="px-3 py-1 bg-green-900/50 border border-green-700/50 rounded text-green-300 text-xs font-medium">
            ✓ Configured
          </span>
        <% else %>
          <span class="px-3 py-1 bg-yellow-900/50 border border-yellow-700/50 rounded text-yellow-300 text-xs font-medium">
            Not Set
          </span>
        <% end %>
      </div>
    </div>

    <!-- Models Configuration -->
    <% if @selected_models.present? %>
      <div class="bg-surface-raised rounded-lg border border-border-default p-5">
        <h4 class="text-text-primary font-semibold mb-3">Available Models</h4>
        <div class="space-y-2">
          <% @selected_models.each do |model| %>
            <div class="flex items-center justify-between p-3 bg-surface-overlay rounded-lg border border-border-default/50">
              <div class="flex items-center gap-2">
                <span class="text-white text-sm"><%= model["id"] %></span>
                <% if model["default"] %>
                  <span class="px-2 py-0.5 bg-brand/20 border border-brand/50 rounded text-brand text-xs font-medium">Default</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Action Footer -->
  <div class="flex gap-3 pt-6">
    <%= button_to "Edit Credentials", edit_provider_path(@provider, edit_mode: true),
        method: :get,
        class: "px-6 py-2 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition" %>
    <%= link_to "Back to Providers", providers_path, class: "px-6 py-2 bg-surface-raised hover:bg-surface-overlay text-white font-semibold rounded-lg transition" %>
  </div>
</div>
