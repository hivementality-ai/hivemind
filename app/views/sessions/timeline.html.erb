<div class="flex flex-col min-h-screen bg-surface-card">
  <!-- Header -->
  <div class="flex items-center gap-4 px-6 py-4 border-b border-border-default bg-surface-card/50 flex-shrink-0">
    <%= agent_avatar(@agent, size: :md) %>
    <div>
      <h1 class="text-white font-semibold"><%= @agent.name %></h1>
      <p class="text-text-muted text-xs">
        <%= @session.title.present? && @session.title != "New Chat" ? @session.title : "Session #{@session.id}" %>
        &middot; <%= @agent.llm_model %>
      </p>
    </div>
    <div class="ml-auto flex items-center gap-2">
      <%= link_to session_path(@session), class: "flex items-center gap-1 text-text-muted hover:text-white text-xs transition px-2 py-1 border border-border-default rounded hover:border-brand" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <span>Chat</span>
      <% end %>
      <span class="flex items-center gap-1 text-brand text-xs px-2 py-1 border border-brand/50 rounded bg-brand/10">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Timeline
      </span>
    </div>
  </div>

  <!-- Timeline body -->
  <div class="flex-1 px-6 py-6 max-w-4xl w-full mx-auto">
    <% if @entries.empty? %>
      <div class="flex items-center justify-center h-64 text-text-faint text-sm">No activity recorded yet.</div>
    <% else %>
      <ol class="relative border-l border-border-default ml-3 space-y-6">
        <% @entries.each do |entry| %>
          <% case entry[:kind] %>
          <% when :message %>
            <% msg = entry[:data] %>
            <% is_user = msg["role"] == "user" %>
            <% is_sub  = msg["source"] == "sub_agent" %>
            <li class="ml-6">
              <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full border border-border-default
                <%= is_sub ? 'bg-purple-900/40' : is_user ? 'bg-brand/20' : 'bg-surface-raised' %>">
                <% if is_sub %>
                  <svg class="w-3 h-3 text-purple-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v1h1a1 1 0 110 2h-1v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7H2a1 1 0 110-2h1V4zm3 1v1h6V5H7zm-1 3v8h8V8H6z" clip-rule="evenodd"/></svg>
                <% elsif is_user %>
                  <svg class="w-3 h-3 text-brand" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/></svg>
                <% else %>
                  <svg class="w-3 h-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 10a8 8 0 1116 0A8 8 0 012 10zm8-3a1 1 0 00-1 1v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V8a1 1 0 00-1-1z"/></svg>
                <% end %>
              </span>
              <div class="mb-1 flex items-center gap-2">
                <span class="text-xs font-semibold <%= is_sub ? 'text-purple-400' : is_user ? 'text-brand' : 'text-amber-400' %>">
                  <%= is_sub ? "Sub-agent" : is_user ? "User" : "Agent" %>
                </span>
                <time class="text-text-faint text-xs"><%= entry[:ts].strftime("%H:%M:%S") %></time>
              </div>
              <div class="bg-surface-raised rounded-xl px-4 py-3 text-gray-100 text-sm whitespace-pre-wrap break-words">
                <%= msg["content"].to_s.truncate(600) %>
              </div>
            </li>

          <% when :tool %>
            <% te = entry[:data] %>
            <% success = %w[completed approved].include?(te.status) %>
            <li class="ml-6">
              <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full border border-border-default
                <%= success ? 'bg-green-900/40' : te.status == 'failed' ? 'bg-red-900/40' : 'bg-yellow-900/40' %>">
                <svg class="w-3 h-3 <%= success ? 'text-green-400' : te.status == 'failed' ? 'text-red-400' : 'text-yellow-400' %>"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <div class="mb-1 flex items-center gap-2 flex-wrap">
                <span class="text-xs font-semibold text-text-primary">Tool call</span>
                <code class="text-xs bg-surface-card px-1.5 py-0.5 rounded text-amber-300"><%= te.tool.name %></code>
                <span class="text-xs px-1.5 py-0.5 rounded font-medium
                  <%= success ? 'bg-green-900/40 text-green-400' : te.status == 'failed' ? 'bg-red-900/40 text-red-400' : 'bg-yellow-900/40 text-yellow-400' %>">
                  <%= te.status %>
                </span>
                <% if te.duration_ms %>
                  <span class="text-text-faint text-xs"><%= te.duration_ms %> ms</span>
                <% end %>
                <time class="text-text-faint text-xs ml-auto"><%= entry[:ts].strftime("%H:%M:%S") %></time>
              </div>
              <details class="bg-surface-raised rounded-xl text-xs text-gray-300">
                <summary class="px-4 py-2 cursor-pointer hover:text-white select-none">Input / Output</summary>
                <div class="px-4 pb-3 space-y-2 border-t border-border-default pt-2">
                  <div>
                    <div class="text-text-faint font-medium mb-1">Input</div>
                    <pre class="whitespace-pre-wrap break-all text-gray-400"><%= JSON.pretty_generate(te.input).truncate(1000) %></pre>
                  </div>
                  <% if te.output.present? %>
                    <div>
                      <div class="text-text-faint font-medium mb-1">Output</div>
                      <pre class="whitespace-pre-wrap break-all text-gray-400"><%= te.output.to_s.truncate(1000) %></pre>
                    </div>
                  <% end %>
                  <% if te.error.present? %>
                    <div>
                      <div class="text-red-400 font-medium mb-1">Error</div>
                      <pre class="whitespace-pre-wrap break-all text-red-300"><%= te.error.truncate(500) %></pre>
                    </div>
                  <% end %>
                </div>
              </details>
            </li>

          <% when :usage %>
            <% ur = entry[:data] %>
            <li class="ml-6">
              <span class="absolute -left-3 flex items-center justify-center w-6 h-6 rounded-full border border-border-default bg-blue-900/40">
                <svg class="w-3 h-3 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM2 11v3a2 2 0 002 2h12a2 2 0 002-2v-3H2zm5 2h6a1 1 0 110 2H7a1 1 0 110-2z"/>
                </svg>
              </span>
              <div class="mb-1 flex items-center gap-2 flex-wrap">
                <span class="text-xs font-semibold text-blue-400">LLM call</span>
                <code class="text-xs bg-surface-card px-1.5 py-0.5 rounded text-blue-300"><%= ur.llm_model %></code>
                <span class="text-text-faint text-xs"><%= ur.provider %></span>
                <span class="text-text-faint text-xs">&uarr;&nbsp;<%= ur.input_tokens %> &darr;&nbsp;<%= ur.output_tokens %> tokens</span>
                <% if ur.cost_cents.to_f > 0 %>
                  <span class="text-green-400 text-xs">$<%= format("%.4f", ur.cost_cents.to_f / 100) %></span>
                <% end %>
                <time class="text-text-faint text-xs ml-auto"><%= entry[:ts].strftime("%H:%M:%S") %></time>
              </div>
            </li>
          <% end %>
        <% end %>
      </ol>
    <% end %>
  </div>

  <!-- Footer totals -->
  <div class="border-t border-border-default bg-surface-card/80 px-6 py-4">
    <div class="max-w-4xl mx-auto flex flex-wrap gap-6 text-xs text-text-muted">
      <div>
        <span class="text-text-faint">Messages</span>
        <span class="ml-1 text-white font-medium"><%= @entries.count { |e| e[:kind] == :message } %></span>
      </div>
      <div>
        <span class="text-text-faint">Tool calls</span>
        <span class="ml-1 text-white font-medium"><%= @tool_count %></span>
      </div>
      <div>
        <span class="text-text-faint">Input tokens</span>
        <span class="ml-1 text-white font-medium"><%= number_with_delimiter(@total_input_tokens) %></span>
      </div>
      <div>
        <span class="text-text-faint">Output tokens</span>
        <span class="ml-1 text-white font-medium"><%= number_with_delimiter(@total_output_tokens) %></span>
      </div>
      <div>
        <span class="text-text-faint">Total cost</span>
        <span class="ml-1 text-green-400 font-medium">$<%= format("%.4f", @total_cost_cents.to_f / 100) %></span>
      </div>
    </div>
  </div>
</div>
