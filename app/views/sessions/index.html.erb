<div class="max-w-6xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white">Chat Sessions</h1>
      <p class="text-text-muted mt-1">Talk to your agents</p>
    </div>
  </div>

  <!-- Agent cards with resume + start new buttons -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <% Agent.enabled.order(:name).each do |agent| %>
      <% most_recent_session = Session.where(agent: agent).active_sessions.order(last_activity_at: :desc).first %>
      
      <div class="bg-surface-card rounded-xl border border-border-default p-6 hover:border-brand/50 transition">
        <!-- Agent Header -->
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 bg-brand rounded-lg flex items-center justify-center text-white font-bold text-sm">
            <%= agent.name[0].upcase %>
          </div>
          <div class="flex-1">
            <h3 class="text-white font-semibold"><%= agent.name %></h3>
            <p class="text-text-muted text-xs"><%= agent.role %> · <%= agent.llm_model %></p>
          </div>
        </div>

        <!-- Agent Description -->
        <p class="text-text-muted text-sm mb-4 line-clamp-2"><%= agent.system_prompt&.truncate(100) %></p>

        <!-- Last Activity (if has sessions) -->
        <% if most_recent_session %>
          <div class="bg-surface-raised rounded-lg p-3 mb-4 border border-border-default/50">
            <p class="text-text-muted text-xs">Last message:</p>
            <p class="text-text-primary text-xs mt-1 line-clamp-2">
              <% last_msg = most_recent_session.transcript&.last %>
              <% if last_msg %>
                <span class="text-text-faint"><%= last_msg["role"] %>:</span>
                <%= last_msg["content"]&.truncate(80) %>
              <% end %>
            </p>
            <p class="text-text-faint text-xs mt-2">
              <%= time_ago_in_words(most_recent_session.last_activity_at || most_recent_session.created_at) %> ago
            </p>
          </div>
        <% end %>

        <!-- Action Buttons -->
        <div class="flex gap-2">
          <% if most_recent_session %>
            <!-- Resume Button (primary) -->
            <%= link_to "Resume", session_path(most_recent_session),
                class: "flex-1 px-3 py-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium rounded-lg transition text-center" %>
            
            <!-- Start New Button (secondary) -->
            <%= button_to "New", sessions_path(agent_id: agent.slug), method: :post,
                class: "flex-1 px-3 py-2 bg-surface-raised hover:bg-surface-overlay text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
          <% else %>
            <!-- Start New (full width when no sessions) -->
            <%= button_to "Start Chat", sessions_path(agent_id: agent.slug), method: :post,
                class: "w-full px-3 py-2 bg-brand hover:bg-brand-dark text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Recent conversations list (if sessions exist) -->
  <% active_sessions = Session.where(status: :active).order(last_activity_at: :desc).limit(50) %>
  <% if active_sessions.any? %>
    <div class="bg-surface-card rounded-xl border border-border-default p-6">
      <h2 class="text-lg font-semibold text-white mb-4">Recent conversations</h2>
      <div class="space-y-3">
        <% active_sessions.each do |session| %>
          <%= link_to session_path(session), class: "block bg-surface-raised border border-border-default rounded-lg p-4 hover:border-brand transition group" do %>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <div class="w-8 h-8 bg-brand rounded-lg flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                  <%= session.agent.name[0].upcase %>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-white font-medium"><%= session.agent.name %></h3>
                    <% if session.metadata&.dig("channel") %>
                      <span class="inline-flex items-center gap-1 px-2 py-1 bg-surface-overlay/50 rounded text-xs text-text-muted flex-shrink-0">
                        <% case session.metadata["channel"].to_s.downcase %>
                          <% when "whatsapp" %>
                            <span class="text-green-400">💬</span>WhatsApp
                          <% when "slack" %>
                            <span class="text-blue-400">#</span>Slack
                          <% when "telegram" %>
                            <span class="text-cyan-400">✈️</span>Telegram
                          <% when "discord" %>
                            <span class="text-purple-400">🎮</span>Discord
                        <% end %>
                      </span>
                    <% end %>
                  </div>
                  <p class="text-text-muted text-xs mt-1">
                    <%= session.transcript_size %> messages · <%= time_ago_in_words(session.last_activity_at || session.created_at) %> ago
                  </p>
                </div>
              </div>
              <div class="text-text-faint text-xs flex-shrink-0">
                <%= session.agent.llm_model %>
              </div>
            </div>
            <% last_msg = session.transcript&.last %>
            <% if last_msg %>
              <p class="text-text-muted text-sm mt-2 truncate">
                <span class="text-text-faint"><%= last_msg["role"] %>:</span>
                <%= last_msg["content"]&.truncate(120) %>
              </p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
