<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white">Chat Sessions</h1>
      <p class="text-gray-400 mt-1">Talk to your agents</p>
    </div>
  </div>

  <!-- Start new chat -->
  <div class="bg-gray-800 rounded-xl border border-gray-700 p-6 mb-8">
    <h2 class="text-lg font-semibold text-white mb-4">Start a new conversation</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% Agent.enabled.order(:name).each do |agent| %>
        <div class="bg-gray-750 border border-gray-600 rounded-lg p-4 hover:border-blue-500 transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold">
              <%= agent.name[0].upcase %>
            </div>
            <div>
              <h3 class="text-white font-medium"><%= agent.name %></h3>
              <p class="text-gray-400 text-xs"><%= agent.role %> · <%= agent.llm_model %></p>
            </div>
          </div>
          <p class="text-gray-400 text-sm mb-3 line-clamp-2"><%= agent.system_prompt&.truncate(100) %></p>
          <%= button_to "Chat →", sessions_path(agent_id: agent.id), method: :post,
              class: "w-full py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Active sessions -->
  <% if @sessions.any? %>
    <div class="bg-gray-800 rounded-xl border border-gray-700 p-6">
      <h2 class="text-lg font-semibold text-white mb-4">Recent conversations</h2>
      <div class="space-y-3">
        <% @sessions.each do |session| %>
          <%= link_to session_path(session), class: "block bg-gray-750 border border-gray-600 rounded-lg p-4 hover:border-blue-500 transition" do %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                  <%= session.agent.name[0].upcase %>
                </div>
                <div>
                  <h3 class="text-white font-medium"><%= session.agent.name %></h3>
                  <p class="text-gray-400 text-xs">
                    <%= session.transcript_size %> messages ·
                    <%= time_ago_in_words(session.last_activity_at || session.created_at) %> ago
                  </p>
                </div>
              </div>
              <div class="text-gray-500 text-sm">
                <%= session.agent.llm_model %>
              </div>
            </div>
            <% last_msg = session.transcript&.last %>
            <% if last_msg %>
              <p class="text-gray-400 text-sm mt-2 truncate">
                <span class="text-gray-500"><%= last_msg["role"] %>:</span>
                <%= last_msg["content"]&.truncate(120) %>
              </p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
