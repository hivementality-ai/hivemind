<div class="max-w-7xl mx-auto px-6 py-8">
  <!-- Page Header -->
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Chat</h1>
      <p class="text-text-muted text-sm mt-0.5">Talk to your agents</p>
    </div>
  </div>

  <!-- Compact Agent Cards -->
  <div class="mb-8">
    <h2 class="text-xs font-semibold text-text-faint uppercase tracking-wider mb-3">Agents</h2>
    <div class="flex flex-wrap gap-3">
      <% @recent_agent_sessions.each do |entry| %>
        <% agent = entry[:agent] %>
        <% recent = entry[:session] %>
        <div class="bg-surface-card border border-border-default rounded-xl p-4 hover:border-brand/50 transition flex items-center gap-3 min-w-[220px] flex-1 max-w-xs">
          <%= agent_avatar(agent, size: :sm) %>
          <div class="flex-1 min-w-0">
            <div class="text-white font-medium text-sm truncate"><%= agent.name %></div>
            <div class="text-text-faint text-xs truncate"><%= agent.role %></div>
            <% if recent %>
              <div class="text-text-faint text-xs mt-0.5">
                <%= time_ago_in_words(recent.last_activity_at || recent.created_at) %> ago
              </div>
            <% end %>
          </div>
          <div class="flex flex-col gap-1.5 flex-shrink-0">
            <% if recent %>
              <%= link_to "Resume", session_path(recent),
                  class: "px-3 py-1 bg-brand hover:bg-brand-dark text-white text-xs font-medium rounded-lg transition text-center" %>
              <%= button_to "New", sessions_path(agent_id: agent.slug), method: :post,
                  class: "px-3 py-1 bg-surface-raised hover:bg-surface-overlay text-text-primary text-xs font-medium rounded-lg transition cursor-pointer" %>
            <% else %>
              <%= button_to "Chat", sessions_path(agent_id: agent.slug), method: :post,
                  class: "px-3 py-1.5 bg-brand hover:bg-brand-dark text-white text-xs font-medium rounded-lg transition cursor-pointer" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Session List with Filters -->
  <div>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs font-semibold text-text-faint uppercase tracking-wider">All Sessions</h2>
      <div class="flex items-center gap-2 text-sm">
        <!-- Agent Filter -->
        <%= form_with url: sessions_path, method: :get, data: { turbo: false }, class: "flex items-center gap-2" do |f| %>
          <%= f.select :filter_agent,
              options_for_select([["All agents", ""]] + @agents.map { |a| [a.name, a.id] }, params[:filter_agent]),
              {},
              class: "bg-surface-card border border-border-default text-text-primary text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand cursor-pointer",
              onchange: "this.form.submit()" %>

          <!-- Type Filter -->
          <%= f.select :filter_type,
              options_for_select([
                ["All types", ""],
                ["Direct chats", "direct"],
                ["Delegated / subtasked", "delegated"]
              ], params[:filter_type]),
              {},
              class: "bg-surface-card border border-border-default text-text-primary text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand cursor-pointer",
              onchange: "this.form.submit()" %>

          <% if params[:filter_agent].present? || params[:filter_type].present? %>
            <%= link_to "Clear", sessions_path, class: "text-xs text-text-faint hover:text-white transition" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @sessions.any? %>
      <div class="space-y-1">
        <% @sessions.each do |session| %>
          <%= link_to session_path(session), class: "flex items-center gap-3 px-4 py-3 bg-surface-card border border-border-default rounded-xl hover:border-brand/50 transition group" do %>
            <!-- Agent avatar -->
            <%= agent_avatar(session.agent, size: :xs) %>

            <!-- Title + preview -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-white text-sm font-medium truncate">
                  <% if session.title.present? && session.title != "New Chat" %>
                    <%= session.title %>
                  <% else %>
                    <%= session.agent.name %>
                  <% end %>
                </span>
                <% if session.team_chat_session_id.present? %>
                  <span class="flex-shrink-0 text-xs px-1.5 py-0.5 rounded bg-purple-900/40 border border-purple-700/40 text-purple-300">delegated</span>
                <% end %>
                <% if session.origin_channel_type.present? %>
                  <% case session.origin_channel_type %>
                  <% when "whatsapp" %>
                    <span class="flex-shrink-0 text-xs px-1.5 py-0.5 rounded bg-green-900/40 border border-green-700/40 text-green-300">WhatsApp</span>
                  <% when "telegram" %>
                    <span class="flex-shrink-0 text-xs px-1.5 py-0.5 rounded bg-cyan-900/40 border border-cyan-700/40 text-cyan-300">Telegram</span>
                  <% when "discord" %>
                    <span class="flex-shrink-0 text-xs px-1.5 py-0.5 rounded bg-purple-900/40 border border-purple-700/40 text-purple-300">Discord</span>
                  <% end %>
                <% end %>
              </div>
              <% last_msg = session.transcript&.last %>
              <% if last_msg %>
                <p class="text-text-muted text-xs truncate mt-0.5">
                  <%= last_msg["content"]&.truncate(100) %>
                </p>
              <% end %>
            </div>

            <!-- Agent name + time -->
            <div class="flex-shrink-0 text-right">
              <div class="text-text-faint text-xs"><%= session.agent.name %></div>
              <div class="text-text-faint text-xs mt-0.5">
                <%= time_ago_in_words(session.last_activity_at || session.created_at) %> ago
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-surface-card border border-border-default rounded-xl px-6 py-12 text-center">
        <p class="text-text-muted text-sm">No sessions found<%= params[:filter_agent].present? || params[:filter_type].present? ? " matching these filters" : "" %>.</p>
        <% if params[:filter_agent].present? || params[:filter_type].present? %>
          <%= link_to "Clear filters", sessions_path, class: "text-brand text-sm hover:underline mt-2 inline-block" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
