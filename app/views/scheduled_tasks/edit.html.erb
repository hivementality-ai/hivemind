<div class="max-w-2xl mx-auto px-6 py-8">
  <%= link_to "← Scheduled Tasks", scheduled_tasks_path, class: "text-brand-light hover:text-brand-light text-sm" %>

  <h1 class="text-2xl font-bold text-white mt-4 mb-8">Edit Scheduled Task</h1>

  <%= form_with model: @task, class: "space-y-6" do |f| %>
    <% if @task.errors.any? %>
      <div class="bg-red-900/30 border border-red-600 rounded-lg p-4">
        <% @task.errors.full_messages.each do |msg| %>
          <p class="text-red-300 text-sm"><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.text_field :name,
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white placeholder-text-faint focus:outline-none focus:ring-2 focus:ring-brand" %>
    </div>

    <div>
      <%= f.label :agent_id, "Agent", class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.select :agent_id,
          options_from_collection_for_select(@agents, :id, :name, @task.agent_id),
          {},
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-brand" %>
      <p class="text-text-faint text-xs mt-1">Which agent runs this task when it fires</p>
    </div>

    <div>
      <%= f.label :schedule, "Cron Schedule", class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.text_field :schedule,
          placeholder: "0 14 1 * *",
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white placeholder-text-faint focus:outline-none focus:ring-2 focus:ring-brand font-mono" %>
      <p class="text-text-faint text-xs mt-1">
        Standard cron format: minute hour day month weekday.
        <% if @task.respond_to?(:human_readable_schedule) && @task.human_readable_schedule.present? %>
          Currently: <strong class="text-text-muted"><%= @task.human_readable_schedule %></strong>
        <% end %>
      </p>
    </div>

    <div>
      <label class="block text-text-primary text-sm font-medium mb-1">Prompt</label>
      <%= text_area_tag "scheduled_task[prompt]",
          @task.job_params&.dig("prompt"),
          rows: 4,
          placeholder: "What should the agent do when this fires?",
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white placeholder-text-faint focus:outline-none focus:ring-2 focus:ring-brand text-sm" %>
    </div>

    <div>
      <%= f.label :precheck_url, "Only run when this page or feed changes", class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.url_field :precheck_url,
          placeholder: "https://example.com/feed.xml (optional)",
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white placeholder-text-faint focus:outline-none focus:ring-2 focus:ring-brand" %>
      <p class="text-text-faint text-xs mt-1">Checked without the model. If nothing is new, the run is skipped and costs nothing.</p>
    </div>

    <% hour_options = (0..23).map { |h| [ Time.zone.local(2000, 1, 1, h).strftime("%-l:00 %p"), h ] } %>
    <% select_class = "px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-brand" %>

    <div>
      <span class="block text-text-primary text-sm font-medium mb-1">Don't disturb me between</span>
      <div class="flex items-center gap-3">
        <%= f.select :quiet_start_hour, hour_options, { include_blank: "Anytime" }, class: select_class, "aria-label": "Quiet hours start" %>
        <span class="text-text-muted text-sm">and</span>
        <%= f.select :quiet_end_hour, hour_options, { include_blank: "Anytime" }, class: select_class, "aria-label": "Quiet hours end" %>
      </div>
      <p class="text-text-faint text-xs mt-1">New things found in that window are held and sent once when it ends (<%= Time.zone.name %> time).</p>
    </div>

    <div>
      <%= f.label :digest_hour, "Bundle into one morning summary at", class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.select :digest_hour, hour_options, { include_blank: "Off, send as they come" }, class: select_class %>
      <p class="text-text-faint text-xs mt-1">Everything new is gathered through the day and sent together at this time.</p>
    </div>

    <div>
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :allow_sending, class: "w-4 h-4 rounded border-gray-500 text-brand focus:ring-brand bg-surface-overlay" %>
        <span class="text-text-primary text-sm font-medium">Let it send without asking me</span>
      </label>
      <p class="text-text-faint text-xs mt-1">Off: when this task wants to send an email, post a message, delete a file or change something on another service, it is held for your approval and the run finishes with a note that something is waiting. On: it goes ahead on its own.</p>
    </div>

    <div>
      <%= f.label :description, class: "block text-text-primary text-sm font-medium mb-1" %>
      <%= f.text_field :description,
          placeholder: "Optional description",
          class: "w-full px-4 py-3 bg-surface-card border border-border-default rounded-lg text-white placeholder-text-faint focus:outline-none focus:ring-2 focus:ring-brand" %>
    </div>

    <div class="bg-surface-base rounded-lg border border-border-default p-4">
      <div class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-text-faint">Type:</span>
          <span class="text-text-muted"><%= @task.job_class == "ScheduledScriptJob" ? "Script" : "Prompt" %></span>
        </div>
        <div>
          <span class="text-text-faint">Status:</span>
          <span class="text-text-muted"><%= @task.confirmation_status %></span>
        </div>
        <div>
          <span class="text-text-faint">Last run:</span>
          <span class="text-text-muted"><%= @task.last_run_at ? time_ago_in_words(@task.last_run_at) + " ago" : "Never" %></span>
        </div>
        <div>
          <span class="text-text-faint">Created:</span>
          <span class="text-text-muted"><%= time_ago_in_words(@task.created_at) %> ago</span>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-4">
      <%= link_to "Cancel", scheduled_tasks_path, class: "px-6 py-3 bg-surface-raised hover:bg-surface-overlay text-white rounded-lg transition" %>
      <%= f.submit "Update Task",
          class: "px-6 py-3 bg-brand hover:bg-brand-dark text-white font-medium rounded-lg transition cursor-pointer" %>
    </div>
  <% end %>
</div>
