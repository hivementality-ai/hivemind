<div class="max-w-3xl mx-auto px-6 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to tasks_path, class: "text-text-muted hover:text-white transition" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <h1 class="text-2xl font-bold text-white"><%= @task.title %></h1>
    <span class="ml-auto text-text-faint text-sm">#<%= @task.id %></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Description -->
      <div class="bg-surface-card rounded-xl border border-border-default p-6">
        <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">Description</h2>
        <% if @task.description.present? %>
          <p class="text-text-primary whitespace-pre-wrap"><%= @task.description %></p>
        <% else %>
          <p class="text-text-faint italic">No description.</p>
        <% end %>
      </div>

      <!-- Checklist -->
      <% if @task.checklist.present? %>
        <div class="bg-surface-card rounded-xl border border-border-default p-6">
          <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">
            Checklist (<%= @task.checklist.count { |i| i["checked"] } %>/<%= @task.checklist.size %>)
          </h2>
          <div class="space-y-2">
            <% @task.checklist.each_with_index do |item, idx| %>
              <div class="flex items-center gap-3">
                <%= button_to toggle_checklist_task_path(@task, index: idx), method: :patch,
                      class: "flex items-center gap-3 w-full text-left hover:bg-surface-raised rounded-lg px-2 py-1.5 transition" do %>
                  <div class="w-5 h-5 rounded border-2 flex items-center justify-center flex-shrink-0 <%= item['checked'] ? 'bg-brand border-brand' : 'border-border-default' %>">
                    <% if item["checked"] %>
                      <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                      </svg>
                    <% end %>
                  </div>
                  <span class="text-sm <%= item['checked'] ? 'text-text-faint line-through' : 'text-text-primary' %>">
                    <%= item["title"] %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Artifacts -->
      <div class="bg-surface-card rounded-xl border border-border-default p-6">
        <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">
          Artifacts (<%= @task.artifacts.size %>)
        </h2>

        <% if @task.artifacts.any? %>
          <div class="space-y-2 mb-4">
            <% @task.artifacts.each do |artifact| %>
              <div class="flex items-center gap-3 px-4 py-2.5 bg-surface-raised rounded-lg border border-border-default">
                <%
                  icon_color = case artifact["type"]
                    when "pr"       then "text-green-400"
                    when "branch"   then "text-orange-400"
                    when "commit"   then "text-yellow-400"
                    when "file"     then "text-blue-400"
                    when "url"      then "text-cyan-400"
                    when "document" then "text-purple-400"
                    else                 "text-text-muted"
                  end
                %>
                <svg class="w-4 h-4 flex-shrink-0 <%= icon_color %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <% case artifact["type"] %>
                  <% when "pr" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4" />
                  <% when "branch" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                  <% when "commit" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  <% when "file" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  <% when "url" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  <% when "document" %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  <% else %>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  <% end %>
                </svg>
                <div class="flex-1 min-w-0">
                  <% if artifact["url"].present? %>
                    <%= link_to artifact["title"], artifact["url"], target: "_blank", rel: "noopener", class: "text-sm font-medium text-accent-primary hover:underline" %>
                  <% else %>
                    <span class="text-sm font-medium text-white"><%= artifact["title"] %></span>
                  <% end %>
                  <span class="text-xs text-text-faint ml-2"><%= artifact["type"] %></span>
                  <% if artifact["description"].present? %>
                    <span class="text-xs text-text-muted ml-2">— <%= artifact["description"].truncate(80) %></span>
                  <% end %>
                </div>
                <% if artifact["created_by"] %>
                  <span class="text-xs text-text-faint"><%= artifact["created_by"] %></span>
                <% end %>
                <% if artifact["created_at"] %>
                  <span class="text-xs text-text-faint"><%= Time.zone.parse(artifact["created_at"])&.strftime("%b %-d, %H:%M") rescue artifact["created_at"] %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-text-faint text-sm">No artifacts yet. Agents attach references (PRs, branches, docs) as they work.</p>
        <% end %>
      </div>

      <!-- Attachments -->
      <div class="bg-surface-card rounded-xl border border-border-default p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider">
            Attachments (<%= @task.task_attachments.size %>)
          </h2>
        </div>

        <% attachments = @task.task_attachments.recent %>
        <% if attachments.any? %>
          <div class="space-y-2 mb-5">
            <% attachments.each do |attachment| %>
              <div class="flex items-center gap-3 px-4 py-2.5 bg-surface-raised rounded-lg border border-border-default group">
                <%
                  icon_color = case attachment.kind
                    when "image"       then "text-pink-400"
                    when "pdf"         then "text-red-400"
                    when "spreadsheet" then "text-green-400"
                    when "document"    then "text-blue-400"
                    else                    "text-cyan-400"
                  end
                %>
                <svg class="w-4 h-4 flex-shrink-0 <%= icon_color %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                </svg>
                <div class="flex-1 min-w-0">
                  <%= link_to attachment.url, target: "_blank", rel: "noopener",
                        class: "text-sm font-medium text-accent-primary hover:underline truncate block" do %>
                    <%= attachment.title %>
                  <% end %>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-xs text-text-faint"><%= attachment.kind %></span>
                    <% if attachment.uploaded_by.present? %>
                      <span class="text-xs text-text-faint">&middot; <%= attachment.uploaded_by %></span>
                    <% end %>
                    <span class="text-xs text-text-faint">&middot; <%= attachment.created_at.strftime("%b %-d, %H:%M") %></span>
                  </div>
                </div>
                <%= button_to task_attachment_path(attachment), method: :delete,
                      data: { turbo_confirm: "Remove this attachment?" },
                      class: "opacity-0 group-hover:opacity-100 p-1 text-text-faint hover:text-red-400 rounded transition" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-text-faint text-sm mb-4">No attachments yet.</p>
        <% end %>

        <!-- Add attachment form -->
        <%= form_with url: task_task_attachments_path(@task), scope: :task_attachment, method: :post, local: true, class: "space-y-3" do |f| %>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Title</label>
              <%= f.text_field :title,
                    placeholder: "Design mockup, spec doc…",
                    class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-white placeholder-text-faint text-sm focus:outline-none focus:border-brand/50" %>
            </div>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">URL</label>
              <%= f.url_field :url,
                    placeholder: "https://…",
                    class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-white placeholder-text-faint text-sm focus:outline-none focus:border-brand/50" %>
            </div>
          </div>
          <%= f.submit "Attach", class: "px-4 py-2 bg-surface-raised hover:bg-surface-card border border-border-default text-text-primary text-sm font-medium rounded-lg transition cursor-pointer" %>
        <% end %>
      </div>

      <!-- Dependencies -->
      <% if @task.blocking_tasks.any? || @task.dependent_tasks.any? %>
        <div class="bg-surface-card rounded-xl border border-border-default p-6">
          <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">Dependencies</h2>
          <% if @task.blocking_tasks.any? %>
            <p class="text-xs text-text-faint mb-2">Blocked by:</p>
            <div class="space-y-1.5 mb-4">
              <% @task.blocking_tasks.each do |blocker| %>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full flex-shrink-0 <%= blocker.status == 'done' ? 'bg-green-500' : 'bg-yellow-500' %>"></span>
                  <%= link_to task_path(blocker), class: "text-sm text-text-primary hover:text-brand" do %>
                    #<%= blocker.id %> <%= blocker.title %> (<%= blocker.status %>)
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
          <% if @task.dependent_tasks.any? %>
            <p class="text-xs text-text-faint mb-2">Blocking:</p>
            <div class="space-y-1.5">
              <% @task.dependent_tasks.each do |dep| %>
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full flex-shrink-0 bg-orange-500"></span>
                  <%= link_to task_path(dep), class: "text-sm text-text-primary hover:text-brand" do %>
                    #<%= dep.id %> <%= dep.title %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Hooks -->
      <% hooks = @task.task_hooks.includes(:skill).ordered %>
      <% template_hooks = @task.task_template&.task_hooks&.includes(:skill)&.ordered || [] %>
      <% if hooks.any? || template_hooks.any? %>
        <div class="bg-surface-card rounded-xl border border-border-default p-6">
          <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-3">Hooks</h2>
          <div class="space-y-2">
            <% hooks.each do |hook| %>
              <div class="flex items-center gap-3 text-sm">
                <span class="px-2 py-0.5 rounded text-xs font-semibold uppercase <%= hook.trigger == 'pre' ? 'bg-blue-900/40 text-blue-300' : 'bg-purple-900/40 text-purple-300' %>">
                  <%= hook.trigger %>
                </span>
                <span class="text-text-muted">on</span>
                <span class="text-white font-medium"><%= hook.on_status %></span>
                <span class="text-text-faint">&rarr;</span>
                <% if hook.skill %>
                  <span class="text-brand"><%= hook.skill.name %></span>
                <% else %>
                  <span class="text-text-muted italic">Default behavior</span>
                <% end %>
                <% unless hook.enabled? %>
                  <span class="text-xs text-text-faint">(disabled)</span>
                <% end %>
              </div>
            <% end %>
            <% template_hooks.each do |hook| %>
              <div class="flex items-center gap-3 text-sm opacity-60">
                <span class="px-2 py-0.5 rounded text-xs font-semibold uppercase <%= hook.trigger == 'pre' ? 'bg-blue-900/40 text-blue-300' : 'bg-purple-900/40 text-purple-300' %>">
                  <%= hook.trigger %>
                </span>
                <span class="text-text-muted">on</span>
                <span class="text-white font-medium"><%= hook.on_status %></span>
                <span class="text-text-faint">&rarr;</span>
                <% if hook.skill %>
                  <span class="text-brand"><%= hook.skill.name %></span>
                <% else %>
                  <span class="text-text-muted italic">Default behavior</span>
                <% end %>
                <span class="text-xs text-text-faint">(from template)</span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Comments -->
      <div class="bg-surface-card rounded-xl border border-border-default p-6">
        <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">
          Comments (<%= @task.comments.size %>)
        </h2>

        <% if @task.comments.any? %>
          <div class="space-y-4 mb-6">
            <% @task.comments.each do |comment| %>
              <div class="flex gap-3">
                <div class="w-7 h-7 rounded-full bg-brand/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <span class="text-xs font-bold text-brand"><%= comment["author"][0]&.upcase %></span>
                </div>
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class="text-sm font-medium text-white"><%= comment["author"] %></span>
                    <span class="text-xs text-text-faint"><%= Time.zone.parse(comment["created_at"])&.strftime("%b %-d, %H:%M") rescue comment["created_at"] %></span>
                  </div>
                  <p class="text-text-primary text-sm whitespace-pre-wrap"><%= comment["body"] %></p>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>

        <!-- Add comment form -->
        <%= form_with url: task_path(@task), method: :patch, local: true do |f| %>
          <div class="space-y-3">
            <%= f.hidden_field :status, value: @task.status %>
            <div>
              <label class="block text-xs font-medium text-text-muted mb-1">Add a comment</label>
              <%= f.text_area :_comment_body, rows: 3,
                    placeholder: "Write a comment...",
                    class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm placeholder-text-faint focus:outline-none focus:border-brand/50 resize-none" %>
            </div>
            <%= f.submit "Add Comment", class: "px-4 py-2 bg-brand hover:bg-brand/80 text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <!-- Activity Log -->
      <% if @events.any? %>
        <div class="bg-surface-card rounded-xl border border-border-default p-6">
          <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">
            Activity
            <span class="text-text-faint font-normal normal-case tracking-normal ml-1">(<%= @events.size %> events)</span>
          </h2>
          <div class="space-y-3">
            <% @events.each do |event| %>
              <div class="flex items-start gap-3">
                <%# Event type indicator dot with color coding %>
                <% dot_color = case event.event_type
                     when "status_change", "transition_requested" then "bg-blue-400"
                     when "created" then "bg-green-400"
                     when "assigned", "auto_assigned" then "bg-purple-400"
                     when "comment_added" then "bg-yellow-400"
                     when "dependency_added", "dependency_removed" then "bg-orange-400"
                     when "hook_fired", "hook_added", "hook_removed" then "bg-cyan-400"
                     when "artifact_added", "artifact_removed" then "bg-indigo-400"
                     when "checklist_updated" then "bg-teal-400"
                     when "updated" then "bg-slate-400"
                     when "pipeline_failed" then "bg-red-400"
                     when "archived" then "bg-gray-500"
                     else "bg-text-faint"
                   end %>
                <div class="w-2 h-2 rounded-full <%= dot_color %> mt-1.5 flex-shrink-0"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-text-primary"><%= event.summary %></p>
                  <p class="text-xs text-text-faint mt-0.5">
                    <%= event.created_at.strftime("%b %-d, %Y %H:%M") %>
                    <% if event.agent %>
                      &middot; <span class="text-text-muted"><%= event.agent.name %></span>
                    <% end %>
                    &middot; <span class="text-text-faint"><%= event.event_type.humanize %></span>
                  </p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-4">
      <!-- Status & Priority -->
      <div class="bg-surface-card rounded-xl border border-border-default p-4">
        <h2 class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-3">Details</h2>
        <dl class="space-y-3">
          <div>
            <dt class="text-xs text-text-faint mb-1">Status</dt>
            <dd>
              <span class="text-sm font-medium text-white"><%= @task.status.humanize %></span>
              <% if @task.blocked_by_dependencies? %>
                <span class="text-xs text-yellow-400 ml-1">(blocked)</span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-xs text-text-faint mb-1">Priority</dt>
            <dd>
              <%
                badge = case @task.priority
                  when "urgent" then "bg-red-900/40 text-red-300"
                  when "high"   then "bg-orange-900/40 text-orange-300"
                  when "medium" then "bg-yellow-900/40 text-yellow-300"
                  else               "bg-slate-700/40 text-slate-400"
                end
              %>
              <span class="text-xs font-semibold uppercase px-2 py-0.5 rounded <%= badge %>">
                <%= @task.priority %>
              </span>
            </dd>
          </div>
          <% if @task.assigned_to_agent %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Assigned to</dt>
              <dd class="text-sm text-white"><%= @task.assigned_to_agent.name %></dd>
            </div>
          <% end %>
          <% if @task.created_by_agent %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Created by</dt>
              <dd class="text-sm text-white"><%= @task.created_by_agent.name %></dd>
            </div>
          <% end %>
          <% if @task.task_template %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Template</dt>
              <dd class="text-sm text-brand">
                <%= link_to @task.task_template.name, task_template_path(@task.task_template), class: "hover:underline" %>
              </dd>
            </div>
          <% end %>
          <% if @task.project %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Project</dt>
              <dd class="text-sm text-brand">
                <%= link_to @task.project.title, project_path(@task.project), class: "hover:underline" %>
              </dd>
            </div>
          <% end %>
          <% if @task.project_milestone %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Milestone</dt>
              <dd class="text-sm text-brand">
                <%= link_to @task.project_milestone.title,
                      project_milestone_path(@task.project_milestone.project, @task.project_milestone),
                      class: "hover:underline" %>
              </dd>
            </div>
          <% end %>
          <% if @task.session %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Session</dt>
              <dd class="text-sm text-brand">
                <%= link_to @task.session.title.truncate(40), session_path(@task.session), class: "hover:underline" %>
              </dd>
            </div>
          <% end %>
          <% if @task.due_at %>
            <div>
              <dt class="text-xs text-text-faint mb-1">Due</dt>
              <dd class="text-sm <%= @task.overdue? ? 'text-red-400' : 'text-white' %>">
                <%= @task.due_at.strftime("%b %-d, %Y") %>
                <%= " (overdue)" if @task.overdue? %>
              </dd>
            </div>
          <% end %>
          <div>
            <dt class="text-xs text-text-faint mb-1">Created</dt>
            <dd class="text-sm text-text-muted"><%= @task.created_at.strftime("%b %-d, %Y") %></dd>
          </div>
        </dl>
      </div>

      <!-- Actions -->
      <div class="bg-surface-card rounded-xl border border-border-default p-4 space-y-2">
        <%= link_to edit_task_path(@task), class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-text-primary hover:bg-surface-raised rounded-lg transition" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit task
        <% end %>
        <% if @task.status == "done" && !@task.archived? %>
          <%= button_to archive_task_path(@task), method: :patch,
                data: { turbo_confirm: "Archive this task? It will be hidden from the board." },
                class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-slate-400 hover:bg-surface-raised rounded-lg transition text-left" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
            Archive task
          <% end %>
        <% end %>
        <%= button_to task_path(@task), method: :delete,
              data: { turbo_confirm: "Delete this task?" },
              class: "flex items-center gap-2 w-full px-3 py-2 text-sm text-red-400 hover:bg-red-900/20 rounded-lg transition text-left" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
