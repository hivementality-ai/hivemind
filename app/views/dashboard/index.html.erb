<div class="max-w-7xl mx-auto px-6 py-8">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <%= hivemind_logo(size: "w-9 h-9", css: "text-amber-400") %>
      <div>
        <h1 class="text-2xl font-bold text-white">Mission Control</h1>
      </div>
    </div>
    <div class="flex gap-3">
      <%= link_to "New Agent", new_agent_path, class: "px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition" %>
      <%= link_to "Team Chat", team_chats_index_path, class: "px-4 py-2 bg-surface-raised hover:bg-surface-overlay text-white text-sm font-medium rounded-lg transition" %>
    </div>
  </div>

  <!-- Tabs -->
  <div class="flex gap-1 mb-8 border-b border-border-default">
    <% %w[overview usage health projects].each do |tab| %>
      <%= link_to dashboard_path(tab: tab),
          class: "px-5 py-3 text-sm font-medium transition border-b-2 -mb-px #{@tab == tab ? 'border-amber-500 text-white' : 'border-transparent text-text-muted hover:text-white hover:border-border-default'}" do %>
        <%= tab.capitalize %>
      <% end %>
    <% end %>
  </div>

  <!-- Tab Content -->
  <%= render "dashboard/#{@tab}" %>
</div>
