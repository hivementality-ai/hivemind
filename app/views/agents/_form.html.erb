<%= form_with(model: agent, class: "space-y-4") do |form| %>
  <% if agent.errors.any? %>
    <div class="bg-red-900 text-red-200 p-4 rounded">
      <ul>
        <% agent.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-300" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded bg-gray-800 border-gray-700 text-white" %>
  </div>

  <div>
    <%= form.label :role, class: "block text-sm font-medium text-gray-300" %>
    <%= form.text_field :role, class: "mt-1 block w-full rounded bg-gray-800 border-gray-700 text-white" %>
  </div>

  <div>
    <%= form.submit class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded cursor-pointer" %>
  </div>
<% end %>
