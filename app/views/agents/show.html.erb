<div class="min-h-screen bg-gray-900 text-white">
  <!-- Header -->
  <div class="bg-gray-800 border-b border-gray-700 px-6 py-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <%= link_to "← Back", dashboard_path, class: "text-gray-400 hover:text-white transition" %>
        <h1 class="text-3xl font-bold"><%= @agent.name %></h1>
        <% status = @agent.status || "idle" %>
        <span class="px-3 py-1 rounded-full text-sm font-medium <%= status == "active" ? "bg-green-900 text-green-300" : status == "thinking" ? "bg-yellow-900 text-yellow-300" : "bg-gray-700 text-gray-300" %>">
          <%= status.titleize %>
        </span>
      </div>
      <div class="flex gap-4">
        <%= link_to "Edit", edit_agent_path(@agent), class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg transition" %>
        <%= link_to "Delete", agent_path(@agent), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "px-4 py-2 bg-red-600 hover:bg-red-700 rounded-lg transition" %>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-6 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Agent Info & Stats -->
      <div class="space-y-6">
        <!-- Agent Details -->
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h2 class="text-xl font-semibold mb-4">Agent Details</h2>
          <dl class="space-y-3">
            <div>
              <dt class="text-sm text-gray-400">Role</dt>
              <dd class="text-lg font-medium"><%= @agent.role&.titleize || "No role assigned" %></dd>
            </div>
            <% if @agent.team %>
              <div>
                <dt class="text-sm text-gray-400">Team</dt>
                <dd class="text-lg font-medium"><%= @agent.team.name %></dd>
              </div>
            <% end %>
            <div>
              <dt class="text-sm text-gray-400">Model</dt>
              <dd class="text-lg font-medium"><%= @agent.model_provider %>/<%= @agent.model_name %></dd>
            </div>
            <div>
              <dt class="text-sm text-gray-400">Status</dt>
              <dd class="text-lg font-medium"><%= @agent.enabled? ? "Enabled" : "Disabled" %></dd>
            </div>
          </dl>
        </div>

        <!-- Budget Usage -->
        <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
          <h2 class="text-xl font-semibold mb-4">💰 Today's Usage</h2>
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-sm mb-2">
                <span class="text-gray-400">Cost</span>
                <span class="font-medium text-green-400">$<%= sprintf("%.4f", @usage_today[:total_cost]) %></span>
              </div>
              <% budget = @agent.daily_budget_limit || 0 %>
              <% usage_percent = budget.positive? ? (@usage_today[:total_cost] / budget * 100) : 0 %>
              <div class="bg-gray-700 rounded-full h-3">
                <div class="bg-blue-500 h-3 rounded-full" style="width: <%= [usage_percent, 100].min %>%"></div>
              </div>
              <div class="text-xs text-gray-400 mt-1">
                <%= usage_percent.round(1) %>% of $<%= sprintf("%.2f", budget) %> limit
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-700">
              <div>
                <div class="text-sm text-gray-400">Tokens</div>
                <div class="text-lg font-medium"><%= number_with_delimiter(@usage_today[:total_tokens]) %></div>
              </div>
              <div>
                <div class="text-sm text-gray-400">Requests</div>
                <div class="text-lg font-medium"><%= @usage_today[:request_count] %></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Pending Approvals -->
        <% if @pending_approvals.any? %>
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h2 class="text-xl font-semibold mb-4">🔀 Pending Approvals</h2>
            <div class="space-y-3">
              <% @pending_approvals.each do |approval| %>
                <div class="bg-gray-700 rounded-lg p-4">
                  <div class="font-medium"><%= approval.action.titleize %></div>
                  <div class="text-sm text-gray-400 mt-1"><%= approval.resource %></div>
                  <div class="text-xs text-gray-500 mt-2">
                    <%= time_ago_in_words(approval.requested_at) %> ago
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Right Column: Live Transcript & Sessions -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Live Transcript -->
        <div class="bg-gray-800 rounded-lg border border-gray-700">
          <div class="px-6 py-4 border-b border-gray-700">
            <h2 class="text-xl font-semibold">💬 Live Transcript</h2>
          </div>
          <turbo-stream-from "agent_<%= @agent.id %>_transcript"></turbo-stream-from>
          <div id="transcript_container" class="p-6 h-96 overflow-y-auto">
            <div class="text-gray-400 text-center py-8">
              Waiting for agent activity...
            </div>
          </div>
        </div>

        <!-- Recent Sessions -->
        <div class="bg-gray-800 rounded-lg border border-gray-700">
          <div class="px-6 py-4 border-b border-gray-700">
            <h2 class="text-xl font-semibold">📋 Recent Sessions</h2>
          </div>
          <div class="p-6">
            <div class="space-y-3">
              <% @recent_sessions.each do |session| %>
                <div class="bg-gray-700 rounded-lg p-4">
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <div class="font-medium font-mono text-sm"><%= session.key %></div>
                      <% if session.metadata["source"] %>
                        <div class="text-xs text-gray-400 mt-1">
                          Source: <%= session.metadata["source"] %>
                        </div>
                      <% end %>
                    </div>
                    <div class="text-xs text-gray-500">
                      <%= time_ago_in_words(session.created_at) %> ago
                    </div>
                  </div>
                </div>
              <% end %>

              <% if @recent_sessions.empty? %>
                <div class="text-gray-400 text-center py-8">
                  No sessions yet
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
