<!DOCTYPE html>
<html class="h-full bg-gray-900">
  <head>
    <title><%= content_for(:title) || "Hivemind 🐝" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hivemind">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full" data-controller="sidebar">
    <% if user_signed_in? %>
      <div class="flex h-full">
        <!-- Mobile Sidebar Overlay -->
        <div class="fixed inset-0 bg-gray-900 bg-opacity-75 z-40 lg:hidden"
             data-sidebar-target="overlay"
             data-action="click->sidebar#close"
             style="display: none;"></div>
        
        <!-- Sidebar -->
        <aside class="fixed inset-y-0 left-0 z-50 w-64 bg-gray-800 border-r border-gray-700 transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out"
               data-sidebar-target="sidebar">
          <div class="flex flex-col h-full">
            <!-- Logo -->
            <div class="flex items-center justify-between px-6 py-6 border-b border-gray-700">
              <%= link_to root_path, class: "flex items-center gap-2" do %>
                <span class="text-2xl">🐝</span>
                <span class="text-xl font-bold text-white">Hivemind</span>
              <% end %>
              
              <!-- Mobile Close Button -->
              <button class="lg:hidden text-gray-400 hover:text-white"
                      data-action="click->sidebar#close">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            
            <!-- Navigation -->
            <nav class="flex-1 px-4 py-6 space-y-1 overflow-y-auto">
              <%= link_to dashboard_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(dashboard_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span>Dashboard</span>
              <% end %>
              
              <%= link_to agents_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(agents_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span>Agents</span>
              <% end %>
              
              <%= link_to agent_templates_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(agent_templates_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>Templates</span>
              <% end %>
              
              <%= link_to analytics_index_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(analytics_index_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                <span>Analytics</span>
              <% end %>
              
              <%= link_to budgets_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(budgets_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Budgets</span>
              <% end %>
              
              <%= link_to platform_status_path, class: "flex items-center gap-3 px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded-lg transition #{current_page?(platform_status_path) ? 'bg-gray-700 text-white' : ''}" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                </svg>
                <span>Platform</span>
              <% end %>
            </nav>
            
            <!-- User Menu -->
            <div class="px-4 py-4 border-t border-gray-700">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center">
                    <span class="text-sm font-bold text-white">
                      <%= current_user.email[0].upcase %>
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-white truncate">
                      <%= current_user.email.split("@").first %>
                    </p>
                  </div>
                </div>
                <%= button_to destroy_user_session_path, method: :delete, 
                    class: "text-gray-400 hover:text-white" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        </aside>
        
        <!-- Main Content -->
        <main class="flex-1 lg:ml-64 min-h-screen">
          <!-- Mobile Header -->
          <header class="lg:hidden sticky top-0 z-30 bg-gray-800 border-b border-gray-700 px-4 py-4">
            <div class="flex items-center justify-between">
              <button class="text-gray-400 hover:text-white"
                      data-action="click->sidebar#open">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
              </button>
              
              <div class="flex items-center gap-2">
                <span class="text-xl">🐝</span>
                <span class="text-lg font-bold text-white">Hivemind</span>
              </div>
              
              <div class="w-6"></div>
            </div>
          </header>
          
          <!-- Flash Messages -->
          <% if notice %>
            <div class="bg-green-900/50 border border-green-600 text-green-200 px-4 py-3 m-4 rounded-lg">
              <%= notice %>
            </div>
          <% end %>
          
          <% if alert %>
            <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 m-4 rounded-lg">
              <%= alert %>
            </div>
          <% end %>
          
          <%= yield %>
        </main>
      </div>
    <% else %>
      <!-- Logged Out View -->
      <div class="min-h-screen bg-gray-900 flex items-center justify-center px-4">
        <div class="max-w-md w-full">
          <%= yield %>
        </div>
      </div>
    <% end %>
  </body>
</html>
