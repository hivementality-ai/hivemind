<% content_for(:title) { "Migration Complete - Hivemind" } %>

<div class="p-6 lg:p-10 max-w-3xl mx-auto">
  <%= render "migration/progress", step: 4 %>

  <%# Success Banner %>
  <div class="bg-green-900/30 border border-green-700 rounded-xl p-6 mb-8">
    <div class="flex items-center gap-3">
      <svg class="w-8 h-8 text-green-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <h1 class="text-2xl font-bold text-white">Migration Complete</h1>
        <p class="text-green-200">Your OpenClaw configuration has been imported into <strong><%= @report[:agent_name] %></strong>.</p>
      </div>
    </div>
  </div>

  <%# Import Summary %>
  <div class="bg-surface-card border border-border-default rounded-xl p-8 mb-8">
    <h2 class="text-lg font-semibold text-white mb-4">Import Summary</h2>
    <div class="bg-surface-base rounded-lg overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border-default">
            <th class="text-left px-4 py-2 text-text-faint font-medium">Artifact</th>
            <th class="text-right px-4 py-2 text-text-faint font-medium">Imported</th>
            <th class="text-right px-4 py-2 text-text-faint font-medium">Skipped</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-border-default">
            <td class="px-4 py-2 text-text-primary">Memories</td>
            <td class="px-4 py-2 text-right text-white"><%= @report[:memories_created] %></td>
            <td class="px-4 py-2 text-right text-text-faint">-</td>
          </tr>
          <tr class="border-b border-border-default">
            <td class="px-4 py-2 text-text-primary">Skills</td>
            <td class="px-4 py-2 text-right text-white"><%= Array(@report[:skills_imported]).size %></td>
            <td class="px-4 py-2 text-right text-text-faint"><%= Array(@report[:skills_skipped]).size %></td>
          </tr>
          <tr class="border-b border-border-default">
            <td class="px-4 py-2 text-text-primary">Channels</td>
            <td class="px-4 py-2 text-right text-white"><%= Array(@report[:channels_created]).size %></td>
            <td class="px-4 py-2 text-right text-text-faint"><%= Array(@report[:channels_skipped]).size %></td>
          </tr>
          <tr class="border-b border-border-default">
            <td class="px-4 py-2 text-text-primary">Sessions</td>
            <td class="px-4 py-2 text-right text-white"><%= @report[:sessions_created] %></td>
            <td class="px-4 py-2 text-right text-text-faint">-</td>
          </tr>
          <tr>
            <td class="px-4 py-2 text-text-primary">Tools</td>
            <td class="px-4 py-2 text-right text-white"><%= Array(@report[:tools_created]).size %></td>
            <td class="px-4 py-2 text-right text-text-faint"><%= Array(@report[:tools_skipped]).size %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <%# Channels Needing Reconnection %>
  <% channels = Array(@report[:channels_created]) %>
  <% if channels.any? %>
    <div class="bg-surface-card border border-border-default rounded-xl p-8 mb-8">
      <h2 class="text-lg font-semibold text-white mb-2">Channels Needing Reconnection</h2>
      <p class="text-text-muted text-sm mb-4">These channels were created disabled. Enter credentials to activate them.</p>

      <div class="space-y-3">
        <% Channel.where(name: channels).find_each do |channel| %>
          <div class="flex items-center justify-between bg-surface-base rounded-lg p-4">
            <div>
              <p class="text-white font-medium"><%= channel.name %></p>
              <p class="text-text-faint text-xs"><%= channel.channel_type %></p>
            </div>
            <%= link_to "Configure", edit_channel_path(channel), class: "text-brand hover:text-brand-light text-sm font-medium transition" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Actions %>
  <div class="flex items-center gap-4">
    <% if @report[:agent_slug] %>
      <%= link_to "Go to Agent", agent_path(@report[:agent_slug]), class: "bg-brand hover:bg-brand-hover text-white font-semibold py-3 px-6 rounded-lg transition" %>
    <% end %>
    <%= link_to "Back to Dashboard", dashboard_path, class: "text-text-muted hover:text-white transition" %>
  </div>
</div>
