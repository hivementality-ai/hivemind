<div class="min-h-screen bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%= link_to "← Back to Analytics", analytics_index_path, class: "text-blue-400 hover:text-blue-300 mb-6 inline-block" %>
    
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold mb-2"><%= @agent.name %> Analytics</h1>
        <p class="text-gray-400"><%= @agent.role %></p>
      </div>
      
      <!-- Period Toggle -->
      <div class="flex gap-2">
        <%= link_to "Day", analytic_path(@agent, period: "day"), 
            class: "px-4 py-2 rounded-lg #{@period == 'day' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
        <%= link_to "Week", analytic_path(@agent, period: "week"), 
            class: "px-4 py-2 rounded-lg #{@period == 'week' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
        <%= link_to "Month", analytic_path(@agent, period: "month"), 
            class: "px-4 py-2 rounded-lg #{@period == 'month' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
      </div>
    </div>
    
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Total Tasks</p>
        <p class="text-3xl font-bold"><%= @analytics.dig(:tasks, :total) || 0 %></p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Total Cost</p>
        <p class="text-3xl font-bold">
          <%= number_to_currency(@analytics.dig(:costs, :total_dollars) || 0) %>
        </p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Success Rate</p>
        <p class="text-3xl font-bold"><%= @analytics[:success_rate] || 0 %>%</p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Avg Response Time</p>
        <p class="text-3xl font-bold"><%= @analytics[:avg_response_time] || 0 %>s</p>
      </div>
    </div>
    
    <!-- Task Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Task Status</h2>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-400">Completed</span>
            <span class="font-semibold text-green-400">
              <%= @analytics.dig(:tasks, :completed) || 0 %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Active</span>
            <span class="font-semibold text-blue-400">
              <%= @analytics.dig(:tasks, :active) || 0 %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Failed</span>
            <span class="font-semibold text-red-400">
              <%= @analytics.dig(:tasks, :failed) || 0 %>
            </span>
          </div>
        </div>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Token Usage</h2>
        <div class="space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-400">Input Tokens</span>
            <span class="font-semibold">
              <%= number_with_delimiter(@analytics.dig(:tokens, :total_input) || 0) %>
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-400">Output Tokens</span>
            <span class="font-semibold">
              <%= number_with_delimiter(@analytics.dig(:tokens, :total_output) || 0) %>
            </span>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Most Used Tools -->
    <% if @analytics.dig(:tools, :most_used)&.any? %>
      <div class="bg-gray-800 rounded-lg p-6">
        <h2 class="text-xl font-bold mb-4">Most Used Tools</h2>
        <div class="space-y-2">
          <% @analytics.dig(:tools, :most_used).each do |tool, count| %>
            <div class="flex items-center justify-between">
              <span class="text-gray-300"><%= tool %></span>
              <div class="flex items-center gap-3">
                <span class="text-gray-500 text-sm"><%= count %> calls</span>
                <div class="w-32 bg-gray-700 rounded-full h-2">
                  <% max_count = @analytics.dig(:tools, :most_used).values.max %>
                  <% percentage = (count.to_f / max_count * 100).round %>
                  <div class="bg-blue-600 h-2 rounded-full" style="width: <%= percentage %>%"></div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
