<div class="max-w-7xl mx-auto px-6 py-8">
  <%= link_to "← #{@agent.name} Analytics", analytic_path(@agent), class: "text-brand-light hover:text-brand-light text-sm" %>

  <div class="mt-4 mb-8">
    <h1 class="text-2xl font-bold text-white">API Call Detail</h1>
    <p class="text-text-muted mt-1">
      <%= @usage.created_at.strftime("%B %d, %Y at %H:%M:%S") %> ·
      <span class="text-brand-light"><%= @usage.llm_model %></span> ·
      <span class="text-blue-400"><%= number_with_delimiter(@usage.input_tokens) %> input</span> /
      <span class="text-amber-400"><%= number_with_delimiter(@usage.output_tokens) %> output</span> ·
      <span class="text-green-400">$<%= sprintf("%.4f", (@usage.cost_cents || 0) / 100.0) %></span>
    </p>
  </div>

  <% payload = @usage.request_payload || {} %>

  <!-- System Prompt Blocks -->
  <% if payload["system"].present? %>
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-white mb-3">System Prompt</h2>
      <% payload["system"].each_with_index do |block, i| %>
        <div class="bg-surface-card rounded-xl border border-border-default mb-3 overflow-hidden">
          <div class="px-4 py-2 border-b border-border-default flex items-center justify-between bg-surface-base/50">
            <span class="text-text-muted text-xs font-medium">Block <%= i + 1 %></span>
            <div class="flex items-center gap-2">
              <% if block["cache_control"].present? %>
                <span class="inline-block px-2 py-0.5 text-xs rounded-full bg-purple-500/20 text-purple-300">cached</span>
              <% end %>
              <span class="text-text-faint text-xs"><%= block["text"].to_s.length %> chars</span>
            </div>
          </div>
          <div class="p-4">
            <pre class="text-text-primary text-sm whitespace-pre-wrap break-words font-mono leading-relaxed"><%= block["text"] %></pre>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Messages -->
  <% if payload["messages"].present? %>
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-white mb-3">Messages (<%= payload["messages"].size %>)</h2>
      <% payload["messages"].each do |msg| %>
        <div class="bg-surface-card rounded-xl border border-border-default mb-3 overflow-hidden">
          <div class="px-4 py-2 border-b border-border-default bg-surface-base/50">
            <span class="text-xs font-medium <%= msg['role'] == 'user' ? 'text-blue-400' : msg['role'] == 'assistant' ? 'text-amber-400' : 'text-text-muted' %>">
              <%= msg["role"]&.capitalize %>
            </span>
          </div>
          <div class="p-4">
            <pre class="text-text-primary text-sm whitespace-pre-wrap break-words font-mono leading-relaxed"><%= msg["content"].is_a?(Array) ? msg["content"].map { |b| b["text"] }.join("\n\n") : msg["content"] %></pre>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Tools -->
  <% if payload["tools"].present? %>
    <div class="mb-6">
      <h2 class="text-lg font-semibold text-white mb-3">Tools (<%= payload["tools"].size %>)</h2>
      <div class="bg-surface-card rounded-xl border border-border-default p-4">
        <div class="flex flex-wrap gap-2">
          <% payload["tools"].each do |tool| %>
            <span class="inline-block px-3 py-1 text-xs rounded-full bg-surface-raised text-text-primary border border-border-default"><%= tool["name"] %></span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Raw JSON -->
  <details class="mb-6">
    <summary class="text-text-muted text-sm cursor-pointer hover:text-text-primary">Show raw JSON</summary>
    <div class="mt-3 bg-surface-card rounded-xl border border-border-default p-4 overflow-x-auto">
      <pre class="text-text-primary text-xs font-mono whitespace-pre-wrap"><%= JSON.pretty_generate(payload) %></pre>
    </div>
  </details>
</div>
