<div class="min-h-screen bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold mb-2">Analytics</h1>
        <p class="text-gray-400">Monitor agent performance and usage</p>
      </div>
      
      <!-- Period Toggle -->
      <div class="flex gap-2">
        <%= link_to "Day", analytics_index_path(period: "day"), 
            class: "px-4 py-2 rounded-lg #{@period == 'day' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
        <%= link_to "Week", analytics_index_path(period: "week"), 
            class: "px-4 py-2 rounded-lg #{@period == 'week' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
        <%= link_to "Month", analytics_index_path(period: "month"), 
            class: "px-4 py-2 rounded-lg #{@period == 'month' ? 'bg-blue-600' : 'bg-gray-800 hover:bg-gray-700'}" %>
      </div>
    </div>
    
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Total Tasks</p>
        <p class="text-3xl font-bold"><%= @summary[:total_tasks] || 0 %></p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Active Agents</p>
        <p class="text-3xl font-bold"><%= @summary[:active_agents] || 0 %></p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Total Cost</p>
        <p class="text-3xl font-bold">
          <%= number_to_currency(@summary[:total_cost_dollars] || 0) %>
        </p>
      </div>
      
      <div class="bg-gray-800 rounded-lg p-6">
        <p class="text-gray-400 text-sm mb-1">Success Rate</p>
        <p class="text-3xl font-bold"><%= @summary[:avg_success_rate] || 0 %>%</p>
      </div>
    </div>
    
    <!-- Per-Agent Stats Table -->
    <div class="bg-gray-800 rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-700">
        <h2 class="text-xl font-bold">Agent Performance</h2>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-900 text-gray-400 text-sm">
            <tr>
              <th class="px-6 py-3 text-left font-medium">Agent</th>
              <th class="px-6 py-3 text-left font-medium">Role</th>
              <th class="px-6 py-3 text-right font-medium">Tasks</th>
              <th class="px-6 py-3 text-right font-medium">Cost</th>
              <th class="px-6 py-3 text-right font-medium">Success Rate</th>
              <th class="px-6 py-3 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-700">
            <% @per_agent.each do |stat| %>
              <tr class="hover:bg-gray-750">
                <td class="px-6 py-4 font-medium"><%= stat[:agent].name %></td>
                <td class="px-6 py-4 text-gray-400"><%= stat[:agent].role %></td>
                <td class="px-6 py-4 text-right"><%= stat[:tasks] %></td>
                <td class="px-6 py-4 text-right">
                  <%= number_to_currency(stat[:cost_cents] / 100.0) %>
                </td>
                <td class="px-6 py-4 text-right">
                  <span class="<%= stat[:success_rate] >= 80 ? 'text-green-400' : 'text-yellow-400' %>">
                    <%= stat[:success_rate] %>%
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <%= link_to "Details", analytic_path(stat[:agent]), 
                      class: "text-blue-400 hover:text-blue-300" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <% if @per_agent.empty? %>
        <div class="px-6 py-12 text-center text-gray-400">
          No analytics data available for this period.
        </div>
      <% end %>
    </div>
  </div>
</div>
