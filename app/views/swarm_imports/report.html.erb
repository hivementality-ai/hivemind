<div class="max-w-2xl mx-auto px-6 py-8">
  <%= link_to "← Teams", teams_path, class: "text-brand-light hover:text-brand text-sm" %>

  <div class="mt-6 mb-8">
    <div class="flex items-center gap-3 mb-2">
      <svg class="w-7 h-7 text-green-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h1 class="text-2xl font-bold text-white">Swarm Deployed</h1>
    </div>
    <p class="text-text-muted mt-1 ml-10">
      <span class="text-white font-medium"><%= report.document.name %></span>
      — <%= report.summary %>
    </p>
  </div>

  <%# ── Warnings ── %>
  <% if report.warnings.any? %>
    <div class="mb-6 bg-amber-900/30 border border-amber-600/50 text-amber-200 px-4 py-3 rounded-lg text-sm">
      <p class="font-medium mb-1">Notices:</p>
      <ul class="list-disc list-inside space-y-0.5">
        <% report.warnings.each do |w| %>
          <li><%= w %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# ── Summary counters ── %>
  <div class="grid grid-cols-4 gap-3 mb-6">
    <% [
      ["Created",   report.created_count,   "text-green-400",  "bg-green-900/20"],
      ["Updated",   report.updated_count,   "text-blue-400",   "bg-blue-900/20"],
      ["Renamed",   report.renamed_count,   "text-yellow-400", "bg-yellow-900/20"],
      ["Skipped",   report.skipped_count,   "text-text-faint", "bg-surface-raised"]
    ].each do |label, count, text_cls, bg_cls| %>
      <div class="<%= bg_cls %> rounded-lg p-3 text-center">
        <div class="text-2xl font-bold <%= text_cls %>"><%= count %></div>
        <div class="text-xs text-text-muted mt-0.5"><%= label %></div>
      </div>
    <% end %>
  </div>

  <%# ── Entity results by type ── %>
  <% [
    [:team,   "Team"],
    [:skill,  "Skills"],
    [:tool,   "Tools"],
    [:agent,  "Agents"]
  ].each do |type_sym, label| %>
    <% results = report.results_for(type_sym) %>
    <% next if results.empty? %>

    <div class="bg-surface-card rounded-xl border border-border-default p-5 mb-4">
      <h2 class="text-sm font-semibold text-text-primary mb-3"><%= label %></h2>
      <div class="space-y-2">
        <% results.each do |r| %>
          <% action_cls = case r.action
             when :created  then "text-green-400"
             when :updated  then "text-blue-400"
             when :renamed  then "text-yellow-400"
             when :skipped  then "text-text-faint"
             else                "text-text-muted"
             end %>
          <div class="flex items-center justify-between py-1.5 border-b border-border-default last:border-0">
            <div class="flex items-center gap-3 min-w-0">
              <span class="<%= action_cls %> text-xs font-medium w-16 flex-shrink-0 capitalize">
                <%= r.action %>
              </span>
              <span class="text-text-primary text-sm truncate"><%= r.name %></span>
            </div>
            <% if r.record.present? && r.action != :skipped %>
              <% path = record_link_path(r.record) %>
              <% if path %>
                <%= link_to "View →", path,
                    class: "text-xs text-brand-light hover:text-brand flex-shrink-0 ml-3" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── Variable overrides applied ── %>
  <% if report.variable_overrides_applied.any? %>
    <details class="mb-4">
      <summary class="text-xs text-text-muted hover:text-white cursor-pointer select-none list-none
                      flex items-center gap-1">
        <svg class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24"
             stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
        Variables applied (<%= report.variable_overrides_applied.size %>)
      </summary>
      <div class="mt-2 bg-surface-raised rounded-lg p-4 space-y-1.5">
        <% report.variable_overrides_applied.each do |name, value| %>
          <div class="flex items-center gap-3 text-xs font-mono">
            <span class="text-text-muted w-40 truncate"><%= name %></span>
            <span class="text-text-faint">→</span>
            <span class="text-brand-light truncate"><%= value %></span>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <div class="mt-6 flex items-center gap-3">
    <%= link_to "Back to Teams", teams_path,
        class: "px-5 py-2.5 bg-brand hover:bg-brand-dark text-white font-medium rounded-lg transition text-sm" %>
  </div>
</div>
