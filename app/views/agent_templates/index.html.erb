<div class="min-h-screen bg-surface-base text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2">Agent Templates</h1>
      <p class="text-text-muted">Deploy pre-configured AI agents in seconds</p>
    </div>
    
    <!-- Category Filter -->
    <div class="mb-6 flex flex-wrap gap-2">
      <%= link_to "All", agent_templates_path, class: "px-4 py-2 rounded-lg #{params[:category].blank? ? 'bg-brand' : 'bg-surface-card hover:bg-surface-raised'}" %>
      <% @categories.each do |category| %>
        <%= link_to category.titleize, agent_templates_path(category: category), 
            class: "px-4 py-2 rounded-lg #{params[:category] == category ? 'bg-brand' : 'bg-surface-card hover:bg-surface-raised'}" %>
      <% end %>
    </div>
    
    <div data-controller="template-filter" data-template-filter-open-value="<%= params[:category].present? %>">
      <div class="mb-6">
        <input type="search" placeholder="Search templates by name or description"
               aria-label="Search templates"
               class="w-full md:w-96 px-4 py-2 rounded-lg bg-surface-card text-white placeholder-text-faint"
               data-template-filter-target="input"
               data-action="input->template-filter#filter">
        <p class="text-sm text-text-muted mt-2 hidden" data-template-filter-target="empty">No templates match your search.</p>
      </div>

      <% @grouped_templates.each do |category, templates| %>
      <details class="mb-4" data-template-filter-target="group" <%= "open" if params[:category].present? %>>
        <summary class="cursor-pointer select-none text-xl font-semibold py-2">
          <%= category.titleize %>
          <span class="text-sm text-text-muted font-normal" data-template-filter-target="count">(<%= templates.size %>)</span>
        </summary>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
      <% templates.each do |template| %>
        <div class="bg-surface-card rounded-lg p-6 hover:bg-surface-raised transition" data-template-filter-target="item" data-search-text="<%= "#{template.name} #{template.description}".downcase %>">
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 bg-brand rounded-xl flex items-center justify-center text-white font-bold text-sm"><%= template.icon || "AG" %></div>
            <% if template.featured %>
              <span class="px-2 py-1 bg-yellow-600 text-xs rounded">Featured</span>
            <% end %>
          </div>
          
          <h3 class="text-xl font-bold mb-2"><%= template.name %></h3>
          <p class="text-text-muted text-sm mb-3"><%= template.role %></p>
          <p class="text-text-primary mb-4 line-clamp-3"><%= template.description %></p>

          <% if template.enabled_skill_names.any? %>
            <div class="mb-3">
              <h4 class="text-xs font-semibold text-text-muted uppercase mb-1">Skills</h4>
              <div class="flex flex-wrap gap-1">
                <% template.enabled_skill_names.each do |skill_name| %>
                  <span class="px-2 py-0.5 bg-brand/20 text-brand-light text-xs rounded-full"><%= skill_name.titleize %></span>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if template.enabled_tool_names.any? %>
            <div class="mb-4">
              <h4 class="text-xs font-semibold text-text-muted uppercase mb-1">Tools</h4>
              <div class="flex flex-wrap gap-1">
                <% template.enabled_tool_names.first(5).each do |tool_name| %>
                  <span class="px-2 py-0.5 bg-surface-base text-text-faint text-xs rounded-full"><%= tool_name.titleize %></span>
                <% end %>
                <% if template.enabled_tool_names.size > 5 %>
                  <span class="px-2 py-0.5 bg-surface-base text-text-faint text-xs rounded-full">+<%= template.enabled_tool_names.size - 5 %> more</span>
                <% end %>
              </div>
            </div>
          <% end %>

          <div class="flex items-center justify-between">
            <span class="text-xs text-text-faint uppercase"><%= template.category %></span>
            <%= link_to "Deploy", agent_template_path(template), 
                class: "px-4 py-2 bg-brand hover:bg-brand-dark rounded-lg text-sm font-medium" %>
          </div>
        </div>
      <% end %>
        </div>
      </details>
      <% end %>
    </div>

    <% if @templates.empty? %>
      <div class="text-center py-12">
        <p class="text-text-muted">No templates found in this category.</p>
      </div>
    <% end %>
  </div>
</div>
