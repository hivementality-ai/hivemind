<div class="min-h-screen bg-surface-base flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <%= hivemind_logo(size: "w-14 h-14 mx-auto", css: "text-amber-400") %>
      <h1 class="text-3xl font-bold text-white mt-4">Pair Desktop App</h1>
      <p class="text-text-muted mt-2">A desktop app is requesting access to your Hivemind account.</p>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default p-8 space-y-5">
      <%# data: { turbo: false } — the response 302s to the app's http://127.0.0.1
    loopback server. Turbo would follow that redirect with fetch, which the
    browser blocks cross-origin; a plain form POST makes it a top-level
    navigation, which is allowed. %>
      <%= form_with url: desktop_pairing_path, method: :post, class: "space-y-5", data: { turbo: false } do %>
        <%= hidden_field_tag :code_challenge, @code_challenge %>
        <%= hidden_field_tag :state, @state %>
        <%= hidden_field_tag :port, @port %>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Device name</label>
          <%= text_field_tag :device_name, @device_name,
                class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
        </div>

        <%= submit_tag "Approve", class: "w-full py-3 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>

      <%= form_with url: deny_desktop_pairing_path, method: :post, data: { turbo: false } do %>
        <%= hidden_field_tag :state, @state %>
        <%= hidden_field_tag :port, @port %>
        <%= submit_tag "Deny", class: "w-full py-3 bg-surface-raised hover:bg-surface-overlay text-text-primary font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-center text-text-faint text-sm mt-6">
      Signed in as <%= current_user.email %>
    </p>
  </div>
</div>
