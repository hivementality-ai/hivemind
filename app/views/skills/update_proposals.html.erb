<div class="max-w-7xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="flex items-center gap-3 mb-1">
        <%= link_to "← Skills", skills_path, class: "text-brand-light hover:text-brand-light text-sm" %>
      </div>
      <h1 class="text-2xl font-bold text-white">Skill Update Proposals</h1>
      <p class="text-text-muted text-sm mt-1">Agent-proposed improvements to existing skills. Review the diff and approve or reject.</p>
    </div>
    <% if @pending_proposals.any? %>
      <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-amber-900/60 text-amber-300">
        <%= @pending_proposals.count %> pending
      </span>
    <% end %>
  </div>

  <%# ── Pending ─────────────────────────────────────────────────── %>
  <section class="mb-10">
    <h2 class="text-lg font-semibold text-white mb-4">Pending Review</h2>

    <% if @pending_proposals.any? %>
      <div class="space-y-6">
        <% @pending_proposals.each do |proposal| %>
          <%= render "skills/update_proposal_card", proposal: proposal, show_actions: true %>
        <% end %>
      </div>
    <% else %>
      <div class="bg-surface-card rounded-xl border border-border-default p-8 text-center">
        <p class="text-text-muted">No pending update proposals. Agents will appear here when they use the <code class="text-brand-light">propose_skill_update</code> tool.</p>
      </div>
    <% end %>
  </section>

  <%# ── Recently Approved ──────────────────────────────────────── %>
  <% if @approved_proposals.any? %>
    <section class="mb-10">
      <h2 class="text-lg font-semibold text-white mb-4">Recently Approved</h2>
      <div class="space-y-4">
        <% @approved_proposals.each do |proposal| %>
          <%= render "skills/update_proposal_card", proposal: proposal, show_actions: false %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# ── Recently Rejected ──────────────────────────────────────── %>
  <% if @rejected_proposals.any? %>
    <section>
      <h2 class="text-lg font-semibold text-white mb-4">Recently Rejected</h2>
      <div class="space-y-4">
        <% @rejected_proposals.each do |proposal| %>
          <%= render "skills/update_proposal_card", proposal: proposal, show_actions: false %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
