<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Outbound Webhooks</h1>
      <p class="text-text-muted mt-1">Subscribe external services to Hivemind lifecycle events. Each endpoint receives signed POST requests with an HMAC-SHA256 <code class="font-mono text-amber-400">X-Hivemind-Signature</code> header.</p>
    </div>
    <%= link_to new_webhook_endpoint_path, class: "px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" do %>
      + Add Endpoint
    <% end %>
  </div>

  <% if @endpoints.any? %>
    <div class="bg-surface-card/50 border border-border-default/50 rounded-xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-text-faint text-xs uppercase border-b border-border-default/50">
          <tr>
            <th class="text-left font-medium px-5 py-3">URL</th>
            <th class="text-left font-medium px-5 py-3">Events</th>
            <th class="text-left font-medium px-5 py-3">Status</th>
            <th class="text-left font-medium px-5 py-3">Failures</th>
            <th class="text-left font-medium px-5 py-3">Last Delivery</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default/30">
          <% @endpoints.each do |ep| %>
            <tr class="hover:bg-surface-card/60 transition">
              <td class="px-5 py-3">
                <span class="text-white font-mono text-xs break-all"><%= ep.url %></span>
              </td>
              <td class="px-5 py-3">
                <div class="flex flex-wrap gap-1">
                  <% ep.event_types.to_a.each do |evt| %>
                    <span class="px-2 py-0.5 text-xs rounded-full bg-amber-500/10 text-amber-400 font-mono"><%= evt %></span>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-3">
                <% if ep.enabled? %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-green-500/10 text-green-400">enabled</span>
                <% else %>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-red-500/10 text-red-400">disabled</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-text-muted">
                <% if ep.failure_count > 0 %>
                  <span class="text-red-400"><%= ep.failure_count %></span>
                <% else %>
                  <span class="text-text-faint">0</span>
                <% end %>
                <% if ep.last_status.present? %>
                  <span class="ml-1 text-xs text-text-faint">(<%= ep.last_status %>)</span>
                <% end %>
              </td>
              <td class="px-5 py-3 text-text-muted text-xs">
                <%= ep.last_delivered_at ? time_ago_in_words(ep.last_delivered_at) + " ago" : "—" %>
              </td>
              <td class="px-5 py-3 text-right flex gap-3 justify-end">
                <%= link_to edit_webhook_endpoint_path(ep), class: "text-text-faint hover:text-white transition text-xs" do %>Edit<% end %>
                <%= button_to webhook_endpoint_path(ep), method: :delete,
                      form: { data: { turbo_confirm: "Delete this webhook endpoint?" } },
                      class: "text-text-faint hover:text-red-400 transition text-xs" do %>
                  Delete
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 bg-surface-card/30 rounded-xl border border-border-default/50">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
        <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>
        </svg>
      </div>
      <h3 class="text-white font-semibold text-lg mb-2">No webhooks yet</h3>
      <p class="text-text-muted mb-4">Add an endpoint to receive signed event payloads from Hivemind.</p>
      <%= link_to "Add First Endpoint", new_webhook_endpoint_path, class: "inline-block px-4 py-2 bg-amber-500 text-black font-semibold rounded-lg hover:bg-amber-400 transition" %>
    </div>
  <% end %>
</div>
