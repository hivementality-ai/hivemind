<div class="max-w-4xl mx-auto px-6 py-8">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to hooks_overview_path, class: "text-text-muted hover:text-white transition" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-white"><%= @team.name %> Hooks</h1>
      <p class="text-sm text-text-muted mt-0.5">Manage hooks for this team. These apply to all tasks unless overridden.</p>
    </div>
  </div>

  <!-- Explanation -->
  <div class="bg-surface-card rounded-xl border border-border-default p-5 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-brand mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div class="text-sm text-text-muted">
        <p class="text-text-primary font-medium mb-1">How hooks work</p>
        <p>Team hooks are <strong class="text-white">global defaults</strong> &mdash; they fire for any task on this team unless overridden by a task-level or template-level hook. Hooks run <strong class="text-white">pre</strong> (before) or <strong class="text-white">post</strong> (after) a status transition.</p>
        <p class="mt-2"><strong class="text-white">Agent handoff:</strong> When a hook has an agent assigned, the task is automatically reassigned to that agent before the hook fires. This creates a workflow pipeline where each status change hands the task to the next agent.</p>
        <p class="mt-2">Precedence: <span class="text-brand">Task</span> > <span class="text-brand">Template</span> > <span class="text-brand">Team</span></p>
      </div>
    </div>
  </div>

  <!-- Existing Hooks -->
  <div class="bg-surface-card rounded-xl border border-border-default p-6 mb-6">
    <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">
      Active Hooks (<%= @hooks.size %>)
    </h2>

    <% if @hooks.any? %>
      <div class="space-y-3">
        <% @hooks.each do |hook| %>
          <div class="flex items-center gap-3 bg-surface-raised rounded-lg px-4 py-3 <%= hook.enabled? ? '' : 'opacity-50' %>">
            <span class="px-2.5 py-1 rounded text-xs font-semibold uppercase <%= hook.trigger == 'pre' ? 'bg-blue-900/40 text-blue-300' : 'bg-purple-900/40 text-purple-300' %>">
              <%= hook.trigger %>
            </span>
            <span class="text-text-muted text-sm">on</span>
            <span class="text-white font-medium text-sm"><%= hook.on_status %></span>
            <span class="text-text-faint">&rarr;</span>
            <% if hook.agent %>
              <span class="text-emerald-400 text-sm font-medium"><%= hook.agent.name %></span>
            <% else %>
              <span class="text-text-faint text-sm italic">any agent</span>
            <% end %>

            <% if hook.skill %>
              <span class="text-text-faint">&rarr;</span>
              <span class="text-brand text-sm font-medium"><%= hook.skill.name %></span>
            <% else %>
              <span class="text-text-faint">&rarr;</span>
              <span class="text-text-muted text-sm italic">default behavior</span>
            <% end %>

            <div class="ml-auto flex items-center gap-2">
              <% unless hook.enabled? %>
                <span class="text-xs text-text-faint">(disabled)</span>
              <% end %>

              <%= button_to toggle_team_task_hook_path(@team, hook), method: :patch,
                    class: "p-1.5 rounded-lg hover:bg-surface-card transition",
                    title: hook.enabled? ? "Disable" : "Enable" do %>
                <% if hook.enabled? %>
                  <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                <% else %>
                  <svg class="w-4 h-4 text-text-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                  </svg>
                <% end %>
              <% end %>

              <%= link_to edit_team_task_hook_path(@team, hook),
                    class: "p-1.5 rounded-lg hover:bg-surface-card transition" do %>
                <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>

              <%= button_to team_task_hook_path(@team, hook), method: :delete,
                    data: { turbo_confirm: "Remove this hook?" },
                    class: "p-1.5 rounded-lg hover:bg-red-900/20 transition" do %>
                <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-text-faint text-sm">No hooks configured. Add one below to automate task transitions.</p>
    <% end %>
  </div>

  <!-- Add Hook Form -->
  <div class="bg-surface-card rounded-xl border border-border-default p-6">
    <h2 class="text-sm font-semibold text-text-muted uppercase tracking-wider mb-4">Add Hook</h2>

    <%= form_with model: [@team, TaskHook.new], url: team_task_hooks_path(@team), local: true do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <label class="block text-xs font-medium text-text-muted mb-1.5">Trigger</label>
          <%= f.select :trigger, TaskHook::TRIGGERS.map { |t| [t == "pre" ? "Pre (before)" : "Post (after)", t] },
                {}, class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:border-brand/50" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-text-muted mb-1.5">On Status</label>
          <%= f.select :on_status, Task::STATUSES.map { |s| [s.humanize, s] },
                {}, class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:border-brand/50" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-text-muted mb-1.5">Agent <span class="text-text-faint">(auto-assign when triggered)</span></label>
          <%= f.select :agent_id,
                options_for_select([["No auto-assign", ""]] + @agents.map { |a| [a.name, a.id] }),
                {}, class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:border-brand/50" %>
        </div>

        <div>
          <label class="block text-xs font-medium text-text-muted mb-1.5">Skill <span class="text-text-faint">(optional)</span></label>
          <%= f.select :skill_id,
                options_for_select([["Default behavior", ""]] + @skills.map { |s| [s.name, s.id] }),
                {}, class: "w-full bg-surface-raised border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:border-brand/50" %>
        </div>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Add Hook", class: "px-4 py-2 bg-brand hover:bg-brand/80 text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
