<div class="max-w-5xl mx-auto px-6 py-8">
  <%= link_to "← Teams", teams_path, class: "text-brand-light hover:text-brand-light text-sm" %>

  <h1 class="text-2xl font-bold text-white mt-4 mb-8">Edit <%= @team.name %></h1>

  <%# Org Chart — the visual centrepiece %>
  <div class="mb-10">
    <h2 class="text-lg font-semibold text-white mb-4">Org Chart</h2>
    <%= render "teams/org_chart", team: @team %>
  </div>

  <div class="bg-surface-card rounded-xl border border-border-default p-8">
    <%= render "form", team: @team %>
  </div>
</div>
