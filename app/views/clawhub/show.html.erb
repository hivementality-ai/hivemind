<div class="max-w-4xl mx-auto px-6 py-8">
  <%= link_to "&larr; Back to ClawHub".html_safe, clawhub_index_path, class: "text-text-muted hover:text-white text-sm transition mb-6 inline-block" %>

  <% skill = @skill_data["skill"] || {} %>
  <% latest_version = @skill_data["latestVersion"] || {} %>
  <% metadata = @skill_data["metadata"] || {} %>
  <% owner = @skill_data["owner"] || {} %>
  <% moderation = @skill_data["moderation"] || {} %>
  <% stats = skill["stats"] || {} %>
  <% tags = skill["tags"] || {} %>
  <% security = latest_version["security"] || {} %>

  <div class="bg-surface-card rounded-xl border border-border-default p-6 mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold text-white mb-1"><%= skill["displayName"] || @slug %></h1>
        <div class="flex items-center gap-3 text-sm text-text-muted">
          <% if owner["handle"].present? %>
            <span>by <%= owner["handle"] %></span>
          <% end %>
          <% if latest_version["version"].present? %>
            <span class="px-2 py-0.5 bg-surface-raised rounded text-text-faint text-xs">v<%= latest_version["version"] %></span>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <% if @installed %>
          <span class="px-4 py-2 bg-green-900/50 text-green-300 text-sm font-medium rounded-lg">Installed</span>
        <% else %>
          <%= button_to "Install", install_clawhub_path(slug: @slug), method: :post,
              class: "px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium rounded-lg transition cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <p class="text-text-primary mb-4"><%= skill["summary"] %></p>

    <!-- Stats -->
    <div class="flex items-center gap-6 mb-4 text-sm text-text-muted">
      <span title="Downloads">
        <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
        <%= number_to_human(stats["downloads"] || 0, precision: 1, significant: false) %> downloads
      </span>
      <span title="Stars">
        <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
        <%= number_to_human(stats["stars"] || 0, precision: 1, significant: false) %> stars
      </span>
      <% if stats["installs"].present? %>
        <span title="Installs">
          <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          <%= number_to_human(stats["installs"], precision: 1, significant: false) %> installs
        </span>
      <% end %>
    </div>

    <!-- Security Badge -->
    <% if security["status"].present? %>
      <div class="mb-4">
        <span class="text-xs text-text-faint uppercase tracking-wide mr-2">ClawHub Security:</span>
        <% security_classes = case security["status"]
           when "clean"      then "bg-green-900/50 text-green-300"
           when "suspicious"  then "bg-yellow-900/50 text-yellow-300"
           when "malicious"   then "bg-red-950/60 text-red-400"
           when "pending"     then "bg-surface-raised text-text-faint"
           else                    "bg-surface-raised text-text-faint"
           end %>
        <span class="px-2 py-0.5 text-xs rounded-full <%= security_classes %>"><%= security["status"] %></span>
        <% if security["hasWarnings"] %>
          <span class="text-xs text-yellow-400 ml-1">has warnings</span>
        <% end %>
      </div>
    <% end %>

    <!-- Tags -->
    <% if tags.any? %>
      <div class="flex flex-wrap gap-1 mb-4">
        <% tags.keys.each do |tag| %>
          <span class="px-2 py-0.5 text-xs rounded-full bg-brand-glow/30 text-brand-light"><%= tag %></span>
        <% end %>
      </div>
    <% end %>

    <!-- OS Compatibility -->
    <% os = metadata["os"] %>
    <% if os.present? %>
      <div class="mb-4">
        <span class="text-xs text-text-faint uppercase tracking-wide mr-2">Platforms:</span>
        <% Array(os).each do |platform| %>
          <span class="px-2 py-0.5 text-xs rounded-full bg-surface-raised text-text-muted"><%= platform %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Changelog -->
  <% if latest_version["changelog"].present? %>
    <div class="bg-surface-card rounded-xl border border-border-default p-6">
      <h2 class="text-lg font-semibold text-white mb-3">Changelog</h2>
      <p class="text-text-muted text-sm whitespace-pre-wrap"><%= latest_version["changelog"] %></p>
    </div>
  <% end %>
</div>
