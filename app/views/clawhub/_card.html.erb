<%# locals: (skill:, installed_urls:) %>
<% slug = skill["slug"] %>
<% source_url = "#{ClawHub::Client::BASE_URL}/skills/#{slug}" %>
<% installed = installed_urls.include?(source_url) %>
<% stats = skill["stats"] || {} %>
<% tags = skill["tags"] || {} %>
<% latest = skill["latestVersion"] || {} %>

<%= link_to clawhub_path(slug: slug), class: "block bg-surface-card rounded-xl border border-border-default hover:border-amber-500/50 transition p-5" do %>
  <div class="flex items-start justify-between mb-3">
    <div class="flex-1 min-w-0">
      <h3 class="text-white font-semibold truncate"><%= skill["displayName"] || slug %></h3>
      <% if latest["version"].present? %>
        <span class="text-xs text-text-faint">v<%= latest["version"] %></span>
      <% end %>
    </div>
    <% if installed %>
      <span class="px-2 py-0.5 text-xs rounded-full bg-green-900/50 text-green-300 flex-shrink-0 ml-2">Installed</span>
    <% end %>
  </div>

  <p class="text-text-muted text-sm line-clamp-2 mb-3"><%= skill["summary"] %></p>

  <% if tags.any? %>
    <div class="flex flex-wrap gap-1 mb-3">
      <% tags.keys.first(4).each do |tag| %>
        <span class="px-2 py-0.5 text-xs rounded-full bg-brand-glow/30 text-brand-light"><%= tag %></span>
      <% end %>
      <% if tags.size > 4 %>
        <span class="px-2 py-0.5 text-xs rounded-full bg-surface-raised text-text-muted">+<%= tags.size - 4 %></span>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-4 text-xs text-text-faint">
    <span title="Downloads">
      <svg class="w-3.5 h-3.5 inline-block mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
      <%= number_to_human(stats["downloads"] || 0, precision: 1, significant: false) %>
    </span>
    <span title="Stars">
      <svg class="w-3.5 h-3.5 inline-block mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
      <%= number_to_human(stats["stars"] || 0, precision: 1, significant: false) %>
    </span>
  </div>
<% end %>
