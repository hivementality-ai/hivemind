<%# Approval card for a held tool call. locals: approval, outcome (optional text), failed (optional) %>
<% outcome = local_assigns[:outcome] %>
<% failed = local_assigns[:failed] %>
<% card = Approvals::CardFields.new(approval) %>
<% state = approval.expired? && approval.status != "approved" && approval.status != "rejected" ? "expired" : approval.status %>
<div id="<%= dom_id(approval, :card) %>" class="flex justify-start" data-approval-state="<%= state %>">
  <div class="max-w-2xl w-full bg-surface-card border border-amber-500/40 rounded-2xl px-5 py-4">
    <p class="text-white font-semibold"><%= card.headline %></p>

    <dl class="mt-3 space-y-2 text-sm">
      <% card.fields.each do |field| %>
        <div>
          <dt class="text-text-faint text-xs uppercase"><%= field.label %></dt>
          <dd class="text-text-primary <%= 'whitespace-pre-wrap' if field.long %>"><%= field.value %></dd>
        </div>
      <% end %>
    </dl>

    <% if outcome.present? %>
      <p class="mt-3 text-sm <%= failed ? 'text-red-300' : 'text-text-muted' %>"><%= outcome %></p>
    <% end %>

    <% case state %>
    <% when "pending" %>
      <div class="mt-4 flex flex-wrap gap-2">
        <%= button_to "Approve", approve_approval_card_path(approval), method: :post,
              class: "px-4 py-2 text-sm font-semibold rounded-lg bg-green-700/80 text-green-100 hover:bg-green-600/80 transition" %>
        <details class="w-full order-last">
          <summary class="inline-block px-4 py-2 text-sm font-semibold rounded-lg bg-surface-raised text-text-primary cursor-pointer">Edit</summary>
          <%= form_with url: approve_with_edits_approval_card_path(approval), method: :post, class: "mt-3 space-y-3" do |f| %>
            <% card.fields.each do |field| %>
              <div>
                <%= label_tag "edits_#{approval.id}_#{field.key}", field.label, class: "block text-text-muted text-xs mb-1" %>
                <% if field.long %>
                  <%= text_area_tag "edits[#{field.key}]", field.value, id: "edits_#{approval.id}_#{field.key}", rows: 6,
                        class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white text-sm" %>
                <% else %>
                  <%= text_field_tag "edits[#{field.key}]", field.value, id: "edits_#{approval.id}_#{field.key}",
                        class: "w-full px-3 py-2 bg-surface-raised border border-border-default rounded-lg text-white text-sm" %>
                <% end %>
              </div>
            <% end %>
            <%= f.submit "Approve with my changes", class: "px-4 py-2 text-sm font-semibold rounded-lg bg-brand text-white" %>
          <% end %>
        </details>
        <%= button_to "Decline", decline_approval_card_path(approval), method: :post,
              class: "px-4 py-2 text-sm font-semibold rounded-lg bg-red-900/60 text-red-200 hover:bg-red-800/60 transition" %>
      </div>
      <p class="mt-3 text-text-faint text-xs">Waiting for you. Expires <%= time_ago_in_words(approval.expires_at) %> from now if nobody answers.</p>
    <% when "approved" %>
      <p class="mt-3 text-green-300 text-sm font-medium">Approved<%= approval.params["edited"] ? " with your changes" : "" %>.</p>
    <% when "rejected" %>
      <p class="mt-3 text-red-300 text-sm font-medium">Declined. Nothing was done.</p>
    <% else %>
      <p class="mt-3 text-text-muted text-sm font-medium">This request expired after 24 hours and was not carried out.</p>
    <% end %>
  </div>
</div>
