<div class="min-h-screen bg-surface-base p-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-white">Knowledge Base</h1>
        <p class="text-text-muted mt-1">Documents indexed for agent RAG retrieval</p>
      </div>
      <%= link_to "Upload Document", new_knowledge_document_path,
            class: "px-4 py-2 bg-brand hover:bg-brand-dark rounded-lg text-white transition" %>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default">
      <% if @documents.empty? %>
        <div class="px-6 py-12 text-center text-text-muted">
          No documents yet. Upload one to get started.
        </div>
      <% else %>
        <table class="w-full">
          <thead>
            <tr class="border-b border-border-default text-left">
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Title</th>
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Agent</th>
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Chunks</th>
              <th class="px-6 py-3 text-xs font-medium text-text-faint uppercase tracking-wider">Added</th>
              <th class="px-6 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-default">
            <% @documents.each do |doc| %>
              <tr class="hover:bg-surface-overlay transition">
                <td class="px-6 py-4">
                  <%= link_to doc.title, knowledge_document_path(doc),
                        class: "text-white font-medium hover:text-brand-light" %>
                </td>
                <td class="px-6 py-4 text-text-muted text-sm"><%= doc.agent.name %></td>
                <td class="px-6 py-4 text-text-muted text-sm"><%= doc.source_type %></td>
                <td class="px-6 py-4">
                  <% color = { "pending" => "bg-yellow-900/50 text-yellow-300",
                               "processing" => "bg-blue-900/50 text-blue-300",
                               "ready" => "bg-green-900/50 text-green-300",
                               "failed" => "bg-red-900/50 text-red-300" }[doc.status] || "bg-surface-overlay text-text-muted" %>
                  <span class="text-xs px-2 py-0.5 rounded-full <%= color %>"><%= doc.status %></span>
                </td>
                <td class="px-6 py-4 text-text-muted text-sm"><%= doc.chunks.size %></td>
                <td class="px-6 py-4 text-text-faint text-sm"><%= time_ago_in_words(doc.created_at) %> ago</td>
                <td class="px-6 py-4 text-right">
                  <%= button_to "Delete", knowledge_document_path(doc), method: :delete,
                        data: { turbo_confirm: "Delete \"#{doc.title}\" and all its chunks?" },
                        class: "text-xs text-red-400 hover:text-red-300 transition" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>
