<div class="min-h-screen bg-surface-base p-6">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-4 mb-8">
      <%= link_to knowledge_documents_path, class: "text-text-muted hover:text-white transition" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-white">Upload Document</h1>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default p-6">
      <%= form_with model: @document, url: knowledge_documents_path, multipart: true, class: "space-y-6" do |f| %>
        <% if @document.errors.any? %>
          <div class="bg-red-900/50 border border-red-700 rounded-lg p-4">
            <ul class="text-red-300 text-sm space-y-1">
              <% @document.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Title</label>
          <%= f.text_field :title,
                class: "w-full bg-surface-base border border-border-default rounded-lg px-4 py-2 text-white focus:border-brand focus:ring-1 focus:ring-brand",
                placeholder: "My reference document" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Agent</label>
          <%= f.select :agent_id,
                options_from_collection_for_select(@agents, :id, :name, @document.agent_id),
                { prompt: "Select an agent" },
                class: "w-full bg-surface-base border border-border-default rounded-lg px-4 py-2 text-white focus:border-brand focus:ring-1 focus:ring-brand" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Source type</label>
          <%= f.select :source_type,
                [["Plain text", "text"], ["PDF", "pdf"]],
                {},
                class: "w-full bg-surface-base border border-border-default rounded-lg px-4 py-2 text-white focus:border-brand focus:ring-1 focus:ring-brand" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Text content</label>
          <p class="text-xs text-text-faint mb-2">Paste text here when source type is "Plain text".</p>
          <%= f.text_area :text_content, rows: 8,
                name: "knowledge_document[text_content]",
                class: "w-full bg-surface-base border border-border-default rounded-lg px-4 py-2 text-white focus:border-brand focus:ring-1 focus:ring-brand",
                placeholder: "Paste document text here..." %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">PDF file</label>
          <p class="text-xs text-text-faint mb-2">Upload a PDF when source type is "PDF".</p>
          <input type="file" name="knowledge_document[file]" accept=".pdf"
                 class="w-full text-text-muted text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-brand file:text-white file:cursor-pointer hover:file:bg-brand-dark" />
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Upload & Queue Ingestion",
                class: "px-6 py-2 bg-brand hover:bg-brand-dark rounded-lg text-white font-medium transition cursor-pointer" %>
          <%= link_to "Cancel", knowledge_documents_path, class: "px-6 py-2 text-text-muted hover:text-white transition" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
