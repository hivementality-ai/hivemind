<div class="min-h-screen bg-gray-900 flex items-center justify-center px-4">
  <div class="max-w-lg w-full">
    <!-- Logo -->
    <div class="text-center mb-8">
      <span class="text-6xl">🐝</span>
      <h1 class="text-3xl font-bold text-white mt-4">Welcome to Hivemind</h1>
      <p class="text-gray-400 mt-2">Let's get your AI team running. This takes about 2 minutes.</p>
    </div>

    <%= render "setup/progress", step: 1 %>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
      <h2 class="text-xl font-semibold text-white mb-1">Create your account</h2>
      <p class="text-gray-400 text-sm mb-6">This will be the owner account for your Hivemind instance.</p>

      <%= form_with model: @user, url: setup_account_path, class: "space-y-5" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <% @user.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.email_field :email, required: true, autofocus: true,
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.password_field :password, required: true,
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.password_field :password_confirmation, required: true,
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "••••••••" %>
        </div>

        <%= f.submit "Continue →", class: "w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
