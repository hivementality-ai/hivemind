<div class="min-h-screen bg-gray-900 flex items-center justify-center px-4 py-12">
  <div class="max-w-2xl w-full">
    <div class="text-center mb-8">
      <span class="text-5xl">🤖</span>
      <h1 class="text-3xl font-bold text-white mt-4">Deploy your first agent</h1>
      <p class="text-gray-400 mt-2">Pick a template to get started. You can customize everything later.</p>
    </div>

    <%= render "setup/progress", step: 4 %>

    <%= form_with url: setup_agent_path, method: :post, data: { controller: "template-select" } do |f| %>
      <%= f.hidden_field :agent, value: "", name: "agent[team_id]" %>
      <input type="hidden" name="agent[team_id]" value="<%= @team.id %>">
      <input type="hidden" name="agent[template_id]" value="" data-template-select-target="templateId">

      <!-- Template Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <% @templates.each do |template| %>
          <button type="button"
                  class="text-left bg-gray-800 rounded-xl border-2 border-gray-700 p-5 hover:border-blue-500 transition cursor-pointer group"
                  data-action="click->template-select#pick"
                  data-template-id="<%= template.id %>"
                  data-template-name="<%= template.name %>">
            <div class="flex items-start gap-3">
              <span class="text-3xl"><%= template.icon %></span>
              <div class="flex-1">
                <h3 class="text-white font-semibold group-hover:text-blue-400 transition"><%= template.name %></h3>
                <p class="text-gray-400 text-sm mt-1 line-clamp-2"><%= template.description %></p>
                <div class="flex items-center gap-2 mt-2">
                  <span class="px-2 py-0.5 bg-gray-700 rounded text-xs text-gray-300"><%= template.category %></span>
                </div>
              </div>
            </div>
          </button>
        <% end %>
      </div>

      <% if @all_templates.count > @templates.count %>
        <p class="text-center text-gray-500 text-sm mb-6">
          + <%= @all_templates.count - @templates.count %> more templates available after setup
        </p>
      <% end %>

      <!-- Agent Name -->
      <div class="bg-gray-800 rounded-xl border border-gray-700 p-6 mb-6" data-template-select-target="nameSection" style="display: none;">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-2xl" data-template-select-target="selectedIcon">🤖</span>
          <div>
            <p class="text-sm text-gray-400">Deploying</p>
            <p class="text-white font-semibold" data-template-select-target="selectedName">—</p>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Agent name (optional)</label>
          <input type="text" name="agent[name]"
                 class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                 placeholder="Leave blank to use template name"
                 data-template-select-target="nameInput">
        </div>

        <button type="submit"
                class="w-full mt-4 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg transition cursor-pointer">
          🚀 Deploy Agent
        </button>
      </div>
    <% end %>
  </div>
</div>
