<div class="min-h-screen bg-gray-900 flex items-center justify-center px-4 py-12">
  <div class="max-w-lg w-full">
    <div class="text-center mb-8">
      <span class="text-5xl">👥</span>
      <h1 class="text-3xl font-bold text-white mt-4">Create your first team</h1>
      <p class="text-gray-400 mt-2">Teams group agents that work together. You can create more later.</p>
    </div>

    <%= render "setup/progress", step: 3 %>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
      <%= form_with model: @team, url: setup_team_path, class: "space-y-5" do |f| %>
        <% if @team.errors.any? %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <% @team.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Team name", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.text_field :name, required: true, autofocus: true,
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent",
              placeholder: "e.g. Engineering, Research, My Crew" %>
        </div>

        <div>
          <%= f.label :description, "Description (optional)", class: "block text-sm font-medium text-gray-300 mb-1" %>
          <%= f.text_area :description, rows: 2,
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none",
              placeholder: "What does this team do?" %>
        </div>

        <%= f.submit "Continue →", class: "w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
