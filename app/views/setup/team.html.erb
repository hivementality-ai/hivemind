<div class="min-h-screen bg-surface-base flex items-center justify-center px-4 py-12">
  <div class="max-w-lg w-full">
    <div class="text-center mb-8">
      <%= hivemind_logo(size: "w-14 h-14 mx-auto", css: "text-amber-400") %>
      <h1 class="text-3xl font-bold text-white mt-4">Create your first team</h1>
      <p class="text-text-muted mt-2">Teams group agents that work together. You can create more later.</p>
    </div>

    <%= render "setup/progress", step: 3 %>

    <div class="bg-surface-card rounded-xl border border-border-default p-8">
      <%= form_with model: @team, url: setup_team_path, class: "space-y-5" do |f| %>
        <% if @team.errors.any? %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <% @team.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= f.label :name, "Team name", class: "block text-sm font-medium text-text-primary mb-1" %>
          <%= f.text_field :name, required: true, autofocus: true,
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent",
              placeholder: "e.g. Engineering, Research, My Crew" %>
        </div>

        <div>
          <%= f.label :description, "Description (optional)", class: "block text-sm font-medium text-text-primary mb-1" %>
          <%= f.text_area :description, rows: 2,
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent resize-none",
              placeholder: "What does this team do?" %>
        </div>

        <div>
          <%= f.label :custom_soul, "Team Personality (optional)", class: "block text-sm font-medium text-text-primary mb-1" %>
          <p class="text-xs text-text-faint mb-2">Set the vibe for how your agents interact. Leave blank for a chill default.</p>
          <%= f.text_area :custom_soul, rows: 4,
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent resize-none",
              placeholder: "e.g. Keep it professional but friendly. Focus on shipping fast. Challenge each other's ideas." %>
        </div>

        <%= f.submit "Continue →", class: "w-full py-3 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
