<div class="max-w-5xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-white">Channels</h1>
      <p class="text-text-muted mt-1">Connect messaging platforms to your agents</p>
    </div>
    <%= link_to "Add Channel", new_channel_path, class: "px-4 py-2 bg-brand hover:bg-brand-dark text-white font-medium rounded-lg transition" %>
  </div>

  <% if @channels.any? %>
    <div class="space-y-4">
      <% @channels.each do |ch| %>
        <div class="bg-surface-card rounded-xl border border-border-default p-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center text-sm font-bold
                <%= case ch.channel_type
                    when 'discord' then 'bg-indigo-900 text-indigo-300'
                    when 'slack' then 'bg-purple-900 text-purple-300'
                    when 'telegram' then 'bg-brand-glow text-brand-light'
                    when 'whatsapp' then 'bg-green-900 text-green-300'
                    when 'signal' then 'bg-sky-900 text-sky-300'
                    else 'bg-surface-raised text-text-primary'
                    end %>">
                <%= ch.channel_type&.first(2)&.upcase %>
              </div>
              <div>
                <h3 class="text-white font-semibold"><%= ch.name %></h3>
                <p class="text-text-faint text-sm"><%= ch.channel_type.titleize %></p>
              </div>
            </div>

            <div class="flex items-center gap-4">
              <span class="px-3 py-1 rounded-full text-xs font-medium
                <%= ch.enabled? ? 'bg-green-900 text-green-300' : 'bg-surface-raised text-text-muted' %>">
                <%= ch.enabled? ? "Active" : "Disabled" %>
              </span>

              <div class="flex gap-2">
                <% if %w[whatsapp signal].include?(ch.channel_type) %>
                  <%= link_to "Connect", connect_channel_path(ch),
                      class: "text-sm px-3 py-1 bg-green-600 hover:bg-green-700 text-white rounded-lg transition" %>
                <% end %>
                <%= link_to "Edit", edit_channel_path(ch), class: "text-sm text-brand-light hover:text-brand-light" %>
                <%= button_to "Delete", channel_path(ch), method: :delete,
                    data: { turbo_confirm: "Remove #{ch.name}?" },
                    class: "text-sm text-red-400 hover:text-red-300" %>
              </div>
            </div>
          </div>

          <% if ch.config.present? %>
            <div class="mt-4 pt-4 border-t border-border-default">
              <p class="text-text-faint text-xs mb-2">Webhook URL:</p>
              <code class="text-xs text-text-primary bg-surface-base px-3 py-1 rounded">
                POST <%= request.base_url %>/webhooks/<%= ch.channel_type %>
              </code>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-surface-card rounded-xl border border-border-default p-12 text-center">
      <%= hex_link_icon(size: "w-12 h-12 mx-auto mb-4", css: "text-text-faint") %>
      <p class="text-text-muted mb-2">No channels configured yet</p>
      <p class="text-text-faint text-sm">Connect Discord, Slack, Telegram, WhatsApp, or Signal</p>
    </div>
  <% end %>
</div>
