<div class="min-h-screen bg-surface-base p-6">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-4 mb-8">
      <%= link_to tools_path, class: "text-text-muted hover:text-white transition" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <h1 class="text-2xl font-bold text-white">New Custom Tool</h1>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default p-6">
      <%= render "form" %>
    </div>
  </div>
</div>
