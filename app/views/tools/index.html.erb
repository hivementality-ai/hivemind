<div class="min-h-screen bg-gray-900 p-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-bold text-white">🔧 Tools</h1>
        <p class="text-gray-400 mt-1">Tools agents can use to interact with the world</p>
      </div>
      <%= link_to "New Tool", new_tool_path, class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 rounded-lg text-white transition" %>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
      <% @tools.each do |tool| %>
        <div class="bg-gray-800 rounded-xl border border-gray-700 p-5 hover:border-gray-500 transition">
          <div class="flex items-start justify-between mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg
                <%= tool.enabled? ? 'bg-green-900/50 text-green-400' : 'bg-gray-700 text-gray-500' %>">
                <% icon = { "shell" => "⚡", "file_read" => "📄", "file_write" => "✏️", "web_search" => "🔍", "web_fetch" => "🌐", "http_request" => "📡" }[tool.executor_type] || "🔧" %>
                <%= icon %>
              </div>
              <div>
                <h3 class="text-white font-semibold"><%= tool.name %></h3>
                <span class="text-xs px-2 py-0.5 rounded-full
                  <%= tool.builtin? ? 'bg-blue-900/50 text-blue-300' : 'bg-purple-900/50 text-purple-300' %>">
                  <%= tool.builtin? ? "built-in" : "custom" %>
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <% if tool.requires_approval? %>
                <span class="text-xs px-2 py-0.5 rounded-full bg-yellow-900/50 text-yellow-300">🔒 approval</span>
              <% end %>
              <span class="w-2.5 h-2.5 rounded-full <%= tool.enabled? ? 'bg-green-400' : 'bg-gray-600' %>"></span>
            </div>
          </div>

          <p class="text-gray-400 text-sm mb-4 line-clamp-2"><%= tool.description %></p>

          <div class="flex items-center justify-between">
            <span class="text-gray-500 text-xs"><%= tool.executor_type %></span>
            <div class="flex gap-2">
              <%= link_to "View", tool_path(tool), class: "text-xs text-blue-400 hover:text-blue-300" %>
              <%= link_to "Edit", edit_tool_path(tool), class: "text-xs text-gray-400 hover:text-gray-300" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Recent Executions -->
    <div class="bg-gray-800 rounded-xl border border-gray-700">
      <div class="px-6 py-4 border-b border-gray-700">
        <h2 class="text-lg font-semibold text-white">📜 Recent Executions</h2>
      </div>
      <div class="divide-y divide-gray-700">
        <% if @recent_executions.empty? %>
          <div class="px-6 py-8 text-center text-gray-400">No tool executions yet</div>
        <% end %>
        <% @recent_executions.each do |exec| %>
          <div class="px-6 py-3 flex items-center gap-4">
            <span class="w-2 h-2 rounded-full flex-shrink-0
              <%= { 'completed' => 'bg-green-400', 'failed' => 'bg-red-400', 'running' => 'bg-yellow-400', 'pending' => 'bg-gray-400' }[exec.status] || 'bg-gray-400' %>"></span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-white text-sm font-medium"><%= exec.tool.name %></span>
                <span class="text-gray-500 text-xs">by <%= exec.agent.name %></span>
              </div>
              <p class="text-gray-400 text-xs truncate"><%= exec.input.to_json.truncate(100) %></p>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="text-xs <%= exec.status == 'completed' ? 'text-green-400' : exec.status == 'failed' ? 'text-red-400' : 'text-gray-400' %>"><%= exec.status %></div>
              <div class="text-gray-500 text-xs">
                <% if exec.duration_ms %><%= exec.duration_ms %>ms · <% end %>
                <%= time_ago_in_words(exec.created_at) %> ago
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
