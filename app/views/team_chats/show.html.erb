<div class="flex h-[calc(100vh-4rem)]"
     data-controller="team-chat"
     data-team-chat-session-id-value="<%= @session.id %>"
     data-team-chat-message-url-value="<%= message_team_chat_path(@session) %>"
     data-team-chat-update-url-value="<%= team_chat_path(@session) %>"
     data-team-chat-interrupt-url-value="<%= interrupt_team_chat_path(@session) %>"
     data-team-chat-csrf-value="<%= form_authenticity_token %>"
     data-team-chat-agents-value="<%= @agents.map { |a| { id: a.id, name: a.name, role: a.role, initial: a.name[0].upcase } }.to_json %>">
  <!-- Sidebar -->
  <div class="w-64 bg-surface-card border-r border-border-default flex flex-col flex-shrink-0">
    <div class="p-4 border-b border-border-default">
      <div class="flex items-center justify-between">
        <h2 class="text-white font-semibold text-sm"><%= @team.name %> Chats</h2>
        <%= button_to team_team_chats_path(@team), method: :post, class: "text-purple-400 hover:text-purple-300 transition cursor-pointer" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        <% end %>
      </div>
    </div>
    <div class="flex-1 overflow-y-auto">
      <% @past_sessions.each do |s| %>
        <%= link_to team_chat_path(s),
            class: "block px-4 py-3 hover:bg-surface-raised transition border-b border-border-default/50 #{s.id == @session.id ? 'bg-surface-raised' : ''}" do %>
          <div class="text-sm text-white truncate"><%= s.title %></div>
          <div class="text-xs text-text-faint mt-1">
            <%= time_ago_in_words(s.updated_at) %> ago
            · <%= s.team_chat_messages.count %> msgs
          </div>
        <% end %>
      <% end %>
    </div>
    <!-- Team Members -->
    <div class="p-4 border-t border-border-default">
      <div class="flex items-center justify-between mb-2">
        <div class="text-xs text-text-faint uppercase tracking-wider">Team Members</div>
        <%= link_to edit_team_path(@team), class: "text-text-faint hover:text-white transition", title: "Team Settings" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        <% end %>
      </div>
      <% colors = %w[bg-brand bg-green-600 bg-yellow-600 bg-pink-600 bg-cyan-600 bg-red-600 bg-indigo-600 bg-orange-600] %>
      <% @agents.each_with_index do |agent, i| %>
        <button type="button" class="flex items-center gap-2 py-1 w-full text-left hover:bg-surface-raised/50 rounded-lg px-1 transition cursor-pointer"
                data-action="click->team-chat#pinAgentFromSidebar"
                data-agent-name="<%= agent.name %>"
                title="Click to pin @<%= agent.name %> to chat">
          <div class="w-6 h-6 <%= colors[i % colors.size] %> rounded-full flex items-center justify-center text-white font-bold text-xs">
            <%= agent.name[0].upcase %>
          </div>
          <div>
            <div class="text-sm text-text-primary"><%= agent.name %></div>
            <div class="text-xs text-text-faint"><%= agent.role %></div>
          </div>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Main Chat Area -->
  <div class="flex-1 flex flex-col">

    <!-- Header -->
    <div class="flex items-center gap-4 px-6 py-3 border-b border-border-default bg-surface-card/50 flex-shrink-0">
      <%= link_to dashboard_path, class: "text-text-muted hover:text-white transition" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      <% end %>
      <div class="w-8 h-8 flex items-center justify-center">
        <%= hex_icon(size: "w-7 h-7", css: "text-purple-400") %>
      </div>
      <div>
        <div class="flex items-center gap-1 group">
          <h1 class="text-white font-semibold text-sm cursor-pointer"
              data-team-chat-target="titleText"
              data-action="click->team-chat#editTitle"
              title="Click to rename"><%= @session.title %></h1>
          <svg class="w-3 h-3 text-text-faint opacity-0 group-hover:opacity-100 transition cursor-pointer flex-shrink-0"
               fill="none" stroke="currentColor" viewBox="0 0 24 24"
               data-action="click->team-chat#editTitle">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 0l.172.172a2 2 0 010 2.828L12 15H9v-3z" />
          </svg>
          <input type="text"
                 data-team-chat-target="titleInput"
                 data-action="keydown->team-chat#handleTitleKeydown blur->team-chat#saveTitle"
                 class="hidden text-white font-semibold text-sm bg-transparent border-b border-purple-400 outline-none min-w-0 w-40"
                 maxlength="100">
        </div>
        <p class="text-text-faint text-xs"><%= @session.session_key %></p>
      </div>
      <div class="ml-auto flex items-center gap-3">
        <label class="flex items-center gap-1.5 cursor-pointer select-none" title="Show/hide tool calls">
          <input type="checkbox" data-team-chat-target="toolToggle" data-action="change->team-chat#toggleToolCalls"
                 class="w-3.5 h-3.5 rounded border-gray-500 text-yellow-600 focus:ring-yellow-500 bg-surface-overlay">
          <span class="text-xs text-text-muted">Show Tool Calls</span>
        </label>
        <% @agents.each_with_index do |agent, i| %>
          <div class="w-7 h-7 <%= colors[i % colors.size] %> rounded-full flex items-center justify-center text-white font-bold text-xs"
               title="<%= agent.name %> — <%= agent.role %>">
            <%= agent.name[0].upcase %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Messages -->
    <div class="flex-1 overflow-y-auto px-6 py-4 space-y-4" data-team-chat-target="messages" id="team-messages">
      <% if @messages.empty? %>
        <div class="flex items-center justify-center h-full" data-team-chat-target="emptyState">
          <div class="text-center">
            <%= hivemind_logo(size: "w-16 h-16 mx-auto mb-4", css: "text-purple-400/60") %>
            <h2 class="text-xl font-semibold text-white mb-2"><%= @team.name %> Team Chat</h2>
            <p class="text-text-muted max-w-md">
              Chat with the whole team or @mention a specific agent.<br>
              <span class="text-text-faint text-sm">
                Try: <% @agents.first(3).each do |a| %>
                  <code class="text-purple-400">@<%= a.name %></code><%= " " %>
                <% end %>
              </span>
            </p>
          </div>
        </div>
      <% end %>

      <% agent_colors = {} %>
      <% @agents.each_with_index { |a, i| agent_colors[a.id] = colors[i % colors.size].sub("bg-", "") } %>

      <% @messages.each do |msg| %>
        <% if msg.from_user? %>
          <div class="flex justify-end">
            <div class="max-w-2xl">
              <% if msg.target_agent_id %>
                <% target = @agents.find { |a| a.id == msg.target_agent_id } %>
                <div class="text-xs text-text-faint text-right mb-1">→ @<%= target&.name || "agent" %></div>
              <% end %>
              <div class="bg-brand rounded-2xl rounded-br-md px-4 py-3 text-white">
                <% if msg.images.attached? %>
                  <div class="flex flex-wrap gap-2 mb-2">
                    <% msg.images.each do |img| %>
                      <%= image_tag rails_blob_path(img, only_path: true),
                          class: "max-w-xs max-h-64 rounded-lg cursor-pointer hover:opacity-90 transition",
                          loading: "lazy" %>
                    <% end %>
                  </div>
                <% end %>
                <% if msg.documents.attached? %>
                  <div class="flex flex-wrap gap-1.5 mb-2">
                    <% msg.documents.each do |doc| %>
                      <span class="inline-flex items-center gap-1.5 bg-brand-dark/50 rounded-lg px-2.5 py-1 text-xs">
                        <span class="font-mono text-brand-light"><%= doc.filename.to_s.split(".").last&.upcase %></span>
                        <%= doc.filename %>
                        <span class="text-brand-light/60"><%= number_to_human_size(doc.byte_size) %></span>
                      </span>
                    <% end %>
                  </div>
                <% end %>
                <p class="whitespace-pre-wrap"><%= msg.content %></p>
              </div>
            </div>
          </div>
        <% elsif msg.from_agent? %>
          <% agent = @agents.find { |a| a.id == msg.sender_id } %>
          <% color_class = agent_colors[msg.sender_id] || "gray-600" %>
          <div class="flex justify-start">
            <div class="max-w-2xl">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-<%= color_class %> rounded-lg flex items-center justify-center text-white font-bold text-xs flex-shrink-0 mt-1"
                     title="<%= agent&.name %>">
                  <%= agent&.name&.first&.upcase || "?" %>
                </div>
                <div>
                  <div class="text-xs text-text-muted mb-1"><%= agent&.name || "Agent" %> <span class="text-gray-600">· <%= agent&.role %></span></div>
                  <div class="bg-surface-raised rounded-2xl rounded-bl-md px-4 py-3 text-gray-100">
                    <div class="whitespace-pre-wrap chat-content"><%= msg.content %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Thinking indicators -->
    <div class="px-6" data-team-chat-target="thinkingArea"></div>

    <!-- Image preview area -->
    <div class="px-6 hidden" data-team-chat-target="imagePreview">
      <div class="flex items-center gap-2 bg-surface-card border border-border-default rounded-lg px-3 py-2">
        <div class="flex gap-2 flex-wrap" data-team-chat-target="imageThumbs"></div>
        <button data-action="click->team-chat#clearImages" class="text-text-muted hover:text-red-400 ml-auto">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- File preview area -->
    <div class="px-6 hidden" data-team-chat-target="attachPreview">
      <div class="flex items-center gap-2 bg-surface-card border border-border-default rounded-lg px-3 py-2">
        <div class="flex gap-2 flex-wrap" data-team-chat-target="attachList"></div>
        <button data-action="click->team-chat#clearFiles" class="text-text-muted hover:text-red-400 ml-auto">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Input -->
    <div class="px-6 py-4 border-t border-border-default bg-surface-card/50 flex-shrink-0"
         data-action="dragover->team-chat#dragOver drop->team-chat#drop dragleave->team-chat#dragLeave">
      <div class="hidden mb-2 flex gap-2 flex-wrap" data-team-chat-target="mentionBar">
        <% @agents.each_with_index do |agent, i| %>
          <% btn_color = colors[i % colors.size].sub("bg-", "") %>
          <button type="button"
                  data-action="click->team-chat#insertMention"
                  data-agent-name="<%= agent.name %>"
                  class="px-2 py-1 text-xs rounded-full bg-<%= btn_color %>/20 text-<%= btn_color.sub("-600", "-400") %> hover:bg-<%= btn_color %>/40 transition cursor-pointer">
            @<%= agent.name %>
          </button>
        <% end %>
      </div>
      <div class="flex gap-3 items-end relative">
        <!-- File upload button -->
        <label class="px-3 py-3 text-text-muted hover:text-white cursor-pointer transition flex-shrink-0" title="Attach files">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
          </svg>
          <input type="file" accept="image/*,.txt,.md,.csv,.json,.xml,.html,.pdf,.doc,.docx,.xls,.xlsx,.yaml,.yml,.log,.py,.rb,.js,.ts,.sh,.sql,.env,.cfg,.ini,.toml" multiple class="hidden"
                 data-team-chat-target="fileInput"
                 data-action="change->team-chat#handleFiles">
        </label>

        <!-- Hashtag Actions button -->
        <div class="relative">
          <button type="button"
                  class="px-3 py-3 text-text-muted hover:text-purple-400 cursor-pointer transition flex-shrink-0 flex items-center gap-1"
                  title="Hashtag Actions"
                  data-action="click->team-chat#toggleHashtagDropdown">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
            </svg>
            <span class="text-xs font-medium">Actions</span>
          </button>
          
          <!-- Hashtag dropdown -->
          <div data-team-chat-target="hashtagDropdown"
               class="hidden absolute bottom-full left-0 mb-2 w-80 bg-surface-card border border-border-default rounded-lg shadow-xl max-h-64 overflow-y-auto z-50">
            <!-- Populated dynamically by controller -->
          </div>
        </div>

        <textarea data-team-chat-target="input"
                  data-action="keydown->team-chat#handleKeydown input->team-chat#handleInput paste->team-chat#handlePaste"
                  class="flex-1 px-4 py-3 bg-surface-raised border border-border-default rounded-xl text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none"
                  placeholder="Message the team... (use @name to target an agent)"
                  rows="1"
                  autofocus></textarea>
        <button data-team-chat-target="sendBtn" data-action="click->team-chat#send"
                class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-medium rounded-xl transition cursor-pointer flex-shrink-0 disabled:opacity-50 disabled:cursor-not-allowed">
          Send
        </button>
        <button data-team-chat-target="stopBtn" data-action="click->team-chat#stopAll"
                class="hidden px-3 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl transition cursor-pointer flex-shrink-0"
                title="Stop all agents">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <rect x="6" y="6" width="12" height="12" rx="1"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
