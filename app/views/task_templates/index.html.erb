<div class="max-w-4xl mx-auto px-6 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-bold text-white">Task Templates</h1>
      <p class="text-text-muted mt-1">Reusable task blueprints with pre-configured hooks and defaults.</p>
    </div>
    <%= link_to new_task_template_path, class: "flex items-center gap-2 px-4 py-2 bg-brand hover:bg-brand/80 text-white rounded-lg font-medium transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New Template
    <% end %>
  </div>

  <% if @templates.any? %>
    <div class="space-y-3">
      <% @templates.each do |template| %>
        <div class="bg-surface-card rounded-xl border border-border-default p-5 hover:border-brand/30 transition">
          <div class="flex items-start justify-between">
            <div>
              <%= link_to task_template_path(template), class: "text-lg font-semibold text-white hover:text-brand" do %>
                <%= template.name %>
              <% end %>
              <% if template.description.present? %>
                <p class="text-text-muted text-sm mt-1"><%= template.description.truncate(200) %></p>
              <% end %>
              <div class="flex items-center gap-3 mt-2">
                <span class="text-xs text-text-faint">Priority: <%= template.default_priority %></span>
                <span class="text-xs text-text-faint">Hooks: <%= template.task_hooks.size %></span>
                <span class="text-xs text-text-faint">Tasks: <%= template.tasks.count %></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to edit_task_template_path(template), class: "text-text-muted hover:text-white transition" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-surface-card rounded-xl border border-border-default p-12 text-center">
      <p class="text-text-muted mb-4">No task templates yet.</p>
      <%= link_to "Create your first template", new_task_template_path, class: "text-brand hover:underline" %>
    </div>
  <% end %>
</div>
