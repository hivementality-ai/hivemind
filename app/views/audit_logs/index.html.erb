<div class="max-w-7xl mx-auto px-6 py-8">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white">Audit Log</h1>
      <p class="text-text-muted mt-1">High-level agent activity across the platform</p>
    </div>
    <div class="text-text-muted text-sm">
      <%= number_with_delimiter(@total_count) %> <%= "event".pluralize(@total_count) %> total
    </div>
  </div>

  <!-- Filters -->
  <%= form_with url: audit_logs_path, method: :get, local: true, class: "mb-6 bg-surface-card rounded-xl border border-border-default p-4" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div>
        <label class="block text-text-muted text-xs mb-1 uppercase tracking-wider">Actor Type</label>
        <%= f.select :actor_type,
            [["All", ""]] + @actor_types.map { |t| [t.capitalize, t] },
            { selected: params[:actor_type] },
            class: "w-full bg-surface-base border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-brand" %>
      </div>

      <div>
        <label class="block text-text-muted text-xs mb-1 uppercase tracking-wider">Action</label>
        <%= f.select :action_filter,
            [["All", ""]] + @distinct_actions.map { |a| [a, a] },
            { selected: params[:action_filter] },
            class: "w-full bg-surface-base border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-brand" %>
      </div>

      <div>
        <label class="block text-text-muted text-xs mb-1 uppercase tracking-wider">From</label>
        <%= f.date_field :from, value: params[:from],
            class: "w-full bg-surface-base border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-brand" %>
      </div>

      <div>
        <label class="block text-text-muted text-xs mb-1 uppercase tracking-wider">To</label>
        <%= f.date_field :to, value: params[:to],
            class: "w-full bg-surface-base border border-border-default rounded-lg px-3 py-2 text-text-primary text-sm focus:outline-none focus:ring-1 focus:ring-brand" %>
      </div>
    </div>

    <div class="mt-4 flex gap-3">
      <%= f.submit "Apply Filters",
          class: "px-4 py-2 bg-brand text-white text-sm font-medium rounded-lg hover:bg-brand/90 transition cursor-pointer" %>
      <%= link_to "Clear", audit_logs_path,
          class: "px-4 py-2 bg-surface-raised text-text-primary text-sm font-medium rounded-lg hover:bg-surface-raised/80 transition" %>
    </div>
  <% end %>

  <!-- Log Table -->
  <div class="bg-surface-card rounded-xl border border-border-default overflow-hidden">
    <% if @logs.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-surface-base/50 text-text-muted text-xs uppercase tracking-wider">
            <tr>
              <th class="px-6 py-3 text-left">Timestamp</th>
              <th class="px-6 py-3 text-left">Actor</th>
              <th class="px-6 py-3 text-left">Action</th>
              <th class="px-6 py-3 text-left">Resource</th>
              <th class="px-6 py-3 text-left">Metadata</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border-default">
            <% @logs.each do |log| %>
              <tr class="hover:bg-surface-raised/50 transition">
                <td class="px-6 py-4 text-text-muted text-sm whitespace-nowrap">
                  <span title="<%= log.created_at.iso8601 %>">
                    <%= log.created_at.strftime("%b %d, %H:%M:%S") %>
                  </span>
                </td>

                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <span class="<%= actor_badge_class(log.actor_type) %> inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium">
                      <%= log.actor_type %>
                    </span>
                    <span class="text-text-muted text-sm font-mono"><%= log.actor_id %></span>
                  </div>
                </td>

                <td class="px-6 py-4">
                  <span class="font-mono text-sm text-white"><%= log.action %></span>
                </td>

                <td class="px-6 py-4 text-text-muted text-sm font-mono">
                  <%= log.resource.presence || "—" %>
                </td>

                <td class="px-6 py-4">
                  <% if log.metadata.present? %>
                    <details class="group">
                      <summary class="cursor-pointer text-xs text-brand-light hover:text-brand-light list-none">
                        <%= log.metadata.keys.count %> <%= "key".pluralize(log.metadata.keys.count) %> ▾
                      </summary>
                      <pre class="mt-2 text-xs text-text-muted bg-surface-base rounded p-2 overflow-auto max-w-xs max-h-32"><%= JSON.pretty_generate(log.metadata) %></pre>
                    </details>
                  <% else %>
                    <span class="text-text-faint text-sm">—</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if @total_pages > 1 %>
        <div class="px-6 py-4 border-t border-border-default flex items-center justify-between">
          <p class="text-text-muted text-sm">
            Page <%= @page %> of <%= @total_pages %>
          </p>
          <div class="flex gap-2">
            <% if @page > 1 %>
              <%= link_to "← Previous", audit_logs_path(request.query_parameters.merge(page: @page - 1)),
                  class: "px-3 py-1.5 bg-surface-raised text-text-primary text-sm rounded-lg hover:bg-surface-raised/80 transition" %>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to "Next →", audit_logs_path(request.query_parameters.merge(page: @page + 1)),
                  class: "px-3 py-1.5 bg-surface-raised text-text-primary text-sm rounded-lg hover:bg-surface-raised/80 transition" %>
            <% end %>
          </div>
        </div>
      <% end %>

    <% else %>
      <div class="px-6 py-16 text-center">
        <svg class="w-12 h-12 text-text-faint mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-text-muted">No audit events match your filters.</p>
        <%= link_to "Clear filters", audit_logs_path, class: "text-brand-light text-sm hover:underline mt-1 inline-block" %>
      </div>
    <% end %>
  </div>
</div>
