<div class="min-h-screen bg-surface-base flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <%= hivemind_logo(size: "w-14 h-14 mx-auto", css: "text-amber-400") %>
      <h1 class="text-3xl font-bold text-white mt-4">Create an account</h1>
      <p class="text-text-muted mt-2">Get started with Hivemind</p>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "space-y-5") do |f| %>

        <% if resource.errors.any? %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <% resource.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Email</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Password</label>
          <%= f.password_field :password, autocomplete: "new-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
          <p class="text-text-faint text-xs mt-1"><%= @minimum_password_length %> characters minimum</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Confirm password</label>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
        </div>

        <%= f.submit "Sign up", class: "w-full py-3 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-center text-text-muted text-sm mt-6">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "text-brand-light hover:text-brand-light" %>
    </p>
  </div>
</div>
