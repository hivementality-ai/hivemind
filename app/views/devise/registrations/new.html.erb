<div class="min-h-screen bg-gray-900 flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <span class="text-5xl">🐝</span>
      <h1 class="text-3xl font-bold text-white mt-4">Create an account</h1>
      <p class="text-gray-400 mt-2">Get started with Hivemind</p>
    </div>

    <div class="bg-gray-800 rounded-xl border border-gray-700 p-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "space-y-5") do |f| %>

        <% if resource.errors.any? %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <% resource.errors.full_messages.each do |msg| %>
              <p><%= msg %></p>
            <% end %>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Email</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Password</label>
          <%= f.password_field :password, autocomplete: "new-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          <p class="text-gray-500 text-xs mt-1"><%= @minimum_password_length %> characters minimum</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-300 mb-1">Confirm password</label>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
        </div>

        <%= f.submit "Sign up", class: "w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-center text-gray-400 text-sm mt-6">
      Already have an account?
      <%= link_to "Sign in", new_session_path(resource_name), class: "text-blue-400 hover:text-blue-300" %>
    </p>
  </div>
</div>
