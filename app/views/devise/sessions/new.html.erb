<div class="min-h-screen bg-surface-base flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    <div class="text-center mb-8">
      <%= hivemind_logo(size: "w-14 h-14 mx-auto", css: "text-amber-400") %>
      <h1 class="text-3xl font-bold text-white mt-4">Welcome back</h1>
      <p class="text-text-muted mt-2">Sign in to Hivemind</p>
    </div>

    <div class="bg-surface-card rounded-xl border border-border-default p-8">
      <%= form_for(resource, as: resource_name, url: user_session_path, class: "space-y-5") do |f| %>

        <% if flash[:alert] %>
          <div class="bg-red-900/50 border border-red-600 text-red-200 px-4 py-3 rounded-lg text-sm">
            <%= flash[:alert] %>
          </div>
        <% end %>

        <% if flash[:notice] %>
          <div class="bg-green-900/50 border border-green-600 text-green-200 px-4 py-3 rounded-lg text-sm">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Email</label>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              placeholder: "you@example.com",
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-text-primary mb-1">Password</label>
          <%= f.password_field :password, autocomplete: "current-password",
              placeholder: "••••••••",
              class: "w-full px-4 py-3 bg-surface-raised border border-border-default rounded-lg text-white placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent" %>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded border-gray-500 text-brand focus:ring-brand bg-surface-overlay" %>
            <span class="text-sm text-text-primary">Remember me</span>
          </label>

          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-brand-light hover:text-brand-light" %>
          <% end %>
        </div>

        <%= f.submit "Sign in", class: "w-full py-3 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-center text-text-faint text-sm mt-6">
      Hivemind — AI Team Platform
    </p>
  </div>
</div>
