<div class="min-h-screen bg-gray-900 text-white">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%= link_to "← Back to Budgets", budgets_path, class: "text-blue-400 hover:text-blue-300 mb-6 inline-block" %>
    
    <div class="bg-gray-800 rounded-lg p-8">
      <h1 class="text-2xl font-bold mb-6">
        Set <%= params[:period_type]&.titleize %> Budget for <%= @agent.name %>
      </h1>
      
      <%= form_with model: @budget, url: budget_path(agent_id: @agent.id, period_type: params[:period_type]), 
                    method: :patch, class: "space-y-6" do |f| %>
        <%= f.hidden_field :period, value: params[:period_type] %>
        
        <div>
          <%= f.label :limit_cents, "Budget Limit (USD)", class: "block text-sm font-medium mb-2" %>
          <div class="relative">
            <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">$</span>
            <%= f.number_field :limit_cents, 
                value: @budget.limit_cents ? (@budget.limit_cents / 100.0) : nil,
                step: 0.01,
                placeholder: "100.00",
                class: "w-full pl-8 pr-4 py-2 bg-gray-900 border border-gray-700 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
          </div>
          <p class="text-xs text-gray-500 mt-1">
            Set to 0 for unlimited spending
          </p>
        </div>
        
        <% if @budget.persisted? %>
          <div class="bg-gray-900 rounded-lg p-4 space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-400">Current Spent</span>
              <span class="font-semibold"><%= number_to_currency(@budget.spent_cents / 100.0) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-400">Usage</span>
              <span class="font-semibold"><%= @budget.percentage_used %>%</span>
            </div>
          </div>
        <% end %>
        
        <div class="flex gap-4">
          <%= f.submit "Save Budget", 
              class: "flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 rounded-lg font-semibold cursor-pointer" %>
          <%= link_to "Cancel", budgets_path, 
              class: "flex-1 px-6 py-3 bg-gray-700 hover:bg-gray-600 rounded-lg font-semibold text-center" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Convert dollar input to cents before submit
  document.querySelector('form').addEventListener('submit', (e) => {
    const input = document.querySelector('#agent_budget_limit_cents');
    if (input.value) {
      input.value = Math.round(parseFloat(input.value) * 100);
    }
  });
</script>
