#!/usr/bin/env bash
# ============================================================
# Hivemind 🐝 — CLI
# ============================================================
set -euo pipefail

# Resolve HIVEMIND_DIR: env var > script location > ~/hivemind
if [ -z "${HIVEMIND_DIR:-}" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$(dirname "$SCRIPT_DIR")/docker-compose.yml" ]; then
    HIVEMIND_DIR="$(dirname "$SCRIPT_DIR")"
  else
    HIVEMIND_DIR="$HOME/hivemind"
  fi
fi

# Colors (use $'...' so escapes are resolved at assignment, not just in echo -e)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
BOLD=$'\033[1m'
NC=$'\033[0m'

info()  { echo -e "${CYAN}▸${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
fail()  { echo -e "${RED}✗${NC} $*"; exit 1; }

# Resolve the agents-shared host directory for this instance from its .env,
# falling back to the legacy default. Exported so docker compose interpolates
# it even on installs whose .env predates the AGENTS_SHARED_DIR key.
resolve_agents_shared_dir() {
  local v=""
  v="$(grep -E '^AGENTS_SHARED_DIR=' "$HIVEMIND_DIR/.env" 2>/dev/null | head -1 | cut -d'=' -f2- || true)"
  [ -n "$v" ] && echo "$v" || echo "$HOME/hivemind-agents-shared"
}

require_dir() {
  [ -f "$HIVEMIND_DIR/docker-compose.yml" ] || fail "Hivemind not found at $HIVEMIND_DIR. Set HIVEMIND_DIR or run the installer."
  cd "$HIVEMIND_DIR"
  export AGENTS_SHARED_DIR="$(resolve_agents_shared_dir)"
}

# Secret generators — mirror install.sh
generate_secret() {
  openssl rand -hex 32 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 64
}

generate_short_secret() {
  openssl rand -hex 16 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 32
}

# Docker socket GID (Linux needs the real GID; macOS uses 0)
docker_socket_gid() {
  case "$(uname -s)" in
    Linux)  stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0 ;;
    Darwin) stat -f '%g' /var/run/docker.sock 2>/dev/null || echo 0 ;;
    *)      echo 0 ;;
  esac
}

# True if a TCP port is already bound on localhost
port_in_use() {
  local p="$1"
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1
  else
    (exec 3<>"/dev/tcp/127.0.0.1/$p") >/dev/null 2>&1 && { exec 3>&- 3<&-; return 0; } || return 1
  fi
}

# Echo the first free port at or above the given starting port
find_free_port() {
  local p="${1:-8081}"
  while port_in_use "$p"; do p=$((p + 1)); done
  echo "$p"
}

# Resolve the current version from git tag (used for HIVEMIND_VERSION)
current_version() {
  git describe --tags --exact-match 2>/dev/null | sed 's/^v//' || git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo 'dev'
}

# Backfill .env with keys added in later versions
migrate_env() {
  [ -f "$HIVEMIND_DIR/.env" ] || return 0

  # INTERNAL_API_SECRET — shared secret between Rails and SDK proxy
  local current_secret=""
  current_secret="$(grep '^INTERNAL_API_SECRET=' "$HIVEMIND_DIR/.env" 2>/dev/null | cut -d'=' -f2- || true)"
  if [ -z "$current_secret" ]; then
    local secret
    secret="$(openssl rand -hex 32 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 64)"
    if grep -q '^INTERNAL_API_SECRET=' "$HIVEMIND_DIR/.env" 2>/dev/null; then
      sed -i.bak "s|^INTERNAL_API_SECRET=.*|INTERNAL_API_SECRET=$secret|" "$HIVEMIND_DIR/.env" && rm -f "$HIVEMIND_DIR/.env.bak"
    else
      echo "" >> "$HIVEMIND_DIR/.env"
      echo "# Internal API (shared secret between Rails and SDK proxy)" >> "$HIVEMIND_DIR/.env"
      echo "INTERNAL_API_SECRET=$secret" >> "$HIVEMIND_DIR/.env"
    fi
    ok "Generated INTERNAL_API_SECRET"
  fi

  # AGENTS_SHARED_DIR — required by docker-compose.yml since multi-instance support.
  # Backfill the legacy default so raw `docker compose` calls keep working.
  if ! grep -q '^AGENTS_SHARED_DIR=' "$HIVEMIND_DIR/.env" 2>/dev/null; then
    {
      echo ""
      echo "# Host directory for shared agent files (per-instance)"
      echo "AGENTS_SHARED_DIR=$HOME/hivemind-agents-shared"
    } >> "$HIVEMIND_DIR/.env"
    ok "Backfilled AGENTS_SHARED_DIR"
  fi
}

# ----------------------------------------------------------
# Commands
# ----------------------------------------------------------

cmd_status() {
  require_dir
  echo -e "${BOLD}🐝 Hivemind Status${NC}"
  echo ""

  # Version
  local version
  version="$(current_version)"
  echo -e "  ${BOLD}Version:${NC}  $version"
  echo -e "  ${BOLD}Location:${NC} $HIVEMIND_DIR"
  echo ""

  # Containers
  docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || docker compose ps

  # Health check
  echo ""
  if curl -sf http://localhost:8080 &>/dev/null; then
    ok "Web UI reachable at http://localhost:8080"
  else
    warn "Web UI not responding at http://localhost:8080"
  fi
}

cmd_update() {
  require_dir
  echo -e "${BOLD}🐝 Updating Hivemind${NC}"
  echo ""

  local use_rc=false
  if [ "${1:-}" = "--rc" ]; then
    use_rc=true
  fi

  # Fetch tags
  info "Fetching latest release..."
  git fetch origin --tags --force --quiet 2>/dev/null || warn "git fetch failed — continuing with local tags"

  local latest_tag=""
  while IFS= read -r tag; do
    [ -z "$tag" ] && continue
    if [ "$use_rc" = true ]; then
      latest_tag="$tag"
      break
    else
      if [[ "$tag" != *-rc* ]]; then
        latest_tag="$tag"
        break
      fi
    fi
  done < <(git tag --sort=-version:refname 2>/dev/null)

  if [ -z "$latest_tag" ]; then
    warn "No release tags found — pulling main"
    git checkout main --quiet 2>/dev/null || true
    git pull origin main --quiet
  else
    local current
    current="$(git describe --tags --exact-match 2>/dev/null || echo 'none')"
    if [ "$current" = "$latest_tag" ]; then
      ok "Already on latest: $latest_tag"
    else
      info "Updating from $current → $latest_tag"
      git checkout "$latest_tag" --quiet
    fi
  fi

  # Re-install CLI so this script stays current
  local cli_dest="/usr/local/bin/hivemind"
  if [ -L "$cli_dest" ] || [ -f "$cli_dest" ]; then
    if [ -w "/usr/local/bin" ]; then
      ln -sf "$HIVEMIND_DIR/bin/hivemind" "$cli_dest"
    elif command -v sudo &>/dev/null; then
      sudo ln -sf "$HIVEMIND_DIR/bin/hivemind" "$cli_dest"
    fi
    ok "CLI updated"
  fi

  # Resolve version from current tag
  local version
  version="$(current_version)"

  # Backfill .env with any new keys added in later versions
  migrate_env

  # Pull prebuilt images first, fall back to building from source
  info "Pulling prebuilt images (version: $version)..."
  if HIVEMIND_VERSION="$version" docker compose pull app workspace connector 2>/dev/null; then
    ok "Prebuilt images pulled successfully"
  else
    warn "Prebuilt images not available, building from source..."
    HIVEMIND_VERSION="$version" docker compose build --build-arg HIVEMIND_VERSION="$version"
  fi

  # Migrate
  info "Running migrations..."
  HIVEMIND_VERSION="$version" docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate 2>/dev/null || warn "Migration skipped (app not running?)"

  # Restart with new images
  info "Restarting..."
  HIVEMIND_VERSION="$version" docker compose up -d --force-recreate

  echo ""
  ok "Hivemind updated to $version!"
}

cmd_restart() {
  require_dir
  local version
  version="$(current_version)"
  local services=("$@")
  if [ ${#services[@]} -eq 0 ]; then
    info "Restarting all containers..."
    HIVEMIND_VERSION="$version" docker compose restart
  else
    info "Restarting: ${services[*]}"
    HIVEMIND_VERSION="$version" docker compose restart "${services[@]}"
  fi
  ok "Done"
}

cmd_stop() {
  require_dir
  local version
  version="$(current_version)"
  info "Stopping Hivemind..."
  HIVEMIND_VERSION="$version" docker compose down
  ok "Stopped"
}

cmd_start() {
  require_dir
  local version
  version="$(current_version)"
  info "Starting Hivemind ($version)..."
  HIVEMIND_VERSION="$version" docker compose up -d
  ok "Started — http://localhost:8080"
}

cmd_logs() {
  require_dir
  local service="${1:-}"
  if [ -n "$service" ]; then
    docker compose logs -f "$service"
  else
    docker compose logs -f
  fi
}

cmd_migrate() {
  require_dir
  local version
  version="$(current_version)"
  info "Running database migrations..."
  HIVEMIND_VERSION="$version" docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate
  ok "Migrations complete"
}

cmd_console() {
  require_dir
  local version
  version="$(current_version)"
  info "Opening Rails console..."
  HIVEMIND_VERSION="$version" docker compose exec app bin/rails console
}

cmd_import() {
  require_dir

  local source="${1:-$HOME/.openclaw/workspace}"
  local agent_slug="${2:-}"
  local dry_run="${DRY_RUN:-false}"

  # Check for --dry-run flag
  for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
      dry_run="true"
      # Remove --dry-run from positional args
      if [ "$source" = "--dry-run" ]; then
        source="$HOME/.openclaw/workspace"
      fi
    fi
  done

  if [ ! -d "$source" ]; then
    echo -e "${BOLD}Usage:${NC} hivemind import [openclaw-workspace-path] [agent-slug] [--dry-run]"
    echo ""
    echo "  Imports an OpenClaw workspace into Hivemind — creates the agent,"
    echo "  imports memories, skills, channels, conversations, and tools."
    echo ""
    echo "  Default path: ~/.openclaw/workspace"
    echo ""
    echo "  Options:"
    echo "    --dry-run    Preview the migration without persisting changes"
    echo ""
    echo "  Examples:"
    echo "    hivemind import                                    # uses default path"
    echo "    hivemind import ~/my-openclaw-workspace"
    echo "    hivemind import ~/.openclaw/workspace aria         # import as existing agent"
    echo "    hivemind import ~/.openclaw/workspace --dry-run    # preview only"
    exit 1
  fi

  # Check for IDENTITY.md to show what we're importing
  if [ -f "$source/IDENTITY.md" ]; then
    local agent_name
    agent_name="$(grep -oP '\*\*Name:\*\*\s*\K.+' "$source/IDENTITY.md" 2>/dev/null || echo "Unknown")"
    info "Found OpenClaw agent: ${BOLD}$agent_name${NC}"
  fi

  if [ "$dry_run" = "true" ]; then
    warn "Dry run mode — no changes will be persisted"
  fi

  info "Importing from $source..."
  echo ""

  # Prepare container staging directory
  docker compose exec app bash -c "
    rm -rf /tmp/openclaw-import && mkdir -p /tmp/openclaw-import
  " 2>/dev/null

  # Copy full workspace into container
  for f in SOUL.md MEMORY.md USER.md TOOLS.md AGENTS.md IDENTITY.md HEARTBEAT.md config.json; do
    [ -f "$source/$f" ] && docker compose cp "$source/$f" app:/tmp/openclaw-import/ 2>/dev/null
  done
  for d in memory skills conversations; do
    [ -d "$source/$d" ] && docker compose cp "$source/$d" app:/tmp/openclaw-import/ 2>/dev/null
  done

  # Build env args
  local env_args="-e DRY_RUN=$dry_run"
  if [ -n "$agent_slug" ]; then
    env_args="$env_args -e AGENT_SLUG=$agent_slug"
  fi

  # Run the migration task
  docker compose exec $env_args app \
    bin/rails "openclaw:migrate[/tmp/openclaw-import${agent_slug:+,$agent_slug}]"

  # Clean up (use root to avoid permission issues)
  docker compose exec -u root app rm -rf /tmp/openclaw-import 2>/dev/null

  echo ""
  if [ "$dry_run" = "true" ]; then
    ok "Dry run complete — no changes persisted."
  else
    ok "Migration complete!"
  fi
  echo -e "  Memory embeddings will generate in the background."
}

# Create a second, fully isolated Hivemind instance on this machine.
# Clones the current install into ~/hivemind-<name> with its own .env
# (fresh secrets, free host ports, dedicated project name + shared dir).
cmd_new() {
  require_dir  # validates the source install at HIVEMIND_DIR

  local name="${1:-}"
  if [ -z "$name" ]; then
    echo -e "${BOLD}Usage:${NC} hivemind new <name>"
    echo ""
    echo "  Creates a second isolated Hivemind instance at ~/hivemind-<name>."
    echo "  It gets its own database, Redis, volumes, secrets, host ports, and"
    echo "  shared agent directory — nothing is shared with the original."
    echo ""
    echo "  Manage it afterwards by pointing the CLI at its directory:"
    echo "    HIVEMIND_DIR=~/hivemind-<name> hivemind status"
    echo "    HIVEMIND_DIR=~/hivemind-<name> hivemind logs app"
    exit 1
  fi

  # Validate name: lowercase letters, digits, dashes (must start alphanumeric)
  if ! [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    fail "Instance name must be lowercase letters, digits or dashes (e.g. 'staging', 'bee2')."
  fi

  local src="$HIVEMIND_DIR"
  local target="$HOME/hivemind-$name"
  local project="hivemind-$name"
  local shared_dir="$HOME/hivemind-$name-agents-shared"

  [ -e "$target" ] && fail "$target already exists — pick another name or remove it first."

  echo -e "${BOLD}🐝 Creating Hivemind instance: ${name}${NC}"
  echo ""

  # Pick free host ports (8080/3002 are the primary's defaults)
  local app_port connector_port
  app_port="$(find_free_port 8081)"
  connector_port="$(find_free_port 3012)"
  info "Allocated ports — web: $app_port, connector: $connector_port"

  # Clone the source repo (fast local clone), then repoint origin at upstream
  # so `hivemind update` fetches releases from GitHub rather than the local copy.
  info "Cloning into $target ..."
  git clone --quiet "$src" "$target" || fail "git clone failed"

  local origin_url
  origin_url="$(git -C "$src" remote get-url origin 2>/dev/null || echo 'https://github.com/hivementality-ai/hivemind.git')"
  git -C "$target" remote set-url origin "$origin_url" 2>/dev/null || true

  # Match the source's checked-out version (tag if on one, else current branch)
  local src_ref
  src_ref="$(git -C "$src" describe --tags --exact-match 2>/dev/null || git -C "$src" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"
  git -C "$target" checkout --quiet "$src_ref" 2>/dev/null || true

  # Generate fresh secrets — never reuse the primary's keys
  info "Generating fresh secrets and .env ..."
  local ar_primary ar_deterministic ar_salt master_key internal_secret docker_gid
  ar_primary="$(generate_secret)"
  ar_deterministic="$(generate_secret)"
  ar_salt="$(generate_secret)"
  master_key="$(generate_short_secret)"
  internal_secret="$(generate_secret)"
  docker_gid="$(docker_socket_gid)"

  cat > "$target/.env" <<EOF
# ============================================================
# Hivemind 🐝 — instance '$name' (created by hivemind new)
# ============================================================
# Manage API keys, channels, and integrations in Mission Control → Integrations.

# Multi-instance isolation
COMPOSE_PROJECT_NAME=$project
APP_PORT=$app_port
CONNECTOR_PORT=$connector_port
AGENTS_SHARED_DIR=$shared_dir

# Active Record Encryption (required for Vault)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ar_primary
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ar_deterministic
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ar_salt

# Rails
RAILS_MASTER_KEY=$master_key
SECRET_KEY_BASE=$master_key

# Docker
DOCKER_GID=$docker_gid

# Internal API (shared secret between Rails and SDK proxy)
INTERNAL_API_SECRET=$internal_secret
EOF

  # Rails also reads the master key from config/master.key (gitignored, not cloned)
  echo -n "$master_key" > "$target/config/master.key"
  chmod 600 "$target/config/master.key"

  # Dedicated shared agent directory
  mkdir -p "$shared_dir"
  ok "Created shared workspace: $shared_dir"

  # Boot the new instance from its own directory
  info "Starting instance '$name' ..."
  local version
  version="$(cd "$target" && current_version)"
  # Pin AGENTS_SHARED_DIR to this instance's dir — require_dir exported the
  # source's value, and shell env overrides .env in compose.
  ( cd "$target" && HIVEMIND_VERSION="$version" AGENTS_SHARED_DIR="$shared_dir" docker compose up -d ) \
    || fail "docker compose up failed"

  echo ""
  ok "Instance '$name' is up!"
  echo ""
  echo -e "  ${BOLD}Web UI:${NC}    http://localhost:$app_port"
  echo -e "  ${BOLD}Location:${NC}  $target"
  echo -e "  ${BOLD}Project:${NC}   $project"
  echo ""
  echo -e "  ${BOLD}Manage it with:${NC}"
  echo -e "    HIVEMIND_DIR=$target hivemind status"
  echo -e "    HIVEMIND_DIR=$target hivemind logs app"
  echo -e "    HIVEMIND_DIR=$target hivemind stop"
}

cmd_version() {
  require_dir
  local version
  version="$(current_version)"
  echo "hivemind $version"
}

# ----------------------------------------------------------
# Usage
# ----------------------------------------------------------
usage() {
  cat <<EOF
${BOLD}🐝 Hivemind CLI${NC}

${BOLD}Usage:${NC} hivemind <command> [options]

${BOLD}Commands:${NC}
  status          Show container status and version
  start           Start all containers
  stop            Stop all containers
  restart [svc]   Restart containers (optionally specific service)
  update [--rc]   Pull latest release, rebuild, migrate, restart
  logs [svc]      Tail logs (optionally specific service)
  migrate         Run database migrations
  console         Open Rails console
  import <path>   Import OpenClaw workspace files
  new <name>      Create a second isolated instance (~/hivemind-<name>)
  version         Show version

${BOLD}Examples:${NC}
  hivemind status
  hivemind update
  hivemind update --rc
  hivemind restart rails sidekiq
  hivemind logs rails
  hivemind import ~/.openclaw/workspace
  hivemind new staging
  HIVEMIND_DIR=~/hivemind-staging hivemind status

${BOLD}Environment:${NC}
  HIVEMIND_DIR    Override install location (default: ~/hivemind)

EOF
}

# ----------------------------------------------------------
# Router
# ----------------------------------------------------------
case "${1:-}" in
  status)   cmd_status ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  shift; cmd_restart "$@" ;;
  update)   shift; cmd_update "$@" ;;
  logs)     shift; cmd_logs "$@" ;;
  migrate)  cmd_migrate ;;
  console)  cmd_console ;;
  import)   shift; cmd_import "$@" ;;
  new)      shift; cmd_new "$@" ;;
  version)  cmd_version ;;
  -h|--help|"") usage ;;
  *)        echo -e "${RED}Unknown command: $1${NC}"; echo ""; usage; exit 1 ;;
esac
