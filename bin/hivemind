#!/usr/bin/env bash
# ============================================================
# Hivemind 🐝 — CLI
# ============================================================
set -euo pipefail

# Resolve HIVEMIND_DIR: env var > script location > ~/hivemind
if [ -z "${HIVEMIND_DIR:-}" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$(dirname "$SCRIPT_DIR")/docker-compose.yml" ]; then
    HIVEMIND_DIR="$(dirname "$SCRIPT_DIR")"
  else
    HIVEMIND_DIR="$HOME/hivemind"
  fi
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}▸${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
fail()  { echo -e "${RED}✗${NC} $*"; exit 1; }

require_dir() {
  [ -f "$HIVEMIND_DIR/docker-compose.yml" ] || fail "Hivemind not found at $HIVEMIND_DIR. Set HIVEMIND_DIR or run the installer."
  cd "$HIVEMIND_DIR"
}

# ----------------------------------------------------------
# Commands
# ----------------------------------------------------------

cmd_status() {
  require_dir
  echo -e "${BOLD}🐝 Hivemind Status${NC}"
  echo ""

  # Version
  local version
  version="$(git describe --tags --exact-match 2>/dev/null || git describe --tags --abbrev=0 2>/dev/null || echo 'dev')"
  echo -e "  ${BOLD}Version:${NC}  $version"
  echo -e "  ${BOLD}Location:${NC} $HIVEMIND_DIR"
  echo ""

  # Containers
  docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || docker compose ps

  # Health check
  echo ""
  if curl -sf http://localhost:8080 &>/dev/null; then
    ok "Web UI reachable at http://localhost:8080"
  else
    warn "Web UI not responding at http://localhost:8080"
  fi
}

cmd_update() {
  require_dir
  echo -e "${BOLD}🐝 Updating Hivemind${NC}"
  echo ""

  local use_rc=false
  if [ "${1:-}" = "--rc" ]; then
    use_rc=true
  fi

  # Fetch tags
  info "Fetching latest release..."
  git fetch origin --tags --quiet

  local latest_tag
  if [ "$use_rc" = true ]; then
    # Include release candidates
    latest_tag="$(git tag --sort=-version:refname | head -n 1)"
  else
    # Stable releases only (exclude -rc tags)
    latest_tag="$(git tag --sort=-version:refname | grep -v '\-rc' | head -n 1)"
  fi

  if [ -z "$latest_tag" ]; then
    warn "No release tags found — pulling main"
    git checkout main --quiet 2>/dev/null || true
    git pull origin main --quiet
  else
    local current
    current="$(git describe --tags --exact-match 2>/dev/null || echo 'none')"
    if [ "$current" = "$latest_tag" ]; then
      ok "Already on latest: $latest_tag"
    else
      info "Updating from $current → $latest_tag"
      git checkout "$latest_tag" --quiet
    fi
  fi

  # Build
  local version
  version="$(git describe --tags --exact-match 2>/dev/null | sed 's/^v//' || echo 'dev')"
  info "Building containers..."
  HIVEMIND_VERSION="$version" docker compose build --build-arg HIVEMIND_VERSION="$version"

  # Migrate
  info "Running migrations..."
  docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate 2>/dev/null || warn "Migration skipped (app not running?)"

  # Restart
  info "Restarting..."
  docker compose up -d

  echo ""
  ok "Hivemind updated to $version!"
}

cmd_restart() {
  require_dir
  local services=("$@")
  if [ ${#services[@]} -eq 0 ]; then
    info "Restarting all containers..."
    docker compose restart
  else
    info "Restarting: ${services[*]}"
    docker compose restart "${services[@]}"
  fi
  ok "Done"
}

cmd_stop() {
  require_dir
  info "Stopping Hivemind..."
  docker compose down
  ok "Stopped"
}

cmd_start() {
  require_dir
  info "Starting Hivemind..."
  docker compose up -d
  ok "Started — http://localhost:8080"
}

cmd_logs() {
  require_dir
  local service="${1:-}"
  if [ -n "$service" ]; then
    docker compose logs -f "$service"
  else
    docker compose logs -f
  fi
}

cmd_migrate() {
  require_dir
  info "Running database migrations..."
  docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate
  ok "Migrations complete"
}

cmd_console() {
  require_dir
  info "Opening Rails console..."
  docker compose exec app bin/rails console
}

cmd_import() {
  require_dir

  local source="${1:-$HOME/.openclaw/workspace}"
  local agent_slug="${2:-}"

  if [ ! -d "$source" ]; then
    echo -e "${BOLD}Usage:${NC} hivemind import [openclaw-workspace-path] [agent-slug]"
    echo ""
    echo "  Imports an OpenClaw workspace into Hivemind — creates the agent,"
    echo "  copies workspace files, and imports memories into the database."
    echo ""
    echo "  Default path: ~/.openclaw/workspace"
    echo ""
    echo "  Examples:"
    echo "    hivemind import                          # uses default path"
    echo "    hivemind import ~/my-openclaw-workspace"
    echo "    hivemind import ~/.openclaw/workspace aria  # import as existing agent"
    exit 1
  fi

  # Check for IDENTITY.md to show what we're importing
  if [ -f "$source/IDENTITY.md" ]; then
    local agent_name
    agent_name="$(grep -oP '\*\*Name:\*\*\s*\K.+' "$source/IDENTITY.md" 2>/dev/null || echo "Unknown")"
    info "Found OpenClaw agent: ${BOLD}$agent_name${NC}"
  fi

  info "Importing from $source..."
  echo ""

  # Run the Rails importer (handles agent creation, file copy, memory import)
  local slug_arg=""
  if [ -n "$agent_slug" ]; then
    slug_arg="AGENT_SLUG=$agent_slug"
  fi

  docker compose exec -e OPENCLAW_WORKSPACE="/tmp/openclaw-import" $slug_arg app bash -c "
    rm -rf /tmp/openclaw-import && mkdir -p /tmp/openclaw-import
  " 2>/dev/null

  # Copy workspace into the app container
  docker compose cp "$source/." app:/tmp/openclaw-import/ 2>/dev/null

  # Run the import task
  docker compose exec -e OPENCLAW_WORKSPACE="/tmp/openclaw-import" ${slug_arg:+-e $slug_arg} app \
    rails "memory:import_openclaw[/tmp/openclaw-import${agent_slug:+,$agent_slug}]"

  # Clean up
  docker compose exec app rm -rf /tmp/openclaw-import 2>/dev/null

  echo ""
  ok "Import complete!"
  echo -e "  Workspace files available at ${BOLD}/app/agents-shared/${NC}"
  echo -e "  Memory embeddings will generate in the background."
}

cmd_version() {
  require_dir
  local version
  version="$(git describe --tags --exact-match 2>/dev/null || git describe --tags --abbrev=0 2>/dev/null || echo 'dev')"
  echo "hivemind $version"
}

# ----------------------------------------------------------
# Usage
# ----------------------------------------------------------
usage() {
  cat <<EOF
${BOLD}🐝 Hivemind CLI${NC}

${BOLD}Usage:${NC} hivemind <command> [options]

${BOLD}Commands:${NC}
  status          Show container status and version
  start           Start all containers
  stop            Stop all containers
  restart [svc]   Restart containers (optionally specific service)
  update          Pull latest release, rebuild, migrate, restart
  logs [svc]      Tail logs (optionally specific service)
  migrate         Run database migrations
  console         Open Rails console
  import <path>   Import OpenClaw workspace files
  version         Show version

${BOLD}Examples:${NC}
  hivemind status
  hivemind update
  hivemind restart rails sidekiq
  hivemind logs rails
  hivemind import ~/.openclaw/workspace

${BOLD}Environment:${NC}
  HIVEMIND_DIR    Override install location (default: ~/hivemind)

EOF
}

# ----------------------------------------------------------
# Router
# ----------------------------------------------------------
case "${1:-}" in
  status)   cmd_status ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  shift; cmd_restart "$@" ;;
  update)   cmd_update ;;
  logs)     shift; cmd_logs "$@" ;;
  migrate)  cmd_migrate ;;
  console)  cmd_console ;;
  import)   shift; cmd_import "$@" ;;
  version)  cmd_version ;;
  -h|--help|"") usage ;;
  *)        echo -e "${RED}Unknown command: $1${NC}"; echo ""; usage; exit 1 ;;
esac
