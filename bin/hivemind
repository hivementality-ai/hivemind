#!/usr/bin/env bash
# ============================================================
# Hivemind 🐝 — CLI
# ============================================================
set -euo pipefail

# Resolve HIVEMIND_DIR: env var > script location > ~/hivemind
if [ -z "${HIVEMIND_DIR:-}" ]; then
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [ -f "$(dirname "$SCRIPT_DIR")/docker-compose.yml" ]; then
    HIVEMIND_DIR="$(dirname "$SCRIPT_DIR")"
  else
    HIVEMIND_DIR="$HOME/hivemind"
  fi
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}▸${NC} $*"; }
ok()    { echo -e "${GREEN}✓${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
fail()  { echo -e "${RED}✗${NC} $*"; exit 1; }

require_dir() {
  [ -f "$HIVEMIND_DIR/docker-compose.yml" ] || fail "Hivemind not found at $HIVEMIND_DIR. Set HIVEMIND_DIR or run the installer."
  cd "$HIVEMIND_DIR"
}

# ----------------------------------------------------------
# Commands
# ----------------------------------------------------------

cmd_status() {
  require_dir
  echo -e "${BOLD}🐝 Hivemind Status${NC}"
  echo ""

  # Version
  local version
  version="$(git describe --tags --exact-match 2>/dev/null || git describe --tags --abbrev=0 2>/dev/null || echo 'dev')"
  echo -e "  ${BOLD}Version:${NC}  $version"
  echo -e "  ${BOLD}Location:${NC} $HIVEMIND_DIR"
  echo ""

  # Containers
  docker compose ps --format "table {{.Name}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null || docker compose ps

  # Health check
  echo ""
  if curl -sf http://localhost:8080 &>/dev/null; then
    ok "Web UI reachable at http://localhost:8080"
  else
    warn "Web UI not responding at http://localhost:8080"
  fi
}

cmd_update() {
  require_dir
  echo -e "${BOLD}🐝 Updating Hivemind${NC}"
  echo ""

  # Fetch tags
  info "Fetching latest release..."
  git fetch origin --tags --quiet

  local latest_tag
  latest_tag="$(git tag --sort=-version:refname | head -n 1)"

  if [ -z "$latest_tag" ]; then
    warn "No release tags found — pulling main"
    git checkout main --quiet 2>/dev/null || true
    git pull origin main --quiet
  else
    local current
    current="$(git describe --tags --exact-match 2>/dev/null || echo 'none')"
    if [ "$current" = "$latest_tag" ]; then
      ok "Already on latest: $latest_tag"
    else
      info "Updating from $current → $latest_tag"
      git checkout "$latest_tag" --quiet
    fi
  fi

  # Build
  local version
  version="$(git describe --tags --exact-match 2>/dev/null | sed 's/^v//' || echo 'dev')"
  info "Building containers..."
  HIVEMIND_VERSION="$version" docker compose build --build-arg HIVEMIND_VERSION="$version"

  # Migrate
  info "Running migrations..."
  docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate 2>/dev/null || warn "Migration skipped (app not running?)"

  # Restart
  info "Restarting..."
  docker compose up -d

  echo ""
  ok "Hivemind updated to $version!"
}

cmd_restart() {
  require_dir
  local services=("$@")
  if [ ${#services[@]} -eq 0 ]; then
    info "Restarting all containers..."
    docker compose restart
  else
    info "Restarting: ${services[*]}"
    docker compose restart "${services[@]}"
  fi
  ok "Done"
}

cmd_stop() {
  require_dir
  info "Stopping Hivemind..."
  docker compose down
  ok "Stopped"
}

cmd_start() {
  require_dir
  info "Starting Hivemind..."
  docker compose up -d
  ok "Started — http://localhost:8080"
}

cmd_logs() {
  require_dir
  local service="${1:-}"
  if [ -n "$service" ]; then
    docker compose logs -f "$service"
  else
    docker compose logs -f
  fi
}

cmd_migrate() {
  require_dir
  info "Running database migrations..."
  docker compose run --rm -e RAILS_ENV=production app bin/rails db:migrate
  ok "Migrations complete"
}

cmd_console() {
  require_dir
  info "Opening Rails console..."
  docker compose exec app bin/rails console
}

cmd_import() {
  local source="${1:-}"
  if [ -z "$source" ]; then
    echo "Usage: hivemind import <openclaw-workspace-path>"
    echo ""
    echo "Imports OpenClaw workspace files into Hivemind's shared workspace."
    echo "Copies: SOUL.md, MEMORY.md, USER.md, TOOLS.md, skills/, memory/"
    exit 1
  fi

  [ -d "$source" ] || fail "Directory not found: $source"

  local dest="$HOME/hivemind-agents-shared"
  mkdir -p "$dest"

  info "Importing OpenClaw workspace from $source..."

  # Copy known workspace files
  local files=("SOUL.md" "MEMORY.md" "USER.md" "TOOLS.md" "AGENTS.md" "IDENTITY.md" "HEARTBEAT.md")
  for f in "${files[@]}"; do
    if [ -f "$source/$f" ]; then
      cp "$source/$f" "$dest/$f"
      ok "Copied $f"
    fi
  done

  # Copy directories
  local dirs=("skills" "memory")
  for d in "${dirs[@]}"; do
    if [ -d "$source/$d" ]; then
      cp -r "$source/$d" "$dest/$d"
      ok "Copied $d/"
    fi
  done

  echo ""
  ok "Import complete → $dest"
  echo -e "  Files are available to agents at ${BOLD}/app/agents-shared/${NC}"
}

cmd_version() {
  require_dir
  local version
  version="$(git describe --tags --exact-match 2>/dev/null || git describe --tags --abbrev=0 2>/dev/null || echo 'dev')"
  echo "hivemind $version"
}

# ----------------------------------------------------------
# Usage
# ----------------------------------------------------------
usage() {
  cat <<EOF
${BOLD}🐝 Hivemind CLI${NC}

${BOLD}Usage:${NC} hivemind <command> [options]

${BOLD}Commands:${NC}
  status          Show container status and version
  start           Start all containers
  stop            Stop all containers
  restart [svc]   Restart containers (optionally specific service)
  update          Pull latest release, rebuild, migrate, restart
  logs [svc]      Tail logs (optionally specific service)
  migrate         Run database migrations
  console         Open Rails console
  import <path>   Import OpenClaw workspace files
  version         Show version

${BOLD}Examples:${NC}
  hivemind status
  hivemind update
  hivemind restart rails sidekiq
  hivemind logs rails
  hivemind import ~/.openclaw/workspace

${BOLD}Environment:${NC}
  HIVEMIND_DIR    Override install location (default: ~/hivemind)

EOF
}

# ----------------------------------------------------------
# Router
# ----------------------------------------------------------
case "${1:-}" in
  status)   cmd_status ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  shift; cmd_restart "$@" ;;
  update)   cmd_update ;;
  logs)     shift; cmd_logs "$@" ;;
  migrate)  cmd_migrate ;;
  console)  cmd_console ;;
  import)   shift; cmd_import "$@" ;;
  version)  cmd_version ;;
  -h|--help|"") usage ;;
  *)        echo -e "${RED}Unknown command: $1${NC}"; echo ""; usage; exit 1 ;;
esac
