#!/usr/bin/env bash
set -e

# Start Hivemind in development mode
# Source code is volume-mounted — edit files and changes take effect immediately.
# Rails auto-reloads on each request. Sidekiq needs a restart for worker changes.
#
# Usage:
#   bin/dev-up          # start all services
#   bin/dev-up --build  # rebuild dev image (after Gemfile changes)
#   bin/dev-up app      # start only specific services

COMPOSE_FILES="-f docker-compose.yml -f docker-compose.dev.yml"

echo "🐝 Starting Hivemind (dev mode)..."

# ----------------------------------------------------------
# Generate .env if it doesn't exist
# ----------------------------------------------------------
if [ ! -f .env ]; then
  echo "🔑 No .env found — generating one with fresh secrets..."

  generate_secret() {
    openssl rand -hex 32 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 64
  }

  generate_short_secret() {
    openssl rand -hex 16 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 32
  }

  AR_PRIMARY="$(generate_secret)"
  AR_DETERMINISTIC="$(generate_secret)"
  AR_SALT="$(generate_secret)"
  MASTER_KEY="$(generate_short_secret)"
  INTERNAL_SECRET="$(generate_secret)"

  # Detect Docker socket GID
  case "$(uname -s)" in
    Linux*)  DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)" ;;
    Darwin*) DOCKER_GID="$(stat -f '%g' /var/run/docker.sock 2>/dev/null || echo 0)" ;;
    *)       DOCKER_GID=0 ;;
  esac

  cat > .env <<EOF
# ============================================================
# Hivemind 🐝 — Generated by bin/dev-up on $(date -u +"%Y-%m-%d %H:%M UTC")
# ============================================================

# Active Record Encryption (required for Vault)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$AR_PRIMARY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$AR_DETERMINISTIC
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$AR_SALT

# Rails
RAILS_MASTER_KEY=$MASTER_KEY
SECRET_KEY_BASE=$MASTER_KEY

# Docker
DOCKER_GID=$DOCKER_GID

# Internal API (shared secret between Rails and SDK proxy)
INTERNAL_API_SECRET=$INTERNAL_SECRET
EOF

  # Write master key file for Rails
  mkdir -p config
  echo -n "$MASTER_KEY" > config/master.key
  chmod 600 config/master.key

  echo "✅ Generated .env and config/master.key"
fi

# Ensure INTERNAL_API_SECRET exists (added in v1.x — backfill for older .env files)
if ! grep -q '^INTERNAL_API_SECRET=' .env 2>/dev/null; then
  generate_secret_fn() {
    openssl rand -hex 32 2>/dev/null || LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom | head -c 64
  }
  echo "" >> .env
  echo "# Internal API (shared secret between Rails and SDK proxy)" >> .env
  echo "INTERNAL_API_SECRET=$(generate_secret_fn)" >> .env
  echo "🔑 Added INTERNAL_API_SECRET to .env"
fi

# ----------------------------------------------------------
# Create shared workspace directory if needed
# ----------------------------------------------------------
SHARED_DIR="$HOME/hivemind-agents-shared"
if [ ! -d "$SHARED_DIR" ]; then
  mkdir -p "$SHARED_DIR"
  echo "📁 Created shared workspace: $SHARED_DIR"
fi

# ----------------------------------------------------------
# Build and start
# ----------------------------------------------------------

# First run: build dev image if it doesn't exist
if ! docker image inspect hivemind-dev &>/dev/null; then
  echo "📦 Building dev image (first time only)..."
  docker compose $COMPOSE_FILES build app
fi

# Database is prepared automatically by the dev entrypoint (db:prepare + db:seed)
docker compose $COMPOSE_FILES up "$@"
